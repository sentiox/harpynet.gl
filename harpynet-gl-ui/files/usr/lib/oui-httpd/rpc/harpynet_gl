function M.status()
    return M.summary()
end

function M.version()
    local _, version = run({ "/usr/bin/harpynet", "show_version" })
    return { version = first_line(version) }
end

function M.mihomo_config()
    local paths = {
        "/tmp/mihomo/config.yaml",
        "/etc/sentinel/mihomo-config.cache",
        "/etc/sentinel/mihomo-subscription.cache",
        "/etc/mihomo/config.yaml",
        "/etc/harpynet/mihomo.yaml",
        "/tmp/harpynet/mihomo.yaml"
    }

    for _, path in ipairs(paths) do
        local data = read_file(path)
        if data and data ~= "" then
            return {
                ok = true,
                success = true,
                path = path,
                size = #data,
                config = data
            }
        end
    end

    return {
        ok = false,
        success = false,
        error = "mihomo config not found"
    }
end

function M.logs(params)
    if params and params.kind == "dashboard" then
        local _, metadata = run({ "/usr/bin/harpynet", "get_subscription_metadata", "main" })
        local _, outbounds = run({ "/usr/bin/harpynet", "get_device_outbound_options", "main" })
        local _, proxies = run({ "/usr/bin/harpynet", "clash_api", "get_proxies" })
        metadata = trim(metadata or "")

        return {
            logs = '{"selected_outbound":' .. json_string(uci_get("harpynet", "main", "selected_outbound")) ..
                ',"metadata":' .. json_string(metadata ~= "" and metadata or "{}") ..
                ',"outbounds":' .. json_string(first_line(outbounds) ~= "" and outbounds or '{"success":true,"outbounds":[]}') ..
                ',"proxies":' .. json_string(first_line(proxies) ~= "" and proxies or "{}") .. '}'
        }
    end

    local _, output = run({ "sh", "-c", "logread 2>/dev/null | grep -i 'harpynet\\|mihomo' | tail -n 80" })
    return { logs = output }
end

--[[
    @method-type: call
    @method-name: connections
    @method-desc: Get active HarpyNet connections from Clash API
--]]
function M.connections()
    local rc, output = run({ "/usr/bin/harpynet", "clash_api", "get_connections" })
    local _, failures = run({ "/usr/bin/harpynet", "get_connection_failures" })
    local _, devices = run({ "/usr/bin/harpynet", "get_dhcp_clients" })
    if first_line(output) == "" then
        output = '{"connections":[],"uploadTotal":0,"downloadTotal":0}'
    end
    return {
        ok = true,
        rc = rc,
        json = output,
        failures = first_line(failures) ~= "" and failures or "[]",
        devices = first_line(devices) ~= "" and devices or '{"devices":[]}'
    }
end

--[[
    @method-type: call
    @method-name: direct_connections
    @method-desc: Get direct system connections outside Mihomo
--]]
function M.direct_connections()
    local rc, output = run({ "/bin/sh", "/usr/lib/harpynet_direct_monitor.sh" })
    local _, devices = run({ "/usr/bin/harpynet", "get_dhcp_clients" })
    if first_line(output) == "" then
        output = '{"ok":false,"connections":[],"count":0,"uploadTotal":0,"downloadTotal":0}'
    end
    return {
        ok = rc == 0,
        rc = rc,
        json = output,
        devices = first_line(devices) ~= "" and devices or '{"devices":[]}'
    }
end

--[[
    @method-type: call
    @method-name: devices
    @method-desc: Get DHCP devices and saved per-device HarpyNet routing
--]]
function M.devices()
    local _, devices = run({ "/usr/bin/harpynet", "get_dhcp_clients" })
    local _, outbounds = run({ "/usr/bin/harpynet", "get_device_outbound_options" })
    local proxy_section = primary_proxy_section()
    local route_modes = {}
    local device_outbounds = {}

    local excluded = uci_get_list("settings", "routing_excluded_ips")
    local routed = proxy_section ~= "" and uci_get_list(proxy_section, "fully_routed_ips") or {}
    local smart_routed = proxy_section ~= "" and uci_get_list(proxy_section, "smart_routed_ips") or {}
    local bypass_ru = proxy_section ~= "" and uci_get_list(proxy_section, "bypass_ru_routed_ips") or {}
    local outbound_entries = proxy_section ~= "" and uci_get_list(proxy_section, "device_outbounds") or {}

    local known_ips = {}
    for _, ip in ipairs(excluded) do
        route_modes[ip] = "exclude"
        known_ips[ip] = true
    end
    for _, ip in ipairs(bypass_ru) do
        route_modes[ip] = "full_proxy_bypass_ru"
        known_ips[ip] = true
    end
    for _, ip in ipairs(smart_routed) do
        route_modes[ip] = "proxy"
        known_ips[ip] = true
    end
    for _, ip in ipairs(routed) do
        if route_modes[ip] == nil then
            route_modes[ip] = "full_proxy"
        end
        known_ips[ip] = true
    end

    for _, entry in ipairs(outbound_entries) do
        local ip, tag = tostring(entry or ""):match("^([^=]+)=(.+)$")
        if ip and tag and valid_ip(ip) then
            device_outbounds[ip] = tag
            known_ips[ip] = true
        end
    end

    return {
        ok = true,
        devices = first_line(devices) ~= "" and devices or '{"clients":{},"devices":[]}',
        outbounds = first_line(outbounds) ~= "" and outbounds or '{"success":true,"outbounds":[]}',
        route_modes = json_object(route_modes),
        device_outbounds = json_object(device_outbounds)
    }
end

--[[
    @method-type: call
    @method-name: set_device_route
    @method-desc: Set per-device routing mode
--]]
function M.set_device_route(params)
    local ip = params and params.ip or ""
    local mode = params and params.mode or ""

    if not valid_ip(ip) then
        return { ok = false, error = "invalid_ip" }
    end
    if mode ~= "default" and mode ~= "proxy" and mode ~= "full_proxy" and mode ~= "full_proxy_bypass_ru" and mode ~= "exclude" then
        return { ok = false, error = "invalid_mode" }
    end

    return command_result("set_device_route", { "/usr/bin/harpynet", "set_device_route", ip, mode })
end

--[[
    @method-type: call
    @method-name: set_device_outbound
    @method-desc: Set per-device subscription outbound
--]]
function M.set_device_outbound(params)
    local ip = params and params.ip or ""
    local outbound = params and params.outbound or "default"

    if not valid_ip(ip) then
        return { ok = false, error = "invalid_ip" }
    end
    if type(outbound) ~= "string" or outbound:find("[%z\r\n\t]") or #outbound > 180 then
        return { ok = false, error = "invalid_outbound" }
    end

    return command_result("set_device_outbound", { "/usr/bin/harpynet", "set_device_outbound", ip, outbound ~= "" and outbound or "default" })
end

--[[
    @method-type: call
    @method-name: dashboard
    @method-desc: Get HarpyNet dashboard subscription metadata and outbounds
--]]
function M.dashboard()
    local _, metadata = run({ "/usr/bin/harpynet", "get_subscription_metadata", "main" })
    local _, outbounds = run({ "/usr/bin/harpynet", "get_device_outbound_options", "main" })
    local _, proxies = run({ "/usr/bin/harpynet", "clash_api", "get_proxies" })
    metadata = trim(metadata or "")

    return {
        ok = true,
        selected_outbound = uci_get("harpynet", "main", "selected_outbound"),
        metadata = metadata ~= "" and metadata or "{}",
        outbounds = first_line(outbounds) ~= "" and outbounds or '{"success":true,"outbounds":[]}',
        proxies = first_line(proxies) ~= "" and proxies or "{}"
    }
end

--[[
    @method-type: call
    @method-name: select_outbound
    @method-desc: Select main subscription outbound through Clash API
--]]
function M.select_outbound(params)
    local tag = params and params.tag or ""
    if not valid_proxy_tag(tag) then
        return { ok = false, error = "invalid_proxy_tag" }
    end

    return command_result("select_outbound", { "/usr/bin/harpynet", "clash_api", "set_group_proxy", "main-out", tag })
end

--[[
    @method-type: call
    @method-name: test_latency
    @method-desc: Test latency for main selector outbounds
--]]
function M.test_latency()
    return command_result("test_latency", { "/usr/bin/harpynet", "clash_api", "get_group_latency", "main-out", "8000" })
end

--[[
    @method-type: call
    @method-name: close_connection
    @method-desc: Close one active HarpyNet connection
--]]
function M.close_connection(params)
    local id = params and params.id or ""
    if type(id) ~= "string" or id == "" or #id > 256 or id:find("[%z\r\n]") then
        return { ok = false, error = "invalid_connection_id" }
    end

    return command_result("close_connection", { "/usr/bin/harpynet", "clash_api", "close_connection", id })
end

--[[
    @method-type: call
    @method-name: close_all_connections
    @method-desc: Close all active HarpyNet connections
--]]
function M.close_all_connections()
    return command_result("close_all_connections", { "/usr/bin/harpynet", "clash_api", "close_all_connections" })
end

--[[
    @method-type: call
    @method-name: set_subscription
    @method-desc: Save HarpyNet subscription URL for the main section
--]]
function M.set_subscription(params)
    local url = params and params.url or ""

    if not valid_subscription_url(url) then
        return {
            ok = false,
            error = "invalid_subscription_url"
        }
    end

    local rc, output = run({
        "/usr/bin/harpynet",
        "save_subscription_url",
        "main",
        url,
        "plain"
    })
    local success = json_success(output)

    return {
        ok = success == true or (success == nil and rc == 0),
        rc = rc,
        output = output
    }
end

--[[
    @method-type: call
    @method-name: set_main_config
    @method-desc: Save native GL.iNet HarpyNet main section settings
--]]
function M.set_main_config(params)
    params = params or {}

    local connection_type = normalize_option(params.connection_type)
    local user_domain_list_type = normalize_option(params.user_domain_list_type)
    local user_subnet_list_type = normalize_option(params.user_subnet_list_type)

    if not valid_connection_type(connection_type) then
        return { ok = false, error = "invalid_connection_type" }
    end
    if not valid_list_type(user_domain_list_type) then
        return { ok = false, error = "invalid_user_domain_list_type" }
    end
    if not valid_list_type(user_subnet_list_type) then
        return { ok = false, error = "invalid_user_subnet_list_type" }
    end

    set_option("main", "connection_type", connection_type)
    set_option("main", "proxy_config_type", "subscription")
    set_option("main", "enable_udp_over_tcp", normalize_flag(params.enable_udp_over_tcp))
    set_option("main", "upstream_proxy_enabled", normalize_flag(params.upstream_proxy_enabled))
    set_option("main", "upstream_proxy_name", normalize_option(params.upstream_proxy_name))
    local upstream_proxy_protocol = normalize_option(params.upstream_proxy_protocol)
    if upstream_proxy_protocol == "" then
        upstream_proxy_protocol = "http"
    end
    set_option("main", "upstream_proxy_protocol", upstream_proxy_protocol)
    set_option("main", "upstream_proxy_server", normalize_option(params.upstream_proxy_server))
    set_option("main", "upstream_proxy_port", normalize_option(params.upstream_proxy_port))
    set_option("main", "upstream_proxy_username", normalize_option(params.upstream_proxy_username))
    set_option("main", "upstream_proxy_password", normalize_option(params.upstream_proxy_password))
    set_option("main", "upstream_proxy_tls_server_name", normalize_option(params.upstream_proxy_tls_server_name))
    set_option("main", "upstream_proxy_domains", normalize_text(params.upstream_proxy_domains))
    set_option("main", "user_domain_list_type", user_domain_list_type)
    set_option("main", "user_domains_text", normalize_domain_list(params.user_domains_text))
    set_option("main", "user_subnet_list_type", user_subnet_list_type)
    set_option("main", "user_subnets_text", normalize_subnet_list(params.user_subnets_text))
    set_option("main", "mixed_proxy_enabled", normalize_flag(params.mixed_proxy_enabled))
    set_option("main", "mixed_proxy_port", normalize_option(params.mixed_proxy_port))
    set_option("main", "resolve_real_ip_for_routing", normalize_flag(params.resolve_real_ip_for_routing))

    replace_list("main", "community_lists", split_text_list(params.community_lists))
    replace_list("main", "upstream_proxy_community_lists", split_text_list(params.upstream_proxy_community_lists))
    replace_list("main", "local_domain_lists", split_text_list(params.local_domain_lists))
    replace_list("main", "local_subnet_lists", split_text_list(params.local_subnet_lists))
    replace_list("main", "remote_domain_lists", split_text_list(params.remote_domain_lists))
    replace_list("main", "remote_subnet_lists", split_text_list(params.remote_subnet_lists))
    replace_list("main", "fully_routed_ips", split_text_list(params.fully_routed_ips))

    local rc, output = run({ "uci", "commit", "harpynet" })
    if rc ~= 0 then
        return { ok = false, rc = rc, error = "uci_commit_failed", output = output }
    end

    local mode_rc, mode_output = run({ "/usr/bin/harpynet", "apply_config" })
    if mode_rc ~= 0 then
        return { ok = false, rc = mode_rc, error = "mihomo_config_apply_failed", output = mode_output }
    end

    return { ok = true, output = mode_output }
end


--[[
    @method-type: call
    @method-name: check_upstream_proxy
    @method-desc: Check active upstream proxy from router
--]]
function M.check_upstream_proxy(params)
    params = params or {}
    local section = normalize_option(params.section)
    if section == "" then
        section = "main"
    end
    local rc, output = run({ "/usr/bin/harpynet", "check_upstream_proxy", section })
    local success = json_success(output)
    return {
        ok = success == true or (success == nil and rc == 0),
        rc = rc,
        output = output
    }
end

--[[
    @method-type: call
    @method-name: set_settings_config
    @method-desc: Save native GL.iNet HarpyNet system settings
--]]
function M.set_settings_config(params)
    params = params or {}

    local dns_type = normalize_option(params.dns_type)
    local update_interval = normalize_option(params.update_interval)
    local subscription_update_interval = normalize_option(params.subscription_update_interval)
    local log_level = normalize_option(params.log_level)

    if not valid_dns_type(dns_type) then
        return { ok = false, error = "invalid_dns_type" }
    end
    if not valid_update_interval(update_interval) then
        return { ok = false, error = "invalid_update_interval" }
    end
    if not valid_update_interval(subscription_update_interval) then
        return { ok = false, error = "invalid_subscription_update_interval" }
    end
    if not valid_log_level(log_level) then
        return { ok = false, error = "invalid_log_level" }
    end

    set_option("settings", "dns_type", dns_type)
    set_option("settings", "dns_server", normalize_option(params.dns_server))
    set_option("settings", "bootstrap_dns_server", normalize_option(params.bootstrap_dns_server))
    set_option("settings", "dns_rewrite_ttl", normalize_option(params.dns_rewrite_ttl))
    set_option("settings", "enable_output_network_interface", normalize_flag(params.enable_output_network_interface))
    set_option("settings", "output_network_interface", normalize_option(params.output_network_interface))
    set_option("settings", "enable_badwan_interface_monitoring", normalize_flag(params.enable_badwan_interface_monitoring))
    set_option("settings", "enable_yacd", normalize_flag(params.enable_yacd))
    set_option("settings", "disable_quic", normalize_flag(params.disable_quic))
    set_option("settings", "update_interval", update_interval)
    set_option("settings", "subscription_update_interval", subscription_update_interval)
    set_option("settings", "download_lists_via_proxy", normalize_flag(params.download_lists_via_proxy))
    set_option("settings", "dont_touch_dhcp", normalize_flag(params.dont_touch_dhcp))
    set_option("settings", "config_path", normalize_option(params.config_path))
    set_option("settings", "cache_path", normalize_option(params.cache_path))
    set_option("settings", "log_level", log_level)
    set_option("settings", "exclude_ntp", normalize_flag(params.exclude_ntp))

    replace_list("settings", "source_network_interfaces", split_text_list(params.source_network_interfaces))
    replace_list("settings", "badwan_monitored_interfaces", split_text_list(params.badwan_monitored_interfaces))
    replace_list("settings", "routing_excluded_ips", split_text_list(params.routing_excluded_ips))

    local rc, output = run({ "uci", "commit", "harpynet" })
    if rc ~= 0 then
        return { ok = false, rc = rc, error = "uci_commit_failed", output = output }
    end

    local dns_rc, dns_output = run({ "/usr/bin/harpynet", "refresh_dns" })
    if dns_rc ~= 0 then
        return { ok = false, rc = dns_rc, error = "dns_apply_failed", output = dns_output }
    end

    return { ok = true, output = dns_output }
end

