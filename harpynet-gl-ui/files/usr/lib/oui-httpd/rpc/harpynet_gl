--[[
    @object-name: harpynet_gl
    @object-desc: HarpyNet native GL.iNet UI bridge
--]]

local M = {}

local function run(argv)
    local quoted = {}
    for i, arg in ipairs(argv) do
        quoted[i] = "'" .. tostring(arg):gsub("'", "'\\''") .. "'"
    end

    local pipe = io.popen(table.concat(quoted, " ") .. " 2>&1; printf '\\n__HN_RC__%s' $?")
    if not pipe then
        return 127, ""
    end

    local output = pipe:read("*a") or ""
    pipe:close()

    local body, code = output:match("^(.*)\n__HN_RC__(%d+)$")
    if code then
        return tonumber(code) or 1, body or ""
    end

    return 1, output
end

local function first_line(text)
    return (text or ""):match("([^\r\n]+)") or ""
end

local function trim(text)
    return tostring(text or ""):match("^%s*(.-)%s*$") or ""
end

local function read_file(path)
    local file = io.open(path, "rb")
    if not file then
        return nil
    end
    local data = file:read("*a") or ""
    file:close()
    return data
end

local function json_string(value)
    return '"' .. tostring(value or "")
        :gsub("\\", "\\\\")
        :gsub('"', '\\"')
        :gsub("\b", "\\b")
        :gsub("\f", "\\f")
        :gsub("\n", "\\n")
        :gsub("\r", "\\r")
        :gsub("\t", "\\t") .. '"'
end

local function json_object(map)
    local parts = {}
    for key, value in pairs(map or {}) do
        parts[#parts + 1] = json_string(key) .. ":" .. json_string(value)
    end
    return "{" .. table.concat(parts, ",") .. "}"
end

local function init_enabled()
    local rc = run({ "/etc/init.d/harpynet", "enabled" })
    return rc == 0 and 1 or 0
end

local function mihomo_running()
    local rc = run({ "/bin/pidof", "mihomo" })
    return rc == 0 and 1 or 0
end

local function uci_get(config, section, option)
    local _, output = run({ "uci", "-q", "get", config .. "." .. section .. "." .. option })
    return first_line(output)
end

local function uci_get_list(section, option)
    local _, output = run({ "uci", "-q", "get", "harpynet." .. section .. "." .. option })
    local result = {}

    for item in tostring(output or ""):gmatch("%S+") do
        result[#result + 1] = item
    end

    return result
end

local function list_has(values, needle)
    for _, value in ipairs(values or {}) do
        if value == needle then
            return true
        end
    end
    return false
end

local function valid_ip(value)
    if type(value) ~= "string" or not value:match("^%d+%.%d+%.%d+%.%d+$") then
        return false
    end

    for octet in value:gmatch("%d+") do
        local number = tonumber(octet)
        if not number or number < 0 or number > 255 then
            return false
        end
    end

    return true
end

local function primary_proxy_section()
    local _, output = run({ "sh", "-c", "uci show harpynet 2>/dev/null | sed -n \"s/^harpynet\\.\\([^.=]*\\)=section$/\\1/p\"" })
    local fallback = ""

    for section in tostring(output or ""):gmatch("[^\r\n]+") do
        section = trim(section)
        if section ~= "" then
            if fallback == "" then
                fallback = section
            end
            local connection_type = uci_get("harpynet", section, "connection_type")
            if connection_type == "proxy" or connection_type == "full_proxy" or connection_type == "full_proxy_bypass_ru" then
                return section
            end
        end
    end

    return fallback
end

local function command_result(command, argv)
    local rc, output = run(argv)
    local success = json_success(output)
    local benign_async_start = (command == "start" or command == "restart")
        and tostring(output or ""):match("Start harpynet")
        and tostring(output or ""):match("service_triggers start")
    local latency_success = command == "test_latency"
        and tostring(output or ""):match("^%s*{")
        and not tostring(output or ""):match('"error"')
    local ok = success == true or benign_async_start or latency_success or (success == nil and rc == 0)
    return {
        ok = ok,
        success = ok,
        rc = rc,
        command = command,
        output = output
    }
end

function json_success(output)
    local text = tostring(output or "")
    if text:match('"success"%s*:%s*true') then
        return true
    end
    if text:match('"success"%s*:%s*false') then
        return false
    end
    return nil
end

local function normalize_flag(value)
    if value == true or value == 1 or value == "1" or value == "true" then
        return "1"
    end
    return "0"
end

local function normalize_option(value)
    return tostring(value or ""):gsub("[%z\r]", "")
end

local function normalize_text(value)
    return tostring(value or ""):gsub("%z", "")
end

local function split_text_list(value)
    local result, seen = {}, {}

    for item in tostring(value or ""):gmatch("[^\n, ]+") do
        item = item:gsub("^%s+", ""):gsub("%s+$", "")
        if item ~= "" and not seen[item] then
            seen[item] = true
            result[#result + 1] = item
        end
    end

    return result
end

local function normalize_domain_list(value)
    local result, seen = {}, {}

    for line in tostring(value or ""):gmatch("[^\r\n]+") do
        line = line:gsub("//.*$", ""):gsub(",", " ")
        for item in line:gmatch("%S+") do
            item = item:lower():gsub("^%+%.", ""):gsub("^%*%.", ""):gsub("%.$", "")
            if item:match("^[%w_.-]+$") and item:find("%.", 1, false) and not seen[item] then
                seen[item] = true
                result[#result + 1] = item
            end
        end
    end

    return table.concat(result, "\n")
end

local function normalize_subnet_list(value)
    local result, seen = {}, {}

    for line in tostring(value or ""):gmatch("[^\r\n]+") do
        line = line:gsub("//.*$", ""):gsub(",", " ")
        for item in line:gmatch("%S+") do
            item = item:lower()
            local address, prefix = item:match("^([^/]+)/(%d+)$")
            address = address or item
            local canonical = item
            local valid = false
            if valid_ip(address) then
                prefix = tonumber(prefix or "32")
                valid = prefix >= 0 and prefix <= 32
                canonical = address .. "/" .. prefix
            elseif address:match("^[%x:]+$") and address:find(":", 1, true) then
                prefix = tonumber(prefix or "128")
                valid = prefix >= 0 and prefix <= 128
                canonical = address .. "/" .. prefix
            end
            if valid and not seen[canonical] then
                seen[canonical] = true
                result[#result + 1] = canonical
            end
        end
    end

    return table.concat(result, "\n")
end

local function set_option(section, option, value)
    return run({ "uci", "set", "harpynet." .. section .. "." .. option .. "=" .. value })
end

local function replace_list(section, option, values)
    run({ "uci", "-q", "delete", "harpynet." .. section .. "." .. option })

    for _, value in ipairs(values or {}) do
        if value ~= "" then
            local rc = run({ "uci", "add_list", "harpynet." .. section .. "." .. option .. "=" .. value })
            if rc ~= 0 then
                return rc
            end
        end
    end

    return 0
end

local function valid_subscription_url(value)
    return type(value) == "string"
        and #value > 0
        and #value <= 4096
        and not value:find("[%z\r\n%s]")
        and (value:match("^https://") or value:match("^http://"))
end

local function valid_connection_type(value)
    return value == "proxy" or value == "full_proxy" or value == "full_proxy_bypass_ru" or value == "exclusion"
end

local function valid_list_type(value)
    return value == "disabled" or value == "dynamic" or value == "text"
end

local function valid_dns_type(value)
    return value == "udp" or value == "dot" or value == "doh"
end

local function valid_update_interval(value)
    return value == "1h" or value == "3h" or value == "6h" or value == "12h" or value == "1d" or value == "3d"
end

local function valid_log_level(value)
    return value == "trace" or value == "debug" or value == "info" or value == "warn" or value == "error" or value == "fatal" or value == "panic"
end

local function valid_proxy_tag(value)
    return type(value) == "string"
        and #value > 0
        and #value <= 256
        and not value:find("[%z\r\n]")
end

