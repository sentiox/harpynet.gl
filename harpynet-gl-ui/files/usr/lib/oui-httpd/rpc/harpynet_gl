        dashboard_proxies = first_line(proxies) ~= "" and proxies or "{}",
        dashboard = {
            selected_outbound = selected_outbound,
            metadata = metadata ~= "" and metadata or "{}",
            outbounds = first_line(outbounds) ~= "" and outbounds or '{"success":true,"outbounds":[]}',
            proxies = first_line(proxies) ~= "" and proxies or "{}"
