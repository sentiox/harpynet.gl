#!/bin/ash

check_required_file() {
    local file="$1"

    if [ ! -r "$file" ]; then
        echo "Error: required file '$file' is missing or not readable" >&2
        exit 1
    fi
}

HARPYNET_LIB="/usr/lib/harpynet"
check_required_file /lib/functions.sh
check_required_file /lib/config/uci.sh
check_required_file /lib/functions/network.sh
check_required_file "$HARPYNET_LIB/constants.sh"
check_required_file "$HARPYNET_LIB/nft.sh"
check_required_file "$HARPYNET_LIB/helpers.sh"
check_required_file "$HARPYNET_LIB/sing_box_config_manager.sh"
check_required_file "$HARPYNET_LIB/sing_box_config_facade.sh"
check_required_file "$HARPYNET_LIB/logging.sh"
check_required_file "$HARPYNET_LIB/rulesets.sh"
. /lib/functions.sh
. /lib/config/uci.sh
. /lib/functions/network.sh
. "$HARPYNET_LIB/constants.sh"
. "$HARPYNET_LIB/nft.sh"
. "$HARPYNET_LIB/helpers.sh"
. "$HARPYNET_LIB/sing_box_config_manager.sh"
. "$HARPYNET_LIB/sing_box_config_facade.sh"
. "$HARPYNET_LIB/logging.sh"
. "$HARPYNET_LIB/rulesets.sh"

config_load "$HARPYNET_CONFIG"
HARPYNET_RELEASE_REPO="${HARPYNET_RELEASE_REPO:-sentiox/HarpyNet-Router}"
HARPYNET_RELEASE_URL="https://github.com/$HARPYNET_RELEASE_REPO/releases"
HARPYNET_RELEASE_API="https://api.github.com/repos/$HARPYNET_RELEASE_REPO/releases/latest"

check_requirements() {
    log "Check Requirements"

    local sing_box_version jq_version coreutils_base64_version
    sing_box_version="$(sing-box version | head -n1 | awk '{print $3}')"
    jq_version="$(jq --version | awk -F- '{print $2}')"
    coreutils_base64_version="$(base64 --version | head -n1 | awk '{print $4}')"

    if [ -z "$sing_box_version" ]; then
        log "Package 'sing-box' is not installed. Aborted." "error"
        exit 1
    else
        if ! is_min_package_version "$sing_box_version" "$SB_REQUIRED_VERSION"; then
            log "Package 'sing-box' version ($sing_box_version) is lower than the required minimum ($SB_REQUIRED_VERSION). Update sing-box: opkg update && opkg remove sing-box && opkg install sing-box. Aborted." "error"
            exit 1
        fi

        if ! service_exists "sing-box"; then
            log "Service 'sing-box' is missing. Please install the official package to ensure the service is available. Aborted." "error"
            exit 1
        fi
    fi

    if [ -z "$jq_version" ]; then
        log "Package 'jq' is not installed. Aborted." "error"
        exit 1
    elif ! is_min_package_version "$jq_version" "$JQ_REQUIRED_VERSION"; then
        log "Package 'jq' version ($jq_version) is lower than the required minimum ($JQ_REQUIRED_VERSION). Aborted." "error"
        exit 1
    fi

    if [ -z "$coreutils_base64_version" ]; then
        log "Package 'coreutils-base64' is not installed. Aborted." "error"
        exit 1
    elif ! is_min_package_version "$coreutils_base64_version" "$COREUTILS_BASE64_REQUIRED_VERSION"; then
        log "Package 'coreutils-base64' version ($coreutils_base64_version) is lower than the required minimum ($COREUTILS_BASE64_REQUIRED_VERSION). This may cause issues when decoding base64 streams with missing padding, as automatic padding support is not available in older versions." "warn"
    fi

    if grep -qE 'doh_backup_noresolv|doh_backup_server|doh_server' /etc/config/dhcp; then
        log "Detected https-dns-proxy in DHCP config. Edit /etc/config/dhcp" "error"
    fi

    if has_outbound_section; then
        log "Outbound section found" "debug"
    elif all_sections_vpn_disabled; then
        log "VPN is disabled for all sections; outbound section is not required" "info"
    else
        log "Outbound section not found. Please configure a subscription URL. Aborted." "error"
        exit 1
    fi
}

all_sections_vpn_disabled() {
    uci -q show harpynet | grep -q "\.connection_type='exclusion'" && \
        ! uci -q show harpynet | grep -Eq "\.connection_type='(proxy|full_proxy|full_proxy_bypass_ru)'"
}

_check_outbound_section() {
    local section="$1"
    local subscription_url interface persistent_cache_file runtime_cache_file

    config_get subscription_url "$section" "subscription_url"
    config_get interface "$section" "interface"
    persistent_cache_file="/etc/harpynet/subscription-cache/subscription-$section.links"
    runtime_cache_file="/var/run/harpynet/subscription-$section.links"

    if [ -n "$subscription_url" ] || [ -n "$interface" ] || \
        [ -s "$persistent_cache_file" ] || [ -s "$runtime_cache_file" ]; then
        section_exists=0
    fi
}

has_outbound_section() {
    local section_exists=1

    config_foreach _check_outbound_section "section"

    return $section_exists
}

wait_for_start_lock() {
    local lock_dir="/var/run/harpynet-start.lock"
    local timeout="${1:-45}"
    local waited=0

    while [ -d "$lock_dir" ] && [ "$waited" -lt "$timeout" ]; do
        sleep 1
        waited=$((waited + 1))
    done

    [ ! -d "$lock_dir" ]
}

start_main() {
    local lock_dir="/var/run/harpynet-start.lock"

    if ! mkdir "$lock_dir" 2>/dev/null; then
        log "HarpyNet start is already running, waiting for it to finish" "warn"
        wait_for_start_lock 60
        return 0
    fi
    trap "rmdir '$lock_dir' 2>/dev/null" EXIT INT TERM

    log "Starting harpynet"

    check_requirements

    migration

    config_foreach process_validate_service "section"

    br_netfilter_disable

    # Sync time for DoH/DoT
    if [ -x /usr/sbin/ntpd ]; then
        /usr/sbin/ntpd -q -p 194.190.168.1 -p 216.239.35.0 -p 216.239.35.4 \
            -p 162.159.200.1 -p 162.159.200.123
    else
        log "ntpd is not installed; skipping optional time synchronization" "debug"
    fi

    sleep 1

    mkdir -p "$TMP_SING_BOX_FOLDER"
    mkdir -p "$TMP_RULESET_FOLDER"
    mkdir -p "$SRS_CACHE_DIR"
    case "$TMP_RULESET_FOLDER" in
    /tmp/*) rm -f "$TMP_RULESET_FOLDER"/* ;;
    esac

    if [ "$HN_REUSE_PREFLIGHT_CONFIG" = "1" ]; then
        sing_box_configure_service
        sing_box_config_check "$(uci_get harpynet settings config_path)"
        ensure_local_ruleset_files
    else
        prepare_start_config
    fi

    # Apply network changes only after configuration generation succeeds.
    route_table_rule_mark
    create_nft_rules
    config_foreach add_cron_job "section"
    add_subscription_cron_job
    /etc/init.d/sing-box start
    sleep 2
    if ! pgrep -f '/usr/bin/sing-box run' > /dev/null 2>&1; then
        log "sing-box exited immediately after start" "error"
        return 1
    fi

    log "Nice"
    # Detach the background updater from RPC stdout/stderr so LuCI exec calls
    # can finish as soon as the service restart has completed.
    HN_STARTUP_LIST_UPDATE=1 list_update >/dev/null 2>&1 &
    echo $! > /var/run/harpynet_list_update.pid

    rmdir "$lock_dir" 2>/dev/null
    trap - EXIT INT TERM
}

prepare_start_config() {
    # This function is safe to run while the old sing-box process is active.
    # It downloads/caches dependencies and validates the complete candidate
    # config before routing or the running process is touched.
    sing_box_configure_service
    sing_box_init_config
    ensure_local_ruleset_files
}

stop_main() {
    log "Stopping the harpynet"

    if ! wait_for_start_lock 60; then
        log "HarpyNet start lock is still active, continuing stop" "warn"
    fi

    if [ -f /var/run/harpynet_list_update.pid ]; then
        pid=$(cat /var/run/harpynet_list_update.pid)
        if kill -0 "$pid" 2> /dev/null; then
            kill "$pid" 2> /dev/null
            log "Stopped list_update"
        fi
        rm -f /var/run/harpynet_list_update.pid
    fi

    remove_cron_job

    case "$TMP_RULESET_FOLDER" in
    /tmp/*) rm -f "$TMP_RULESET_FOLDER"/* ;;
    esac

    log "Flush nft"
    if nft list table inet "$NFT_TABLE_NAME" > /dev/null 2>&1; then
        nft delete table inet "$NFT_TABLE_NAME"
    fi

    log "Flush ip rule"
    if ip rule list | grep -q "harpynet"; then
        ip rule del fwmark "$NFT_FAKEIP_MARK"/"$NFT_FAKEIP_MARK" table "$RT_TABLE_NAME" priority 105
    fi

    log "Flush ip route"
    if ip route list table "$RT_TABLE_NAME" > /dev/null 2>&1; then
        ip route flush table "$RT_TABLE_NAME"
    fi

    log "Stop sing-box"
    /etc/init.d/sing-box stop
}

ensure_local_ruleset_files() {
    local sing_box_config_path="$1"
    [ -n "$sing_box_config_path" ] || config_get sing_box_config_path "settings" "config_path" "/etc/sing-box/config.json"

    [ -f "$sing_box_config_path" ] || return 0

    jq -r '.route.rule_set[]? | select(.type == "local" and .format == "source") | [.tag, .path] | @tsv' \
        "$sing_box_config_path" 2>/dev/null |
        while IFS="$(printf '\t')" read -r ruleset_tag ruleset_path; do
            [ -n "$ruleset_tag" ] && [ -n "$ruleset_path" ] || continue
            [ -s "$ruleset_path" ] && continue

            log "Local ruleset $ruleset_path is missing, restoring it" "warn"
            ensure_local_ruleset_file "$ruleset_tag" "$ruleset_path"
        done
}

ensure_local_ruleset_file() {
    local ruleset_tag="$1"
    local ruleset_path="$2"
    local section items json_array key

    mkdir -p "$(dirname "$ruleset_path")"

    case "$ruleset_tag" in
    *-user-domains-ruleset)
        section="${ruleset_tag%-user-domains-ruleset}"
        config_get items "$section" "user_domains_text"
        items="$(parse_domain_or_subnet_string_to_commas_string "$items" "domains")"
        json_array="$(comma_string_to_json_array "$items")"
        key="domain_suffix"
        ;;
    *-user-subnets-ruleset)
        section="${ruleset_tag%-user-subnets-ruleset}"
        config_get items "$section" "user_subnets_text"
        items="$(parse_domain_or_subnet_string_to_commas_string "$items" "subnets")"
        json_array="$(comma_string_to_json_array "$items")"
        key="ip_cidr"
        ;;
    *)
        json_array='[]'
        key="domain_suffix"
        ;;
    esac

    jq -n --arg key "$key" --argjson values "$json_array" \
        '{version: 3, rules: [ { ($key): $values } ]}' > "$ruleset_path"
}

start() {
    local dont_touch_dhcp shutdown_correctly
    config_get_bool dont_touch_dhcp "settings" "dont_touch_dhcp" 0
    config_get shutdown_correctly "settings" "shutdown_correctly" 1

    if [ "$shutdown_correctly" -eq 0 ]; then
        log "Recovering network state after an interrupted HarpyNet shutdown" "warn"
        if [ "$dont_touch_dhcp" -eq 0 ]; then
            dnsmasq_restore
        fi
        stop_main
        uci_set "harpynet" "settings" "shutdown_correctly" 1
        uci commit "harpynet"
        config_load "$HARPYNET_CONFIG"
    fi

    if all_sections_vpn_disabled; then
        log "VPN is disabled for all sections; stopping routing services" "info"
        stop_main
        if [ "$dont_touch_dhcp" -eq 0 ]; then
            dnsmasq_restore
        fi
        uci_set "harpynet" "settings" "shutdown_correctly" 1
        uci commit "harpynet" && config_load "$HARPYNET_CONFIG"
        return 0
    fi

    if ! (start_main); then
        log "HarpyNet failed to start. Restoring router network settings." "error"
        stop_main
        if [ "$dont_touch_dhcp" -eq 0 ]; then
            dnsmasq_restore
        fi
        uci_set "harpynet" "settings" "shutdown_correctly" 1
        uci commit "harpynet"
        return 1
    fi

    if [ "$dont_touch_dhcp" -eq 0 ]; then
        dnsmasq_configure
    fi

    uci_set "harpynet" "settings" "shutdown_correctly" 0
    uci commit "harpynet" && config_load "$HARPYNET_CONFIG"
}

stop() {
    local dont_touch_dhcp
    config_get_bool dont_touch_dhcp "settings" "dont_touch_dhcp" 0
    if [ "$dont_touch_dhcp" -eq 0 ]; then
        dnsmasq_restore
    fi

    stop_main

    uci_set "harpynet" "settings" "shutdown_correctly" 1
    uci commit "harpynet" && config_load "$HARPYNET_CONFIG"
}

reload() {
    log "HarpyNet reload"
    restart
}

restart() {
    log "HarpyNet restart"
    local sing_box_config_path previous_config result
    config_get sing_box_config_path "settings" "config_path" "/etc/sing-box/config.json"
    previous_config="$(mktemp)"
    cp "$sing_box_config_path" "$previous_config" 2>/dev/null || : > "$previous_config"

    log "Preparing and validating replacement configuration before restart"
    if ! (prepare_start_config); then
        log "Replacement configuration preparation failed; keeping current HarpyNet session" "error"
        rm -f "$previous_config"
        return 1
    fi

    HN_REUSE_PREFLIGHT_CONFIG=1
    export HN_REUSE_PREFLIGHT_CONFIG
    stop
    start
    result=$?
    if [ "$result" -ne 0 ] && [ -s "$previous_config" ]; then
        log "Replacement failed to start; restoring previous sing-box configuration" "error"
        cp "$previous_config" "$sing_box_config_path"
        HN_REUSE_PREFLIGHT_CONFIG=1 start
    fi
    rm -f "$previous_config"
    unset HN_REUSE_PREFLIGHT_CONFIG
    return "$result"
}

# Migrations and validation funcs
migration() {
    migrate_dns_defaults
}

migrate_dns_defaults() {
    local dns_type dns_server bootstrap_dns_server changed=0

    config_get dns_type "settings" "dns_type"
    config_get dns_server "settings" "dns_server"
    config_get bootstrap_dns_server "settings" "bootstrap_dns_server"

    if [ -z "$dns_type" ]; then
        uci_set "harpynet" "settings" "dns_type" "udp"
        changed=1
    fi

    if [ -z "$dns_server" ]; then
        uci_set "harpynet" "settings" "dns_server" "77.88.8.8"
        changed=1
    fi

    if [ -z "$bootstrap_dns_server" ]; then
        uci_set "harpynet" "settings" "bootstrap_dns_server" "77.88.8.8"
        changed=1
    fi

    if [ "$dns_type" = "doh" ] && [ "$dns_server" = "1.1.1.1" ]; then
        log "Migrating old Cloudflare DoH DNS default to UDP 77.88.8.8 for better router stability" "warn"
        uci_set "harpynet" "settings" "dns_type" "udp"
        uci_set "harpynet" "settings" "dns_server" "77.88.8.8"
        changed=1
    fi

    [ "$changed" -eq 0 ] || uci_commit "harpynet"
}

validate_service() {
    local service="$1"

    for community_service in $COMMUNITY_SERVICES; do
        if [ "$service" = "$community_service" ]; then
            return 0
        fi
    done

    log "Invalid service in community lists: $service. Check config and LuCI cache. Aborted." "fatal"
    exit 1
}

process_validate_service() {
    local section="$1"
    local community_lists
    config_get community_lists "$section" "community_lists"
    if [ -n "$community_lists" ]; then
        config_list_foreach "$section" "community_lists" validate_service
    fi

    config_get community_lists "$section" "upstream_proxy_community_lists"
    if [ -n "$community_lists" ]; then
        config_list_foreach "$section" "upstream_proxy_community_lists" validate_service
    fi
}

br_netfilter_disable() {
    if lsmod | grep -q br_netfilter && [ "$(sysctl -n net.bridge.bridge-nf-call-iptables 2> /dev/null)" = "1" ]; then
        log "br_netfilter enabled detected. Disabling"
        sysctl -w net.bridge.bridge-nf-call-iptables=0
        sysctl -w net.bridge.bridge-nf-call-ip6tables=0
    fi
}

# Main funcs

route_table_rule_mark() {
    grep -q "105 $RT_TABLE_NAME" /etc/iproute2/rt_tables || echo "105 $RT_TABLE_NAME" >> /etc/iproute2/rt_tables

    if ! ip route list table "$RT_TABLE_NAME" 2> /dev/null | grep -q "local default dev lo scope host"; then
        log "Added route for tproxy" "debug"
        ip route add local 0.0.0.0/0 dev lo table "$RT_TABLE_NAME"
    else
        log "Route for tproxy exists" "debug"
    fi

    if ! ip rule list | grep -q "from all fwmark $NFT_FAKEIP_MARK/$NFT_FAKEIP_MARK lookup $RT_TABLE_NAME"; then
        log "Create marking rule" "debug"
        ip -4 rule add fwmark "$NFT_FAKEIP_MARK"/"$NFT_FAKEIP_MARK" table "$RT_TABLE_NAME" priority 105
    else
        log "Marking rule exist" "debug"
    fi
}

nft_init_interfaces_set() {
    nft_create_ifname_set "$NFT_TABLE_NAME" "$NFT_INTERFACE_SET_NAME"

    local source_network_interfaces
    config_get source_network_interfaces "settings" "source_network_interfaces" "br-lan"

    for interface in $source_network_interfaces; do
        nft add element inet "$NFT_TABLE_NAME" "$NFT_INTERFACE_SET_NAME" "{ $interface }"
    done
}

create_nft_rules() {
    log "Create nft table"
    nft_create_table "$NFT_TABLE_NAME"

    log "Create localv4 set"
    nft_create_ipv4_set "$NFT_TABLE_NAME" "$NFT_LOCALV4_SET_NAME"
    nft add element inet "$NFT_TABLE_NAME" localv4 '{
        0.0.0.0/8,
        10.0.0.0/8,
        127.0.0.0/8,
        169.254.0.0/16,
        172.16.0.0/12,
        192.0.0.0/24,
        192.0.2.0/24,
        192.88.99.0/24,
        192.168.0.0/16,
        198.51.100.0/24,
        203.0.113.0/24,
        224.0.0.0/4,
        240.0.0.0-255.255.255.255
    }'

    log "Create common set"
    nft_create_ipv4_set "$NFT_TABLE_NAME" "$NFT_COMMON_SET_NAME"

    log "Create interface set"
    nft_init_interfaces_set

    log "Create nft rules"
    nft add chain inet "$NFT_TABLE_NAME" mangle '{ type filter hook prerouting priority -150; policy accept; }'
    nft add chain inet "$NFT_TABLE_NAME" mangle_output '{ type route hook output priority -150; policy accept; }'
    nft add chain inet "$NFT_TABLE_NAME" proxy '{ type filter hook prerouting priority -100; policy accept; }'

    nft add rule inet "$NFT_TABLE_NAME" mangle ct status dnat return
    nft add rule inet "$NFT_TABLE_NAME" mangle iifname "@$NFT_INTERFACE_SET_NAME" ip daddr "@$NFT_COMMON_SET_NAME" meta l4proto tcp meta mark set "$NFT_FAKEIP_MARK" counter
    nft add rule inet "$NFT_TABLE_NAME" mangle iifname "@$NFT_INTERFACE_SET_NAME" ip daddr "@$NFT_COMMON_SET_NAME" meta l4proto udp meta mark set "$NFT_FAKEIP_MARK" counter
    nft add rule inet "$NFT_TABLE_NAME" mangle iifname "@$NFT_INTERFACE_SET_NAME" ip daddr "$SB_FAKEIP_INET4_RANGE" meta l4proto tcp meta mark set "$NFT_FAKEIP_MARK" counter
    nft add rule inet "$NFT_TABLE_NAME" mangle iifname "@$NFT_INTERFACE_SET_NAME" ip daddr "$SB_FAKEIP_INET4_RANGE" meta l4proto udp meta mark set "$NFT_FAKEIP_MARK" counter

    nft add rule inet "$NFT_TABLE_NAME" proxy meta mark \& "$NFT_FAKEIP_MARK" == "$NFT_FAKEIP_MARK" meta l4proto tcp tproxy ip to 127.0.0.1:1602 counter
    nft add rule inet "$NFT_TABLE_NAME" proxy meta mark \& "$NFT_FAKEIP_MARK" == "$NFT_FAKEIP_MARK" meta l4proto udp tproxy ip to 127.0.0.1:1602 counter

    nft add rule inet "$NFT_TABLE_NAME" mangle_output ip daddr "@$NFT_LOCALV4_SET_NAME" return
    nft add rule inet "$NFT_TABLE_NAME" mangle_output meta mark "$NFT_OUTBOUND_MARK" counter return
    nft add rule inet "$NFT_TABLE_NAME" mangle_output ip daddr "@$NFT_COMMON_SET_NAME" meta l4proto tcp meta mark set "$NFT_FAKEIP_MARK" counter
    nft add rule inet "$NFT_TABLE_NAME" mangle_output ip daddr "@$NFT_COMMON_SET_NAME" meta l4proto udp meta mark set "$NFT_FAKEIP_MARK" counter
    nft add rule inet "$NFT_TABLE_NAME" mangle_output ip daddr "$SB_FAKEIP_INET4_RANGE" meta l4proto tcp meta mark set "$NFT_FAKEIP_MARK" counter
    nft add rule inet "$NFT_TABLE_NAME" mangle_output ip daddr "$SB_FAKEIP_INET4_RANGE" meta l4proto udp meta mark set "$NFT_FAKEIP_MARK" counter

    config_foreach nft_include_full_proxy_section_handler "section"
    config_foreach nft_include_full_proxy_bypass_ru_source_ips_handler "section"
    config_foreach nft_include_source_ips_in_routing_handler "section"

    local exclude_ntp
    config_get_bool exclude_ntp "settings" "exclude_ntp" "0"
    if [ "$exclude_ntp" -eq 1 ]; then
        log "NTP traffic exclude for proxy"
        nft insert rule inet "$NFT_TABLE_NAME" mangle udp dport 123 return
    fi
}

backup_dnsmasq_config_option() {
    local key="$1"
    local backup_key="$2"
    local value
    value="$(uci_get "dhcp" "@dnsmasq[0]" "$key")"

    if [ -n "$value" ]; then
        uci_set "dhcp" "@dnsmasq[0]" "$backup_key" "$value"
    fi
}

dnsmasq_restart_quiet() {
    # OpenWrt init scripts may print helper noise such as udhcpc lease probes to
    # stderr. HarpyNet logs its own state via logger, so keep those helpers quiet.
    /etc/init.d/dnsmasq restart >/dev/null 2>&1
}

dnsmasq_configure() {
    local shutdown_correctly
    config_get shutdown_correctly "settings" "shutdown_correctly"
    if [ "$shutdown_correctly" -eq 0 ]; then
        log "Previous shutdown of harpynet was not correct, reconfiguration of dnsmasq is not required"
        return 0
    fi

    log "Backup dnsmasq configuration"
    current_servers="$(uci_get "dhcp" "@dnsmasq[0]" "server")"
    if [ -n "$current_servers" ]; then
        for server in $(uci_get "dhcp" "@dnsmasq[0]" "server"); do
            if ! [ "$server" == "$SB_DNS_INBOUND_ADDRESS" ]; then
                uci_add_list "dhcp" "@dnsmasq[0]" "harpynet_server" "$server"
            fi
        done
        uci_remove "dhcp" "@dnsmasq[0]" "server"
    fi

    backup_dnsmasq_config_option "noresolv" "harpynet_noresolv"
    backup_dnsmasq_config_option "cachesize" "harpynet_cachesize"
    backup_dnsmasq_config_option "logqueries" "harpynet_logqueries"
    backup_dnsmasq_config_option "logfacility" "harpynet_logfacility"

    log "Configure dnsmasq for sing-box"
    uci_add_list "dhcp" "@dnsmasq[0]" "server" "$SB_DNS_INBOUND_ADDRESS"
    uci_set "dhcp" "@dnsmasq[0]" "noresolv" 1
    uci_set "dhcp" "@dnsmasq[0]" "cachesize" 0
    uci_set "dhcp" "@dnsmasq[0]" "logqueries" 1
    uci_set "dhcp" "@dnsmasq[0]" "logfacility" "$DNS_LOG_FILE"
    uci_commit "dhcp"

    : > "$DNS_LOG_FILE"
    dnsmasq_restart_quiet
}

dnsmasq_restore() {
    log "Restoring the dnsmasq configuration"
    local shutdown_correctly
    config_get shutdown_correctly "settings" "shutdown_correctly"
    if [ "$shutdown_correctly" -eq 1 ]; then
        log "Previous shutdown of harpynet was correct, reconfiguration of dnsmasq is not required"
        return 0
    fi

    local cachesize noresolv logqueries logfacility backup_servers resolvfile
    log "Restoring cachesize" "debug"
    cachesize="$(uci_get "dhcp" "@dnsmasq[0]" "harpynet_cachesize")"
    if [ -z "$cachesize" ]; then
        uci_remove "dhcp" "@dnsmasq[0]" "cachesize"
        uci_set "dhcp" "@dnsmasq[0]" "cachesize" 150
    else
        uci_set "dhcp" "@dnsmasq[0]" "cachesize" "$cachesize"
        uci_remove "dhcp" "@dnsmasq[0]" "harpynet_cachesize"
    fi

    log "Restoring noresolv" "debug"
    noresolv="$(uci_get "dhcp" "@dnsmasq[0]" "harpynet_noresolv")"
    if [ -z "$noresolv" ]; then
        uci_set "dhcp" "@dnsmasq[0]" "noresolv" 0
    else
        uci_set "dhcp" "@dnsmasq[0]" "noresolv" "$noresolv"
        uci_remove "dhcp" "@dnsmasq[0]" "harpynet_noresolv"
    fi

    log "Restoring DNS query logging" "debug"
    logqueries="$(uci_get "dhcp" "@dnsmasq[0]" "harpynet_logqueries")"
    if [ -z "$logqueries" ]; then
        uci_remove "dhcp" "@dnsmasq[0]" "logqueries"
    else
        uci_set "dhcp" "@dnsmasq[0]" "logqueries" "$logqueries"
        uci_remove "dhcp" "@dnsmasq[0]" "harpynet_logqueries"
    fi

    logfacility="$(uci_get "dhcp" "@dnsmasq[0]" "harpynet_logfacility")"
    if [ -z "$logfacility" ]; then
        uci_remove "dhcp" "@dnsmasq[0]" "logfacility"
    else
        uci_set "dhcp" "@dnsmasq[0]" "logfacility" "$logfacility"
        uci_remove "dhcp" "@dnsmasq[0]" "harpynet_logfacility"
    fi

    log "Restoring DNS servers" "debug"
    uci_remove "dhcp" "@dnsmasq[0]" "server"
    resolvfile="/tmp/resolv.conf.d/resolv.conf.auto"
    backup_servers="$(uci_get "dhcp" "@dnsmasq[0]" "harpynet_server")"
    if [ -n "$backup_servers" ]; then
        for server in $backup_servers; do
            uci_add_list "dhcp" "@dnsmasq[0]" "server" "$server"
        done
        uci_remove "dhcp" "@dnsmasq[0]" "harpynet_server"
    elif file_exists "$resolvfile"; then
        log "Backup DNS servers not found, using default resolvfile" "debug"
        uci_set "dhcp" "@dnsmasq[0]" "resolvfile" "$resolvfile"
        if [ -n "$noresolv" ] && [ "$noresolv" -eq 1 ]; then
            log "Disabling noresolv option to use system resolvfile" "debug"
            uci_set "dhcp" "@dnsmasq[0]" "noresolv" 0
        fi
    else
        log "Backup DNS servers and default resolvfile not found, possible resolving issues" "warn"
    fi

    uci_commit "dhcp"

    dnsmasq_restart_quiet
}

add_cron_job() {
    local section="$1"
    ## Future: make a check so that it doesn't recreate many times
    local community_lists upstream_proxy_community_lists remote_domain_lists remote_subnet_lists update_interval
    config_get community_lists "$section" "community_lists"
    config_get upstream_proxy_community_lists "$section" "upstream_proxy_community_lists"
    config_get remote_domain_lists "$section" "remote_domain_lists"
    config_get remote_subnet_lists "$section" "remote_subnet_lists"
    config_get update_interval "settings" "update_interval"

    case "$update_interval" in
    "1h")
        cron_job="13 * * * * /usr/bin/harpynet list_update"
        ;;
    "3h")
        cron_job="13 */3 * * * /usr/bin/harpynet list_update"
        ;;
    "12h")
        cron_job="13 */12 * * * /usr/bin/harpynet list_update"
        ;;
    "1d")
        cron_job="13 9 * * * /usr/bin/harpynet list_update"
        ;;
    "3d")
        cron_job="13 9 */3 * * /usr/bin/harpynet list_update"
        ;;
    *)
        log "Invalid update_interval value: $update_interval"
        return
        ;;
    esac

    if [ -n "$community_lists" ] ||
        [ -n "$upstream_proxy_community_lists" ] ||
        [ -n "$remote_domain_lists" ] ||
        [ -n "$remote_subnet_lists" ]; then
        remove_cron_job
        crontab -l | {
            cat
            echo "$cron_job"
        } | crontab -
        log "The cron job has been created: $cron_job"
    fi
}

remove_cron_job() {
    (crontab -l |
        grep -v "/usr/bin/harpynet list_update" |
        grep -v "/usr/bin/harpynet subscription_update") | crontab -
    log "The cron job removed"
}

add_subscription_cron_job() {
    local subscription_update_interval subscription_cron_job
    config_get subscription_update_interval "settings" "subscription_update_interval" "12h"

    case "$subscription_update_interval" in
    "3h")
        subscription_cron_job="27 */3 * * * /usr/bin/harpynet subscription_update"
        ;;
    "12h")
        subscription_cron_job="27 */12 * * * /usr/bin/harpynet subscription_update"
        ;;
    "1d")
        subscription_cron_job="27 9 * * * /usr/bin/harpynet subscription_update"
        ;;
    "3d")
        subscription_cron_job="27 9 */3 * * /usr/bin/harpynet subscription_update"
        ;;
    *)
        log "Invalid subscription_update_interval value: $subscription_update_interval" "warn"
        return 1
        ;;
    esac

    (crontab -l | grep -v "/usr/bin/harpynet subscription_update"; echo "$subscription_cron_job") | crontab -
    log "The subscription cron job has been created: $subscription_cron_job"
}

subscription_update() {
    local lock_dir="/var/run/harpynet-subscription-update.lock"

    if ! mkdir "$lock_dir" 2>/dev/null; then
        log "Subscription update is already running, skipping" "warn"
        return 0
    fi

    trap "rmdir '$lock_dir' 2>/dev/null" EXIT INT TERM
    log "Starting scheduled subscription update"

    check_requirements
    migration
    config_foreach process_validate_service "section"

    SUBSCRIPTION_LINKS_CHANGED=0
    config_foreach check_subscription_links_changed_handler "section"

    if [ "$SUBSCRIPTION_LINKS_CHANGED" -eq 0 ]; then
        log "Subscription update completed successfully; subscription links are unchanged, keeping current VPN sessions"
        echo '{"success":true,"changed":false}'
        return 0
    fi

    log "Subscription links changed; restarting HarpyNet to apply them"
    if /usr/bin/harpynet restart >/dev/null 2>&1; then
        log "Subscription update completed successfully"
        echo '{"success":true,"changed":true}'
    else
        log "Subscription update failed; the previous working configuration was restored" "error"
        return 1
    fi
}

get_subscription_url_with_telegram_refresh() {
    local section="$1" subscription_url config_type router_token

    config_get subscription_url "$section" "subscription_url"
    [ -n "$subscription_url" ] && {
        printf '%s' "$subscription_url"
        return 0
    }

    config_get config_type "$section" "proxy_config_type"
    config_get router_token "$section" "telegram_router_token"
    if [ "$config_type" = "telegram" ] && [ -n "$router_token" ]; then
        routeropenwrt_subscription "$section" >/dev/null 2>&1 || true
        subscription_url="$(uci -q get "harpynet.$section.subscription_url")"
    fi

    printf '%s' "$subscription_url"
}

check_subscription_links_changed_handler() {
    local section="$1"
    local connection_type subscription_url subscription_proxy_links cache_file cached_proxy_links

    config_get connection_type "$section" "connection_type"
    case "$connection_type" in
    proxy | full_proxy | full_proxy_bypass_ru)
        ;;
    *)
        return 0
        ;;
    esac

    subscription_url="$(get_subscription_url_with_telegram_refresh "$section")"
    if [ -z "$subscription_url" ]; then
        subscription_proxy_links="$(get_cached_subscription_proxy_links "$section")"
        if [ -n "$subscription_proxy_links" ]; then
            log "Subscription URL is not available for '$section'; keeping the saved subscription cache" "warn"
            return 0
        fi
        log "Subscription URL is not set for '$section' and no saved subscription cache exists. Aborted." "fatal"
        exit 1
    fi

    subscription_proxy_links="$(download_subscription_proxy_links "$subscription_url" "$section")"
    if [ -z "$subscription_proxy_links" ]; then
        log "Subscription did not contain supported proxy links for '$section'; keeping cached subscription links" "warn"
        return 0
    fi

    cache_file="/var/run/harpynet/subscription-$section.links"
    if [ -f "$cache_file" ]; then
        cached_proxy_links="$(awk -F '\t' 'NF >= 2 { print $2 }' "$cache_file")"
    else
        cached_proxy_links=""
    fi

    if [ "$subscription_proxy_links" != "$cached_proxy_links" ]; then
        log "Subscription links changed for '$section'"
        SUBSCRIPTION_LINKS_CHANGED=1
    else
        log "Subscription links are unchanged for '$section'"
    fi
}

list_update() {
    echolog "рџ”„ Starting lists update..."

    if all_sections_vpn_disabled; then
        echolog "VPN is disabled for all sections; skipping lists update"
        return 0
    fi

    local nslookup_timeout=3
    local nslookup_attempts=10
    local curl_timeout=5
    local curl_attempts=10
    local curl_max_timeout=10
    local delay=3
    local i
    LIST_UPDATE_DIRECT_OK=0
    LIST_UPDATE_PROXY_OK=0

    # DNS Check
    for i in $(seq 1 $nslookup_attempts); do
        if nslookup -timeout=$nslookup_timeout openwrt.org > /dev/null 2>&1; then
            echolog "вњ… DNS check passed"
            break
        fi
        echolog "DNS is unavailable [$i/$nslookup_attempts]"
        sleep $delay
    done

    if [ "$i" -eq $nslookup_attempts ]; then
        echolog "вќЊ DNS check failed after $nslookup_attempts attempts"
        return 1
    fi

    # Github Check
    for i in $(seq 1 $curl_attempts); do
        local service_proxy_address
        service_proxy_address="$(get_service_proxy_address)"

        if [ -n "$service_proxy_address" ]; then
            if curl -s -x "http://$service_proxy_address" -m $curl_timeout https://github.com > /dev/null; then
                echolog "вњ… GitHub connection check passed (via proxy)"
                LIST_UPDATE_PROXY_OK=1
                break
            fi
        fi

            if curl -s -m $curl_timeout https://github.com > /dev/null; then
                echolog "вњ… GitHub connection check passed"
                LIST_UPDATE_DIRECT_OK=1
                break
            fi
        echolog "GitHub is unavailable [$i/$curl_attempts] (max-timeout=$curl_timeout)"
        if [ "$curl_timeout" -lt $curl_max_timeout ]; then
            curl_timeout=$((curl_timeout + 1))
        fi
        sleep $delay
    done

    if [ "$i" -eq $curl_attempts ]; then
        echolog "вќЊ GitHub connection check failed after $curl_attempts attempts"
        return 1
    fi

    echolog "рџ“Ґ Downloading and processing lists..."

    LIST_UPDATE_FAILED=0

    config_foreach import_community_subnet_lists "section"
    config_foreach import_domains_from_remote_domain_lists "section"
    config_foreach import_subnets_from_remote_subnet_lists "section"

    if [ "$LIST_UPDATE_FAILED" -eq 0 ]; then
        echolog "вњ… Lists update completed successfully"
    else
        echolog "вќЊ Lists update failed"
    fi
    [ "$LIST_UPDATE_FAILED" -ne 0 ] && return 1
    return 0
}

get_list_cache_file() {
    local url="$1"
    local cache_key

    mkdir -p "$LIST_CACHE_DIR"
    if command -v md5sum >/dev/null 2>&1; then
        cache_key="$(printf '%s' "$url" | md5sum | awk '{print $1}')"
    else
        cache_key="$(printf '%s' "$url" | cksum | awk '{print $1}')"
    fi

    echo "$LIST_CACHE_DIR/$cache_key.list"
}

download_list_to_file() {
    local url="$1"
    local filepath="$2"
    local http_proxy_address="$3"
    local cache_file tmpfile legacy_cache_file legacy_cache_list_file

    if [ "$HN_STARTUP_LIST_UPDATE" = "1" ]; then
        download_list_to_file_fast "$url" "$filepath" "$http_proxy_address"
        return $?
    fi

    cache_file="$(get_list_cache_file "$url")"
    legacy_cache_file="$(printf '%s' "$cache_file" | sed "s#^$LIST_CACHE_DIR#/etc/harpynet/list-update-cache#")"
    legacy_cache_list_file="${legacy_cache_file%.list}.lst"
    tmpfile="$(mktemp)"

    if { [ "$LIST_UPDATE_DIRECT_OK" = "1" ] || [ "$LIST_UPDATE_PROXY_OK" != "1" ]; } &&
        download_to_file "$url" "$tmpfile" "" && [ -s "$tmpfile" ]; then
        cp "$tmpfile" "$filepath"
        cp "$tmpfile" "$cache_file"
        rm -f "$tmpfile"
        return 0
    fi

    if download_to_file "$url" "$tmpfile" "$http_proxy_address" && [ -s "$tmpfile" ]; then
        cp "$tmpfile" "$filepath"
        cp "$tmpfile" "$cache_file"
        rm -f "$tmpfile"
        return 0
    fi

    if [ -n "$http_proxy_address" ] &&
        download_to_file "$url" "$tmpfile" "" && [ -s "$tmpfile" ]; then
        log "Download $url via proxy failed, direct download succeeded" "warn"
        cp "$tmpfile" "$filepath"
        cp "$tmpfile" "$cache_file"
        rm -f "$tmpfile"
        return 0
    fi

    if [ -s "$cache_file" ]; then
        log "Download $url failed, using cached list $cache_file" "warn"
        cp "$cache_file" "$filepath"
        rm -f "$tmpfile"
        return 0
    fi

    if [ -s "$legacy_cache_file" ]; then
        log "Download $url failed, using cached list $legacy_cache_file" "warn"
        cp "$legacy_cache_file" "$filepath"
        cp "$legacy_cache_file" "$cache_file"
        rm -f "$tmpfile"
        return 0
    fi

    if [ -s "$legacy_cache_list_file" ]; then
        log "Download $url failed, using cached list $legacy_cache_list_file" "warn"
        cp "$legacy_cache_list_file" "$filepath"
        cp "$legacy_cache_list_file" "$cache_file"
        rm -f "$tmpfile"
        return 0
    fi

    rm -f "$tmpfile"
    return 1
}

download_list_to_file_fast() {
    local url="$1"
    local filepath="$2"
    local http_proxy_address="$3"
    local cache_file primary_cache_file tmpfile legacy_cache_file legacy_cache_list_file

    primary_cache_file="$(get_list_cache_file "$url")"
    legacy_cache_file="$(printf '%s' "$primary_cache_file" | sed "s#^$LIST_CACHE_DIR#/etc/harpynet/list-update-cache#")"
    legacy_cache_list_file="${legacy_cache_file%.list}.lst"
    tmpfile="$(mktemp)"

    for cache_file in "$primary_cache_file" "$legacy_cache_file" "$legacy_cache_list_file"; do
        if [ -s "$cache_file" ]; then
            cp "$cache_file" "$filepath"
            rm -f "$tmpfile"
            return 0
        fi
    done

    if download_to_file "$url" "$tmpfile" "" 1 1 && [ -s "$tmpfile" ]; then
        cp "$tmpfile" "$filepath"
        cp "$tmpfile" "$primary_cache_file"
        rm -f "$tmpfile"
        return 0
    fi

    if [ -n "$http_proxy_address" ] &&
        download_to_file "$url" "$tmpfile" "$http_proxy_address" 1 1 && [ -s "$tmpfile" ]; then
        cp "$tmpfile" "$filepath"
        cp "$tmpfile" "$primary_cache_file"
        rm -f "$tmpfile"
        return 0
    fi

    rm -f "$tmpfile"
    return 1
}

get_srs_cache_file() {
    local url="$1"
    local cache_key basename

    mkdir -p "$SRS_CACHE_DIR"
    basename="$(url_get_basename "$url")"
    cache_key="$(printf '%s' "$url" | md5sum | awk '{print $1}')"
    echo "$SRS_CACHE_DIR/${cache_key}-${basename}"
}

validate_binary_ruleset() {
    local filepath="$1"
    local tmpfile

    [ -s "$filepath" ] || return 1
    tmpfile="$(mktemp)"
    if decompile_binary_ruleset "$filepath" "$tmpfile" >/dev/null 2>&1 && [ -s "$tmpfile" ]; then
        rm -f "$tmpfile"
        return 0
    fi

    rm -f "$tmpfile"
    return 1
}

compile_community_domain_ruleset_fallback() {
    local service="$1"
    local cache_file="$2"
    local source_url list_tmp domains_tmp json_tmp srs_tmp http_proxy_address

    source_url="$(get_community_service_domain_url "$service")" || return 1
    [ -n "$source_url" ] || return 1

    list_tmp="$(mktemp)"
    domains_tmp="$(mktemp)"
    json_tmp="$(mktemp)"
    srs_tmp="$(mktemp)"
    http_proxy_address="$(get_service_proxy_address)"

    if ! download_to_file "$source_url" "$list_tmp" "" 2 2 || [ ! -s "$list_tmp" ]; then
        if [ -z "$http_proxy_address" ] ||
            ! download_to_file "$source_url" "$list_tmp" "$http_proxy_address" 2 2 ||
            [ ! -s "$list_tmp" ]; then
            rm -f "$list_tmp" "$domains_tmp" "$json_tmp" "$srs_tmp"
            return 1
        fi
    fi

    convert_crlf_to_lf "$list_tmp"
    grep -vE '^[[:space:]]*(#|//|$)' "$list_tmp" |
        sed 's/[[:space:]]*$//' |
        sort -u > "$domains_tmp"
    rm -f "$srs_tmp"

    if [ ! -s "$domains_tmp" ] ||
        ! jq -Rsc '
            split("\n")
            | map(select(length > 0))
            | {version: 3, rules: [{domain_suffix: .}]}
        ' "$domains_tmp" > "$json_tmp" ||
        ! sing-box rule-set compile "$json_tmp" -o "$srs_tmp" >/dev/null 2>&1 ||
        ! validate_binary_ruleset "$srs_tmp"; then
        rm -f "$list_tmp" "$domains_tmp" "$json_tmp" "$srs_tmp"
        return 1
    fi

    mv "$srs_tmp" "$cache_file"
    chmod 600 "$cache_file"
    rm -f "$list_tmp" "$domains_tmp" "$json_tmp"
    log "GitHub release asset unavailable; compiled $service ruleset locally from $source_url" "warn"
    echo "$cache_file"
}

cache_remote_binary_ruleset() {
    local url="$1"
    local fallback_service="$2"
    local cache_file tmpfile http_proxy_address cache_valid=0

    cache_file="$(get_srs_cache_file "$url")"
    if validate_binary_ruleset "$cache_file"; then
        cache_valid=1
        if find "$cache_file" -mtime -1 -print 2>/dev/null | grep -q .; then
            echo "$cache_file"
            return 0
        fi
    fi

    tmpfile="$(mktemp)"
    http_proxy_address="$(get_service_proxy_address)"

    if download_to_file "$url" "$tmpfile" "" 2 2 &&
        validate_binary_ruleset "$tmpfile"; then
        mv "$tmpfile" "$cache_file"
        echo "$cache_file"
        return 0
    fi

    if [ -n "$http_proxy_address" ] &&
        download_to_file "$url" "$tmpfile" "$http_proxy_address" 2 2 &&
        validate_binary_ruleset "$tmpfile"; then
        mv "$tmpfile" "$cache_file"
        echo "$cache_file"
        return 0
    fi

    rm -f "$tmpfile"
    if [ "$cache_valid" -eq 1 ]; then
        log "Unable to refresh $url; using the last validated cached ruleset" "warn"
        echo "$cache_file"
        return 0
    fi

    if [ -n "$fallback_service" ] &&
        compile_community_domain_ruleset_fallback "$fallback_service" "$cache_file"; then
        return 0
    fi

    log "Unable to download or validate binary ruleset $url and no valid cache is available" "error"
    return 1
}

add_cached_binary_ruleset() {
    local ruleset_tag="$1"
    local url="$2"
    local fallback_service="$3"
    local ruleset_path

    # The same service may be present in both the normal VPN list and the
    # higher-priority upstream-proxy list. Keep a single rule-set object and
    # let route ordering decide the winner.
    if printf '%s' "$config" | jq -e --arg tag "$ruleset_tag" '.route.rule_set[]? | select(.tag == $tag)' >/dev/null 2>&1; then
        return 0
    fi

    ruleset_path="$(cache_remote_binary_ruleset "$url" "$fallback_service")" || return 1
    config=$(sing_box_cm_add_local_ruleset "$config" "$ruleset_tag" "binary" "$ruleset_path")
}

list_update_report_service_label() {
    local service="$1"

    case "$service" in
    russia_inside) echo "Russia inside" ;;
    russia_outside) echo "Russia outside" ;;
    ukraine_inside) echo "Ukraine inside" ;;
    google_ai) echo "Google AI" ;;
    google_play) echo "Google Play" ;;
    ai_full) echo "AI Full" ;;
    chatgpt) echo "ChatGPT" ;;
    claude) echo "Claude" ;;
    digitalocean) echo "DigitalOcean" ;;
    cloudfront) echo "CloudFront" ;;
    cloudflare) echo "Cloudflare" ;;
    *) printf '%s' "$service" | awk '{ gsub(/_/, " "); print toupper(substr($0,1,1)) substr($0,2) }' ;;
    esac
}

get_community_service_domain_url() {
    local service="$1"

    case "$service" in
    russia_inside) echo "$GITHUB_RAW_URL/Russia/inside-raw.lst" ;;
    russia_outside) echo "$GITHUB_RAW_URL/Russia/outside-raw.lst" ;;
    ukraine_inside) echo "$GITHUB_RAW_URL/Ukraine/inside-raw.lst" ;;
    geoblock) echo "$GITHUB_RAW_URL/Categories/geoblock.lst" ;;
    block) echo "$GITHUB_RAW_URL/Categories/block.lst" ;;
    porn) echo "$GITHUB_RAW_URL/Categories/porn.lst" ;;
    news) echo "$GITHUB_RAW_URL/Categories/news.lst" ;;
    anime) echo "$GITHUB_RAW_URL/Categories/anime.lst" ;;
    youtube) echo "$GITHUB_RAW_URL/Services/youtube.lst" ;;
    hdrezka) echo "$GITHUB_RAW_URL/Services/hdrezka.lst" ;;
    tiktok) echo "$GITHUB_RAW_URL/Services/tiktok.lst" ;;
    google_ai) echo "$GITHUB_RAW_URL/Services/google_ai.lst" ;;
    google_play) echo "$GITHUB_RAW_URL/Services/google_play.lst" ;;
    ai_full) echo "$GITHUB_RAW_URL/Services/ai_full.lst" ;;
    chatgpt) echo "$GITHUB_RAW_URL/Services/chatgpt.lst" ;;
    claude) echo "$GITHUB_RAW_URL/Services/claude.lst" ;;
    hodca) echo "$GITHUB_RAW_URL/Categories/hodca.lst" ;;
    discord) echo "$GITHUB_RAW_URL/Services/discord.lst" ;;
    meta) echo "$GITHUB_RAW_URL/Services/meta.lst" ;;
    twitter) echo "$GITHUB_RAW_URL/Services/twitter.lst" ;;
    telegram) echo "$GITHUB_RAW_URL/Services/telegram.lst" ;;
    roblox) echo "$GITHUB_RAW_URL/Services/roblox.lst" ;;
    *) return 1 ;;
    esac
}

list_update_report_add_url() {
    local label="$1"
    local kind="$2"
    local url="$3"
    local cache_dir="$4"
    local http_proxy_address tmpfile newfile oldfile added_file removed_file cache_key
    local first_seen=0 added_count=0 removed_count=0 status="ok"

    [ -z "$url" ] && return 0

    tmpfile="$(mktemp)"
    newfile="$(mktemp)"
    added_file="$(mktemp)"
    removed_file="$(mktemp)"
    http_proxy_address="$(get_service_proxy_address)"

    if command -v md5sum >/dev/null 2>&1; then
        cache_key="$(printf '%s' "$url" | md5sum | awk '{print $1}')"
    else
        cache_key="$(printf '%s' "$url" | cksum | awk '{print $1}')"
    fi
    oldfile="$cache_dir/$cache_key.lst"

    if ! download_to_file "$url" "$tmpfile" "$http_proxy_address" >/dev/null 2>&1 || [ ! -s "$tmpfile" ]; then
        status="download_failed"
        : > "$added_file"
        : > "$removed_file"
    else
        convert_crlf_to_lf "$tmpfile"
        grep -vE '^[[:space:]]*(#|//|$)' "$tmpfile" | sed 's/[[:space:]]*$//' | sort -u > "$newfile"

        if [ -f "$oldfile" ]; then
            grep -Fvx -f "$oldfile" "$newfile" | head -n 80 > "$added_file"
            grep -Fvx -f "$newfile" "$oldfile" | head -n 80 > "$removed_file"
        else
            first_seen=1
            : > "$added_file"
            : > "$removed_file"
        fi

        cp "$newfile" "$oldfile"
    fi

    added_count="$(wc -l < "$added_file" | tr -d ' ')"
    removed_count="$(wc -l < "$removed_file" | tr -d ' ')"

    jq -Rn \
        --arg service "$label" \
        --arg type "$kind" \
        --arg url "$url" \
        --arg status "$status" \
        --argjson first_seen "$first_seen" \
        --argjson added_count "$added_count" \
        --argjson removed_count "$removed_count" \
        --rawfile added "$added_file" \
        --rawfile removed "$removed_file" \
        '{
            service: $service,
            type: $type,
            url: $url,
            status: $status,
            first_seen: ($first_seen == 1),
            added_count: $added_count,
            removed_count: $removed_count,
            added: ($added | split("\n") | map(select(length > 0))),
            removed: ($removed | split("\n") | map(select(length > 0)))
        }' >> "$LIST_UPDATE_REPORT_ITEMS"

    rm -f "$tmpfile" "$newfile" "$added_file" "$removed_file"
}

list_update_report_community_handler() {
    local service="$1"
    local cache_dir="$2"
    local label domain_url subnet_url

    label="$(list_update_report_service_label "$service")"
    domain_url="$(get_community_service_domain_url "$service")" || domain_url=""
    subnet_url="$(get_community_service_subnet_url "$service")" || subnet_url=""

    [ -n "$domain_url" ] && list_update_report_add_url "$label" "domains" "$domain_url" "$cache_dir"
    [ -n "$subnet_url" ] && list_update_report_add_url "$label" "IPv4" "$subnet_url" "$cache_dir"
}

list_update_report_remote_domain_handler() {
    local url="$1"
    local cache_dir="$2"

    list_update_report_add_url "Remote domains" "domains" "$url" "$cache_dir"
}

list_update_report_remote_subnet_handler() {
    local url="$1"
    local cache_dir="$2"

    list_update_report_add_url "Remote subnets" "IPv4" "$url" "$cache_dir"
}

list_update_report_section_handler() {
    local section="$1"
    local cache_dir="$2"
    local community_lists upstream_proxy_community_lists remote_domain_lists remote_subnet_lists

    config_get community_lists "$section" "community_lists"
    config_get upstream_proxy_community_lists "$section" "upstream_proxy_community_lists"
    config_get remote_domain_lists "$section" "remote_domain_lists"
    config_get remote_subnet_lists "$section" "remote_subnet_lists"

    [ -n "$community_lists" ] &&
        config_list_foreach "$section" "community_lists" list_update_report_community_handler "$cache_dir"
    [ -n "$upstream_proxy_community_lists" ] &&
        config_list_foreach "$section" "upstream_proxy_community_lists" list_update_report_community_handler "$cache_dir"
    [ -n "$remote_domain_lists" ] &&
        config_list_foreach "$section" "remote_domain_lists" list_update_report_remote_domain_handler "$cache_dir"
    [ -n "$remote_subnet_lists" ] &&
        config_list_foreach "$section" "remote_subnet_lists" list_update_report_remote_subnet_handler "$cache_dir"
}

list_update_report_run() {
    local cache_dir="/etc/harpynet/list-update-cache"
    local last_report="$cache_dir/last-report.json"
    local output_file result_file status changed_count first_seen_count failed_count

    mkdir -p "$cache_dir"
    LIST_UPDATE_REPORT_ITEMS="$(mktemp)"
    output_file="$(mktemp)"
    result_file="$(mktemp)"
    : > "$LIST_UPDATE_REPORT_ITEMS"

    config_foreach list_update_report_section_handler "section" "$cache_dir"

    if list_update > "$output_file" 2>&1; then
        status=0
    else
        status=$?
    fi

    changed_count="$(jq -s '[.[] | select((.added_count // 0) > 0 or (.removed_count // 0) > 0)] | length' "$LIST_UPDATE_REPORT_ITEMS")"
    first_seen_count="$(jq -s '[.[] | select(.first_seen == true)] | length' "$LIST_UPDATE_REPORT_ITEMS")"
    failed_count="$(jq -s '[.[] | select(.status != "ok")] | length' "$LIST_UPDATE_REPORT_ITEMS")"

    if [ -f "$last_report" ]; then
        jq -s \
            --argjson success "$([ "$status" -eq 0 ] && echo true || echo false)" \
            --argjson changed "$([ "$changed_count" -gt 0 ] && echo true || echo false)" \
            --argjson changed_count "$changed_count" \
            --argjson first_seen_count "$first_seen_count" \
            --argjson failed_count "$failed_count" \
            --rawfile log "$output_file" \
            --slurpfile previous "$last_report" \
            '{
                success: $success,
                changed: $changed,
                changed_count: $changed_count,
                first_seen_count: $first_seen_count,
                failed_count: $failed_count,
                lists: .,
                previous: ($previous[0] // null),
                log: $log
            }' "$LIST_UPDATE_REPORT_ITEMS" > "$result_file"
    else
        jq -s \
            --argjson success "$([ "$status" -eq 0 ] && echo true || echo false)" \
            --argjson changed "$([ "$changed_count" -gt 0 ] && echo true || echo false)" \
            --argjson changed_count "$changed_count" \
            --argjson first_seen_count "$first_seen_count" \
            --argjson failed_count "$failed_count" \
            --rawfile log "$output_file" \
            '{
                success: $success,
                changed: $changed,
                changed_count: $changed_count,
                first_seen_count: $first_seen_count,
                failed_count: $failed_count,
                lists: .,
                previous: null,
                log: $log
            }' "$LIST_UPDATE_REPORT_ITEMS" > "$result_file"
    fi

    if [ "$changed_count" -gt 0 ] || [ ! -f "$last_report" ]; then
        cp "$result_file" "$last_report"
    fi

    cat "$result_file"
    rm -f "$LIST_UPDATE_REPORT_ITEMS" "$output_file" "$result_file"
    return "$status"
}

list_update_report_start() {
    local state_file="/tmp/harpynet-list-update-report.json"
    local pid_file="/var/run/harpynet_list_update_report.pid"

    if [ -f "$pid_file" ]; then
        local pid
        pid="$(cat "$pid_file" 2>/dev/null)"
        if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
            jq -n '{success:true,running:true}'
            return 0
        fi
    fi

    jq -n '{success:true,running:true,message:"started"}' > "$state_file"
    (
        /usr/bin/harpynet list_update_report_run > "$state_file.tmp" 2>/tmp/harpynet-list-update-report.err
        status=$?
        if [ -s "$state_file.tmp" ]; then
            mv "$state_file.tmp" "$state_file"
        else
            jq -n --arg error "$(cat /tmp/harpynet-list-update-report.err 2>/dev/null)" '{success:false,running:false,error:$error}' > "$state_file"
        fi
        rm -f "$pid_file" "$state_file.tmp"
        exit "$status"
    ) >/dev/null 2>&1 </dev/null &
    echo $! > "$pid_file"

    jq -n '{success:true,running:true,message:"started"}'
}

list_update_report_status() {
    local state_file="/tmp/harpynet-list-update-report.json"
    local pid_file="/var/run/harpynet_list_update_report.pid"

    if [ -f "$pid_file" ]; then
        local pid
        pid="$(cat "$pid_file" 2>/dev/null)"
        if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
            jq -n '{success:true,running:true}'
            return 0
        fi
    fi

    if [ -s "$state_file" ]; then
        cat "$state_file"
    else
        jq -n '{success:false,running:false,error:"Нет результата обновления"}'
    fi
}

list_update_report() {
    list_update_report_run
}

# sing-box funcs
sing_box_configure_service() {
    local sing_box_enabled sing_box_user sing_box_config_path sing_box_conffile
    sing_box_enabled="$(uci_get "sing-box" "main" "enabled")"
    sing_box_user="$(uci_get "sing-box" "main" "user")"

    if [ "$sing_box_enabled" -ne 1 ]; then
        uci_set "sing-box" "main" "enabled" 1
        uci_commit "sing-box"
        log "sing-box service has been enabled"
    fi

    if [ "$sing_box_user" != "root" ]; then
        uci_set "sing-box" "main" "user" "root"
        uci_commit "sing-box"
        log "sing-box service user has been changed to root"
    fi

    config_get sing_box_config_path "settings" "config_path"
    sing_box_conffile="$(uci_get "sing-box" "main" "conffile")"
    log "sing-box config path: $sing_box_config_path" "debug"
    log "sing-box service conffile: $sing_box_conffile" "debug"
    if [ "$sing_box_conffile" != "$sing_box_config_path" ]; then
        uci_set "sing-box" "main" "conffile" "$sing_box_config_path"
        uci_commit "sing-box"
        log "Configuration file path has been set to $sing_box_config_path"
    fi

    [ -f /etc/rc.d/S99sing-box ] && log "Disable sing-box" && /etc/init.d/sing-box disable
}

sing_box_init_config() {
    local config='{"log":{},"dns":{},"ntp":{},"certificate":{},"endpoints":[],"inbounds":[],"outbounds":[],"route":{},"services":[],"experimental":{}}'

    sing_box_configure_log
    sing_box_configure_inbounds
    sing_box_configure_outbounds
    sing_box_configure_dns
    sing_box_configure_route
    sing_box_configure_experimental
    sing_box_additional_inbounds
    sing_box_save_config
}

sing_box_configure_log() {
    log "Configure the log section of a sing-box JSON configuration"

    local log_level
    config_get log_level "settings" "log_level" "warn"
    config=$(sing_box_cm_configure_log "$config" false "$log_level" false)
}

sing_box_configure_inbounds() {
    log "Configure the inbounds section of a sing-box JSON configuration"

    config=$(
        sing_box_cm_add_tproxy_inbound \
            "$config" "$SB_TPROXY_INBOUND_TAG" "$SB_TPROXY_INBOUND_ADDRESS" "$SB_TPROXY_INBOUND_PORT" true true
    )
    config=$(
        sing_box_cm_add_direct_inbound "$config" "$SB_DNS_INBOUND_TAG" "$SB_DNS_INBOUND_ADDRESS" "$SB_DNS_INBOUND_PORT"
    )
}

sing_box_configure_outbounds() {
    log "Configure the outbounds section of a sing-box JSON configuration"

    config=$(sing_box_cm_add_direct_outbound "$config" "$SB_DIRECT_OUTBOUND_TAG")

    config_foreach configure_outbound_handler "section"
    config_foreach configure_upstream_proxy_outbound_handler "section"
}

get_upstream_proxy_outbound_tag() {
    echo "$1-upstream-proxy-out"
}

get_active_upstream_proxy_profile() {
    local section="$1" active profile_type profile_parent
    config_get active "$section" "upstream_proxy_active_profile"
    if [ -n "$active" ]; then
        config_get profile_type "$active" "TYPE"
        config_get profile_parent "$active" "parent"
        if [ "$profile_type" = "upstream_proxy_profile" ] && [ "$profile_parent" = "$section" ]; then
            printf '%s\n' "$active"
            return 0
        fi
    fi
    printf '%s\n' "$section"
}

upstream_proxy_profile_is_ready() {
    local section="$1" profile_section server port

    profile_section="$(get_active_upstream_proxy_profile "$section")"
    config_get server "$profile_section" "server" ""
    config_get port "$profile_section" "port" ""
    if [ "$profile_section" = "$section" ]; then
        config_get server "$section" "upstream_proxy_server"
        config_get port "$section" "upstream_proxy_port"
    fi

    [ -n "$server" ] || return 1
    case "$port" in ''|*[!0-9]*) return 1 ;; esac
    [ "$port" -ge 1 ] 2>/dev/null && [ "$port" -le 65535 ] 2>/dev/null
}

configure_upstream_proxy_outbound_handler() {
    local section="$1"
    local enabled connection_type protocol server port username password tls_server_name tag profile_section

    config_get_bool enabled "$section" "upstream_proxy_enabled" 0
    [ "$enabled" -eq 1 ] || return 0
    config_get connection_type "$section" "connection_type"
    [ "$connection_type" != "exclusion" ] || return 0
    if ! upstream_proxy_profile_is_ready "$section"; then
        log "Upstream proxy for '$section' is enabled but not configured yet; keeping it inactive" "warn"
        return 0
    fi

    profile_section="$(get_active_upstream_proxy_profile "$section")"
    config_get protocol "$profile_section" "protocol" ""
    config_get server "$profile_section" "server" ""
    config_get port "$profile_section" "port" ""
    config_get username "$profile_section" "username" ""
    config_get password "$profile_section" "password" ""
    config_get tls_server_name "$profile_section" "tls_server_name" ""
    if [ "$profile_section" = "$section" ]; then
        config_get protocol "$section" "upstream_proxy_protocol" "socks5"
        config_get server "$section" "upstream_proxy_server"
        config_get port "$section" "upstream_proxy_port"
        config_get username "$section" "upstream_proxy_username"
        config_get password "$section" "upstream_proxy_password"
        config_get tls_server_name "$section" "upstream_proxy_tls_server_name"
    fi
    tag="$(get_upstream_proxy_outbound_tag "$section")"

    case "$protocol" in
    socks5)
        config="$(sing_box_cm_add_socks_outbound "$config" "$tag" "$server" "$port" "5" \
            "$username" "$password" "" "")"
        ;;
    http)
        config="$(sing_box_cm_add_http_outbound "$config" "$tag" "$server" "$port" \
            "$username" "$password" "0" "")"
        ;;
    https)
        [ -n "$tls_server_name" ] || tls_server_name="$server"
        config="$(sing_box_cm_add_http_outbound "$config" "$tag" "$server" "$port" \
            "$username" "$password" "1" "$tls_server_name")"
        ;;
    *)
        log "Unsupported upstream proxy protocol '$protocol' for '$section'" "fatal"
        exit 1
        ;;
    esac

    log "Configured $protocol upstream proxy for '$section'" "info"
}

save_subscription_metadata() {
    local section="$1"
    local headers_file="$2"
    local metadata_file="/var/run/harpynet/subscription-$section.meta.json"
    local title userinfo web_page_url support_url announce announce_url refill_date
    local upload=0 download=0 total=0 expire=0 used=0 remaining=0

    [ -f "$headers_file" ] || return 0
    echo "$section" | grep -Eq '^[A-Za-z0-9_-]+$' || return 0

    subscription_header() {
        local header_name="$1"
        awk -v name="$header_name" '
            {
                line = $0
                sub(/\r$/, "", line)
                prefix = substr(line, 1, length(name) + 1)
                if (tolower(prefix) == tolower(name ":")) {
                    sub(/^[^:]+:[[:space:]]*/, "", line)
                    value = line
                }
            }
            END { print value }
        ' "$headers_file"
    }

    title="$(subscription_header "profile-title")"
    if [ -n "$title" ]; then
        local decoded_title
        decoded_title="$(printf '%s' "${title#base64:}" | base64 -d 2>/dev/null)"
        [ -n "$decoded_title" ] && title="$decoded_title"
    fi
    userinfo="$(subscription_header "subscription-userinfo")"
    web_page_url="$(subscription_header "profile-web-page-url")"
    support_url="$(subscription_header "support-url")"
    announce="$(subscription_header "announce")"
    if [ -n "$announce" ]; then
        local decoded_announce
        decoded_announce="$(printf '%s' "${announce#base64:}" | base64 -d 2>/dev/null)"
        [ -n "$decoded_announce" ] && announce="$decoded_announce"
    fi
    announce_url="$(subscription_header "announce-url")"
    refill_date="$(subscription_header "subscription-refill-date")"

    local item key value
    local old_ifs="$IFS"
    IFS=';'
    for item in $userinfo; do
        key="$(printf '%s' "$item" | cut -d= -f1 | tr -d ' \t\r\n' | tr 'A-Z' 'a-z')"
        value="$(printf '%s' "$item" | cut -d= -f2- | tr -d ' \t\r\n')"
        case "$key" in
        upload) upload="${value:-0}" ;;
        download) download="${value:-0}" ;;
        total) total="${value:-0}" ;;
        expire) expire="${value:-0}" ;;
        esac
    done
    IFS="$old_ifs"

    used=$((upload + download))
    if [ "$total" -gt "$used" ] 2>/dev/null; then
        remaining=$((total - used))
    fi

    mkdir -p /var/run/harpynet
    jq -n \
        --arg title "$title" \
        --arg webPageUrl "$web_page_url" \
        --arg supportUrl "$support_url" \
        --arg announce "$announce" \
        --arg announceUrl "$announce_url" \
        --argjson upload "${upload:-0}" \
        --argjson download "${download:-0}" \
        --argjson used "${used:-0}" \
        --argjson total "${total:-0}" \
        --argjson remaining "${remaining:-0}" \
        --argjson expire "${expire:-0}" \
        --argjson refillDate "${refill_date:-0}" '
        {
            version: 1,
            title: $title,
            traffic: {
                upload: $upload,
                download: $download,
                used: $used,
                total: $total,
                remaining: $remaining,
                isUnlimited: ($total <= 0)
            },
            expire: $expire,
            refillDate: $refillDate,
            webPageUrl: $webPageUrl,
            supportUrl: $supportUrl,
            announce: $announce,
            announceUrl: $announceUrl
        }
        | with_entries(select(.value != "" and .value != 0))
        | if (.traffic.total == 0 and .traffic.used == 0) then del(.traffic) else . end
    ' > "$metadata_file"
}

download_subscription_proxy_links() {
    local url="$1"
    local section="$2"
    local attempt="${3:-1}"
    local tmpfile decoded_tmpfile headers_file http_proxy_address user_agent hwid device_model os_version links

    tmpfile=$(mktemp)
    decoded_tmpfile=$(mktemp)
    headers_file=$(mktemp)
    http_proxy_address="$(get_service_proxy_address)"
    user_agent="$(get_harpynet_user_agent)"
    hwid="$(get_device_hwid)"
    device_model="$(get_device_model)"
    os_version="$(sed -n "s/^DISTRIB_RELEASE='\([^']*\)'.*/\1/p" /etc/openwrt_release 2>/dev/null)"

    local download_result=1
    if command -v curl >/dev/null 2>&1; then
        local proxy_args=""
        [ -n "$http_proxy_address" ] && proxy_args="-x http://$http_proxy_address"
        curl -s -L --connect-timeout 5 --max-time 25 $proxy_args \
            -D "$headers_file" \
            -H "User-Agent: $user_agent" \
            -H "x-hwid: $hwid" \
            -H "x-device-os: OpenWrt" \
            -H "x-ver-os: $os_version" \
            -H "x-device-model: $device_model" \
            -o "$tmpfile" "$url" && download_result=0
    else
        download_to_file "$url" "$tmpfile" "$http_proxy_address" 3 2 "$user_agent" "$hwid" "$device_model" "$os_version" "$headers_file" &&
            download_result=0
    fi
    if [ "$download_result" -ne 0 ] || [ ! -s "$tmpfile" ]; then
        rm -f "$tmpfile" "$decoded_tmpfile" "$headers_file"
        if [ "$attempt" -lt 3 ]; then
            log "Subscription download failed for '$section'; retrying [$attempt/3]" "warn"
            sleep $((attempt * 2))
            download_subscription_proxy_links "$url" "$section" $((attempt + 1))
            return $?
        fi
        return 1
    fi
    save_subscription_metadata "$section" "$headers_file"

    convert_crlf_to_lf "$tmpfile"
    if base64 -d "$tmpfile" > "$decoded_tmpfile" 2>/dev/null && [ -s "$decoded_tmpfile" ]; then
        convert_crlf_to_lf "$decoded_tmpfile"
        cat "$decoded_tmpfile" >> "$tmpfile"
    fi

    links="$(
        grep -Eo '(ss|ssr|vmess|vless|trojan|hysteria2|hy2|tuic|socks)://[^[:space:]\"'"'"'<>]+' "$tmpfile" |
            sed 's/[,;)]*$//' |
            awk '!seen[$0]++'
    )"

    if [ -z "$links" ] && grep -q '^proxies:' "$tmpfile"; then
        links="$(
            awk '
            function trim(v) {
                sub(/^[[:space:]]+/, "", v)
                sub(/[[:space:]]+$/, "", v)
                return v
            }
            function value(line) {
                sub(/^[^:]+:[[:space:]]*/, "", line)
                gsub(/^'\''|'\''$/, "", line)
                gsub(/^"|"$/, "", line)
                return trim(line)
            }
            function urlencode(value,    i, c, out) {
                out = ""
                for (i = 1; i <= length(value); i++) {
                    c = substr(value, i, 1)
                    if (c ~ /^[A-Za-z0-9._~-]$/) {
                        out = out c
                    } else if (c == " ") {
                        out = out "%20"
                    } else if (c == "%") {
                        out = out "%25"
                    } else if (c == "#") {
                        out = out "%23"
                    } else {
                        out = out c
                    }
                }
                return out
            }
            function add_param(key, val) {
                if (val == "") return
                query = query sep key "=" val
                sep = "&"
            }
            function flush() {
                if (type == "vless" && uuid != "" && server != "" && port != "") {
                    query = ""
                    sep = "?"
                    add_param("type", network == "" ? "tcp" : network)
                    add_param("security", public_key != "" ? "reality" : (tls == "true" ? "tls" : "none"))
                    add_param("sni", servername)
                    add_param("fp", fingerprint)
                    add_param("pbk", public_key)
                    add_param("sid", short_id)
                    add_param("flow", flow)
                    add_param("packetEncoding", packet_encoding)
                    print "vless://" uuid "@" server ":" port query "#" urlencode(name)
                }
                name = type = server = port = uuid = network = packet_encoding = flow = tls = servername = public_key = short_id = fingerprint = ""
            }
            /^proxies:/ { in_proxies = 1; next }
            /^proxy-groups:/ { flush(); in_proxies = 0 }
            !in_proxies { next }
            /^[[:space:]]*-[[:space:]]/ { flush() }
            /^[[:space:]]*-[[:space:]]*name:/ { name = value($0); next }
            /^[[:space:]]*name:/ { name = value($0); next }
            /^[[:space:]]*type:/ { type = value($0); next }
            /^[[:space:]]*server:/ { server = value($0); next }
            /^[[:space:]]*port:/ { port = value($0); next }
            /^[[:space:]]*uuid:/ { uuid = value($0); next }
            /^[[:space:]]*network:/ { network = value($0); next }
            /^[[:space:]]*packet-encoding:/ { packet_encoding = value($0); next }
            /^[[:space:]]*flow:/ { flow = value($0); next }
            /^[[:space:]]*tls:/ { tls = value($0); next }
            /^[[:space:]]*servername:/ { servername = value($0); next }
            /^[[:space:]]*public-key:/ { public_key = value($0); next }
            /^[[:space:]]*short-id:/ { short_id = value($0); next }
            /^[[:space:]]*client-fingerprint:/ { fingerprint = value($0); next }
            END { flush() }
            ' "$tmpfile" | awk '!seen[$0]++'
        )"
    fi

    rm -f "$tmpfile" "$decoded_tmpfile" "$headers_file"
    if [ -z "$links" ]; then
        if [ "$attempt" -lt 3 ]; then
            log "Subscription response for '$section' contained no supported links; retrying [$attempt/3]" "warn"
            sleep $((attempt * 2))
            download_subscription_proxy_links "$url" "$section" $((attempt + 1))
            return $?
        fi
        return 1
    fi
    printf '%s\n' "$links"
}

save_subscription_proxy_link_cache() {
    local section="$1"
    local links="$2"
    local cache_dir="/var/run/harpynet"
    local cache_file="$cache_dir/subscription-$section.links"
    local persistent_cache_dir="/etc/harpynet/subscription-cache"
    local persistent_cache_file="$persistent_cache_dir/subscription-$section.links"
    local i link outbound_tag display_name used_tags duplicate_index

    mkdir -p "$cache_dir"
    mkdir -p "$persistent_cache_dir"
    : > "$cache_file"
    : > "$persistent_cache_file"

    i=1
    while IFS= read -r link; do
        [ -z "$link" ] && continue

        display_name="${link#*#}"
        if [ "$display_name" = "$link" ]; then
            display_name=""
        else
            display_name="$(url_decode "$display_name" | tr '\t\r\n' '   ' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
        fi
        [ -n "$display_name" ] || display_name="Node $i"

        case "$display_name" in
        "$SB_DIRECT_OUTBOUND_TAG" | "$(get_outbound_tag_by_section "$section")")
            display_name="$display_name (node)"
            ;;
        esac

        outbound_tag="$display_name"
        duplicate_index=2
        while printf '%s\n' "$used_tags" | grep -Fxq "$outbound_tag"; do
            outbound_tag="$display_name ($duplicate_index)"
            duplicate_index=$((duplicate_index + 1))
        done
        used_tags="${used_tags}${used_tags:+
}$outbound_tag"

        printf '%s\t%s\n' "$outbound_tag" "$link" >> "$cache_file"
        printf '%s\t%s\n' "$outbound_tag" "$link" >> "$persistent_cache_file"
        i=$((i + 1))
    done <<EOF
$links
EOF
}

get_cached_subscription_proxy_links() {
    local section="$1"
    local persistent_cache_file="/etc/harpynet/subscription-cache/subscription-$section.links"
    local runtime_cache_file="/var/run/harpynet/subscription-$section.links"
    local cache_file

    for cache_file in "$persistent_cache_file" "$runtime_cache_file"; do
        if [ -s "$cache_file" ]; then
            awk -F '\t' 'NF >= 2 { print $2 }' "$cache_file"
            return 0
        fi
    done

    return 1
}

configure_outbound_handler() {
    local section="$1"

    local connection_type
    config_get connection_type "$section" "connection_type"
    case "$connection_type" in
    proxy | full_proxy | full_proxy_bypass_ru)
        log "Configuring subscription outbound for the $section section"
        local subscription_url subscription_proxy_links udp_over_tcp i outbound_tag outbound_tags_json \
            default_outbound selector_tag selector_outbounds selected_outbound
        subscription_url="$(get_subscription_url_with_telegram_refresh "$section")"
        config_get udp_over_tcp "$section" "enable_udp_over_tcp"
        config_get selected_outbound "$section" "selected_outbound"

        if [ -z "$subscription_url" ]; then
            subscription_proxy_links="$(get_cached_subscription_proxy_links "$section")"
            if [ -n "$subscription_proxy_links" ]; then
                log "Subscription URL is not available for '$section'; using the saved subscription cache" "warn"
            else
                log "Subscription URL is not set and no saved subscription cache exists." "fatal"
                exit 1
            fi
        else
            subscription_proxy_links="$(download_subscription_proxy_links "$subscription_url" "$section")"
        fi
        if [ -z "$subscription_proxy_links" ]; then
            subscription_proxy_links="$(get_cached_subscription_proxy_links "$section")"
            if [ -n "$subscription_proxy_links" ]; then
                log "Subscription did not contain supported proxy links. Using cached subscription for '$section'." "warn"
            else
                log "Subscription did not contain supported proxy links and no cached subscription exists." "fatal"
                exit 1
            fi
        fi
        save_subscription_proxy_link_cache "$section" "$subscription_proxy_links"
        log "Subscription for '$section' loaded: $(printf '%s\n' "$subscription_proxy_links" | sed '/^$/d' | wc -l) proxy links" "info"

        i=1
        while IFS= read -r link; do
            [ -z "$link" ] && continue
            outbound_tag="$(awk -F '\t' -v n="$i" 'NR == n { print $1; exit }' \
                "/var/run/harpynet/subscription-$section.links")"
            config="$(sing_box_cf_add_proxy_outbound "$config" "$section-$i" "$link" "$udp_over_tcp" "$outbound_tag")"
            if [ -z "$default_outbound" ]; then
                default_outbound="$outbound_tag"
            fi
            outbound_tags_json="$(printf '%s' "${outbound_tags_json:-[]}" | jq --arg tag "$outbound_tag" '. + [$tag]')"
            i=$((i + 1))
        done <<EOF
$subscription_proxy_links
EOF

        # A selector remains an internal sing-box requirement for manual node switching.
        selector_tag="$(get_outbound_tag_by_section "$section")"
        selector_outbounds="$outbound_tags_json"
        if [ -n "$selected_outbound" ] &&
            printf '%s' "$selector_outbounds" | jq -e --arg tag "$selected_outbound" 'index($tag) != null' >/dev/null 2>&1; then
            default_outbound="$selected_outbound"
            log "Restoring selected outbound for '$section': $selected_outbound" "info"
        fi
        config="$(sing_box_cm_add_selector_outbound "$config" "$selector_tag" "$selector_outbounds" \
            "$default_outbound")"
        ;;
    exclusion)
        log "Connection type 'exclusion' detected for the $section section - no outbound will be created (handled via route rules)"
        ;;
    *)
        log "Unknown connection type '$connection_type' for the $section section. Aborted." "fatal"
        exit 1
        ;;
    esac
}

sing_box_configure_dns() {
    log "Configure the DNS section of a sing-box JSON configuration"
    config=$(sing_box_cm_configure_dns "$config" "$SB_DNS_SERVER_TAG" "ipv4_only" true true)

    log "Adding DNS Servers" "debug"
    local dns_type dns_server bootstrap_dns_server dns_domain_resolver dns_server_address
    config_get dns_type "settings" "dns_type" "udp"
    config_get dns_server "settings" "dns_server" "77.88.8.8"
    config_get bootstrap_dns_server "settings" "bootstrap_dns_server" "77.88.8.8"

    dns_server_address="$(url_get_host "$dns_server")"
    if ! is_ipv4 "$dns_server_address"; then
        dns_domain_resolver=$SB_BOOTSTRAP_SERVER_TAG
    fi

    config=$(sing_box_cm_add_udp_dns_server "$config" "$SB_BOOTSTRAP_SERVER_TAG" "$bootstrap_dns_server" 53)
    config=$(sing_box_cf_add_dns_server "$config" "$dns_type" "$SB_DNS_SERVER_TAG" "$dns_server" "$dns_domain_resolver")
    config=$(sing_box_cm_add_fakeip_dns_server "$config" "$SB_FAKEIP_DNS_SERVER_TAG" "$SB_FAKEIP_INET4_RANGE")

    log "Adding DNS Rules"
    local rewrite_ttl service_domains
    config_get rewrite_ttl "settings" "dns_rewrite_ttl" "60"

    config=$(sing_box_cm_add_dns_reject_rule "$config" "query_type" "HTTPS")
    config=$(sing_box_cm_add_dns_reject_rule "$config" "domain_suffix" '"use-application-dns.net"')
    config=$(sing_box_cm_add_dns_route_rule "$config" "$SB_FAKEIP_DNS_SERVER_TAG" "$SB_FAKEIP_DNS_RULE_TAG")
    config=$(sing_box_cm_patch_dns_route_rule "$config" "$SB_FAKEIP_DNS_RULE_TAG" "rewrite_ttl" "$rewrite_ttl")
    service_domains=$(comma_string_to_json_array "$FAKEIP_TEST_DOMAIN,$CHECK_PROXY_IP_DOMAIN")
    config=$(sing_box_cm_patch_dns_route_rule "$config" "$SB_FAKEIP_DNS_RULE_TAG" "domain" "$service_domains")
}

sing_box_configure_route() {
    log "Configure the route section of a sing-box JSON configuration"

    local output_network_interface
    config_get output_network_interface "settings" "output_network_interface"
    if [ -z "$output_network_interface" ]; then
        config=$(sing_box_cm_configure_route "$config" "$SB_DIRECT_OUTBOUND_TAG" true "$SB_DNS_SERVER_TAG")
    else
        config=$(sing_box_cm_configure_route "$config" "$SB_DIRECT_OUTBOUND_TAG" false "$SB_DNS_SERVER_TAG" \
            "$output_network_interface")
    fi

    local sniff_inbounds
    sniff_inbounds=$(comma_string_to_json_array "$SB_TPROXY_INBOUND_TAG,$SB_DNS_INBOUND_TAG")
    config=$(sing_box_cm_sniff_route_rule "$config" "inbound" "$sniff_inbounds")

    config=$(sing_box_cm_add_hijack_dns_route_rule "$config" "protocol" "dns")

    local disable_quic
    config_get_bool disable_quic "settings" "disable_quic" 0
    if [ "$disable_quic" -eq 1 ]; then
        config=$(sing_box_cf_add_single_key_reject_rule "$config" "$SB_TPROXY_INBOUND_TAG" "protocol" "quic")
    fi

    local first_outbound_section first_outbound_tag
    first_outbound_section="$(get_first_outbound_section)"
    if [ -n "$first_outbound_section" ]; then
        first_outbound_tag="$(get_outbound_tag_by_section "$first_outbound_section")"
    else
        first_outbound_tag="$SB_DIRECT_OUTBOUND_TAG"
    fi
    config=$(sing_box_cf_proxy_domain "$config" "$SB_TPROXY_INBOUND_TAG" "$CHECK_PROXY_IP_DOMAIN" "$first_outbound_tag")
    config=$(sing_box_cf_override_domain_port "$config" "$FAKEIP_TEST_DOMAIN" 8443)

    configure_common_direct_route_rule

    local routing_excluded_ips
    config_get routing_excluded_ips "settings" "routing_excluded_ips"
    if [ -n "$routing_excluded_ips" ]; then
        rule_tag="$(gen_id)"
        config=$(sing_box_cm_add_route_rule "$config" "$rule_tag" "$SB_TPROXY_INBOUND_TAG" "$SB_DIRECT_OUTBOUND_TAG")
        config_list_foreach "settings" "routing_excluded_ips" exclude_source_ip_from_routing_handler "$rule_tag"
    fi

    # Must precede every VPN rule (including bypass-RU, per-device and Full
    # VPN rules). sing-box uses the first matching route rule.
    config_foreach configure_upstream_proxy_route_rule "section"

    config_foreach configure_full_proxy_bypass_ru_route_rule "section"

    config_foreach include_device_outbound_overrides_handler "section"

    config_foreach include_full_proxy_section_in_routing_handler "section"

    config_foreach include_full_proxy_bypass_ru_source_ips_in_routing_handler "section"

    config_foreach include_source_ips_in_routing_handler "section"

    config_foreach configure_routing_for_section_lists "section"
}

configure_upstream_proxy_route_rule() {
    local section="$1"
    local enabled connection_type community_lists domains protocol route_rule_tag outbound_tag items json_array

    config_get_bool enabled "$section" "upstream_proxy_enabled" 0
    [ "$enabled" -eq 1 ] || return 0
    config_get connection_type "$section" "connection_type"
    [ "$connection_type" != "exclusion" ] || return 0
    upstream_proxy_profile_is_ready "$section" || return 0
    config_get community_lists "$section" "upstream_proxy_community_lists"
    config_get domains "$section" "upstream_proxy_domains"
    [ -n "$community_lists" ] || [ -n "$domains" ] || {
        log "Upstream proxy is enabled for '$section' but no routes are selected" "warn"
        return 0
    }

    outbound_tag="$(get_upstream_proxy_outbound_tag "$section")"
    route_rule_tag="$(gen_id)"
    config="$(sing_box_cm_add_route_rule "$config" "$route_rule_tag" "$SB_TPROXY_INBOUND_TAG" "$outbound_tag")"

    if [ -n "$community_lists" ]; then
        config_list_foreach "$section" "upstream_proxy_community_lists" \
            configure_community_list_handler "$section" "$route_rule_tag"
    fi

    if [ -n "$domains" ]; then
        items="$(parse_domain_or_subnet_string_to_commas_string "$domains" "domains")"
        if [ -n "$items" ]; then
            json_array="$(comma_string_to_json_array "$items")"
            config="$(sing_box_cm_patch_route_rule "$config" "$route_rule_tag" "domain" "$json_array")"
            config="$(sing_box_cm_patch_route_rule "$config" "$route_rule_tag" "domain_suffix" "$json_array")"
            config="$(sing_box_cm_patch_dns_route_rule "$config" "$SB_FAKEIP_DNS_RULE_TAG" "domain" "$json_array")"
            config="$(sing_box_cm_patch_dns_route_rule "$config" "$SB_FAKEIP_DNS_RULE_TAG" "domain_suffix" "$json_array")"
        fi
    fi

    # Keep UDP on the same high-priority route too. HTTP outbounds cannot carry
    # it, so QUIC fails closed and clients retry over TCP instead of silently
    # leaking the selected service through the VPN route.

    log "Configured high-priority upstream proxy routes for '$section'" "info"
}

include_device_outbound_overrides_handler() {
    local section="$1"
    local connection_type device_outbounds

    config_get connection_type "$section" "connection_type"
    case "$connection_type" in
    proxy | full_proxy | full_proxy_bypass_ru) ;;
    *) return 0 ;;
    esac

    config_get device_outbounds "$section" "device_outbounds"
    [ -n "$device_outbounds" ] || return 0

    config_list_foreach "$section" "device_outbounds" include_device_outbound_override_handler "$section"
}

include_device_outbound_override_handler() {
    local entry="$1"
    local section="$2"
    local source_ip="${entry%%=*}"
    local outbound_tag="${entry#*=}"
    local rule_tag valid_tags

    [ -n "$source_ip" ] && [ -n "$outbound_tag" ] && [ "$source_ip" != "$outbound_tag" ] || return 0
    printf '%s' "$source_ip" | grep -Eq '^[0-9]{1,3}(\.[0-9]{1,3}){3}$' || return 0
    printf '%s' "$outbound_tag" | grep -q '[	\r\n]' && return 0

    valid_tags="$(awk -F '\t' 'NF >= 2 { print $1 }' \
        "/var/run/harpynet/subscription-$section.links" \
        "/etc/harpynet/subscription-cache/subscription-$section.links" 2>/dev/null | sort -u)"
    printf '%s\n' "$valid_tags" | grep -Fxq "$outbound_tag" || return 0

    log "Device $source_ip uses outbound override $outbound_tag" "info"
    rule_tag="$(gen_id)"
    config=$(sing_box_cm_add_route_rule "$config" "$rule_tag" "$SB_TPROXY_INBOUND_TAG" "$outbound_tag")
    config=$(sing_box_cm_patch_route_rule "$config" "$rule_tag" "source_ip_cidr" "$source_ip")
}

include_full_proxy_section_in_routing_handler() {
    local section="$1"
    local connection_type rule_tag

    config_get connection_type "$section" "connection_type"
    case "$connection_type" in
    full_proxy | full_proxy_bypass_ru) ;;
    *) return 0 ;;
    esac

    log "Full VPN mode enabled for '$section' section" "info"
    rule_tag="$(gen_id)"
    config=$(sing_box_cm_add_route_rule "$config" "$rule_tag" "$SB_TPROXY_INBOUND_TAG" "$(get_outbound_tag_by_section "$section")")
}

configure_full_proxy_bypass_ru_route_rule() {
    local section="$1"
    local connection_type

    config_get connection_type "$section" "connection_type"
    [ "$connection_type" = "full_proxy_bypass_ru" ] || return 0

    log "Full VPN bypass Russia mode enabled for '$section' section" "info"

    local rule_tag ruleset_tag url ru_domains
    rule_tag="$(gen_id)"
    ruleset_tag="$(get_ruleset_tag "$section" "russia_outside" "bypass")"
    url="$SRS_MAIN_URL/russia_outside.srs"
    ru_domains='["ru","su","СЂС„","СЂСѓСЃ","moscow","РјРѕСЃРєРІР°","xn--p1ai","xn--p1acf","xn--80adxhks"]'

    config=$(sing_box_cm_add_route_rule "$config" "$rule_tag" "$SB_TPROXY_INBOUND_TAG" "$SB_DIRECT_OUTBOUND_TAG")
    add_cached_binary_ruleset "$ruleset_tag" "$url" || exit 1
    config=$(sing_box_cm_patch_route_rule "$config" "$rule_tag" "rule_set" "$ruleset_tag")
    config=$(sing_box_cm_patch_route_rule "$config" "$rule_tag" "domain_suffix" "$ru_domains")
    config=$(sing_box_cm_patch_dns_route_rule "$config" "$SB_FAKEIP_DNS_RULE_TAG" "rule_set" "$ruleset_tag")
    config=$(sing_box_cm_patch_dns_route_rule "$config" "$SB_FAKEIP_DNS_RULE_TAG" "domain_suffix" "$ru_domains")
}

include_full_proxy_bypass_ru_source_ips_in_routing_handler() {
    local section="$1"

    local connection_type
    config_get connection_type "$section" "connection_type"
    [ "$connection_type" = "full_proxy_bypass_ru" ] || return 0

    local bypass_ru_routed_ips
    config_get bypass_ru_routed_ips "$section" "bypass_ru_routed_ips"
    [ -n "$bypass_ru_routed_ips" ] || return 0

    local direct_rule_tag proxy_rule_tag ruleset_tag url ru_domains
    direct_rule_tag="$(gen_id)"
    proxy_rule_tag="$(gen_id)"
    ruleset_tag="$(get_ruleset_tag "$section" "russia_outside" "device-bypass")"
    url="$SRS_MAIN_URL/russia_outside.srs"
    ru_domains='["ru","su","СЂС„","СЂСѓСЃ","moscow","РјРѕСЃРєРІР°","xn--p1ai","xn--p1acf","xn--80adxhks"]'

    config=$(sing_box_cm_add_route_rule "$config" "$direct_rule_tag" "$SB_TPROXY_INBOUND_TAG" "$SB_DIRECT_OUTBOUND_TAG")
    add_cached_binary_ruleset "$ruleset_tag" "$url" || exit 1
    config=$(sing_box_cm_patch_route_rule "$config" "$direct_rule_tag" "rule_set" "$ruleset_tag")
    config=$(sing_box_cm_patch_route_rule "$config" "$direct_rule_tag" "domain_suffix" "$ru_domains")
    config_list_foreach "$section" "bypass_ru_routed_ips" include_source_ip_in_routing_handler "$direct_rule_tag"

    config=$(sing_box_cm_add_route_rule "$config" "$proxy_rule_tag" "$SB_TPROXY_INBOUND_TAG" "$(get_outbound_tag_by_section "$section")")
    config_list_foreach "$section" "bypass_ru_routed_ips" include_source_ip_in_routing_handler "$proxy_rule_tag"
}

include_source_ips_in_routing_handler() {
    local section="$1"

    local connection_type fully_routed_ips rule_tag
    config_get connection_type "$section" "connection_type"
    case "$connection_type" in
    proxy | full_proxy | full_proxy_bypass_ru) ;;
    *) return 0 ;;
    esac

    config_get fully_routed_ips "$section" "fully_routed_ips"
    if [ -n "$fully_routed_ips" ]; then
        rule_tag="$(gen_id)"
        config=$(
            sing_box_cm_add_route_rule \
                "$config" "$rule_tag" "$SB_TPROXY_INBOUND_TAG" "$(get_outbound_tag_by_section "$section")"
        )
        config_list_foreach "$section" "fully_routed_ips" include_source_ip_in_routing_handler "$rule_tag"
    fi
}

configure_common_direct_route_rule() {
    local exclusion_sections exclusion_section_list_enabled
    exclusion_sections="$(get_sections_by_connection_type "exclusion")"
    exclusion_section_list_enabled=0

    if [ -n "$exclusion_sections" ]; then
        # "Выключить VPN" must be a real off switch. Older configs can still
        # keep community lists, bypass-RU device IPs, or per-device outbound
        # overrides in UCI.  Do not create an exclusion route for those stale
        # values, otherwise the replacement config can reference rule-sets while
        # the user expects all HarpyNet routing to be disabled.
        log "VPN disabled by exclusion section; skipping direct/exclusion route rules" "info"
        return 0

        for exclusion_section in $exclusion_sections; do
            if section_has_enabled_lists "$exclusion_section"; then
                exclusion_section_list_enabled=1
                break
            fi
        done
        if [ "$exclusion_section_list_enabled" -eq 1 ]; then
            config=$(sing_box_cm_add_route_rule "$config" "$SB_EXCLUSION_RULE_TAG" "$SB_TPROXY_INBOUND_TAG" \
                "$SB_DIRECT_OUTBOUND_TAG")
        else
            log "Exclusion sections does not have any enabled list, route rule is not required" "warn"
        fi
    fi
}

include_source_ip_in_routing_handler() {
    local source_ip="$1"
    local rule_tag="$2"
    config=$(sing_box_cm_patch_route_rule "$config" "$rule_tag" "source_ip_cidr" "$source_ip")
}

exclude_source_ip_from_routing_handler() {
    local source_ip="$1"
    local rule_tag="$2"

    config=$(sing_box_cm_patch_route_rule "$config" "$rule_tag" "source_ip_cidr" "$source_ip")
}

configure_routing_for_section_lists() {
    local section="$1"

    log "Configuring routing for '$section' section"
    if ! section_has_enabled_lists "$section"; then
        log "Section '$section' does not have any enabled list, skipping..." "warn"
        return 0
    fi

    local community_lists user_domain_list_type user_subnet_list_type local_domain_lists local_subnet_lists \
        remote_domain_lists remote_subnet_lists section_connection_type route_rule_tag resolve_real_ip_for_routing
    config_get community_lists "$section" "community_lists"
    config_get user_domain_list_type "$section" "user_domain_list_type" "disabled"
    config_get user_subnet_list_type "$section" "user_subnet_list_type" "disabled"
    config_get local_domain_lists "$section" "local_domain_lists"
    config_get local_subnet_lists "$section" "local_subnet_lists"
    config_get remote_domain_lists "$section" "remote_domain_lists"
    config_get remote_subnet_lists "$section" "remote_subnet_lists"
    config_get section_connection_type "$section" "connection_type"
    config_get_bool resolve_real_ip_for_routing "$section" "resolve_real_ip_for_routing" 0

    if [ "$section_connection_type" = "exclusion" ]; then
        log "VPN disabled for '$section' section; skipping list routing rules" "info"
        return 0
    fi

    case "$section_connection_type" in
    proxy | full_proxy | full_proxy_bypass_ru)
        route_rule_tag="$(gen_id)"
        outbound_tag=$(get_outbound_tag_by_section "$section")
        config=$(sing_box_cm_add_route_rule "$config" "$route_rule_tag" "$SB_TPROXY_INBOUND_TAG" "$outbound_tag")
        if printf ' %s ' "$community_lists" | grep -q ' telegram '; then
            configure_telegram_udp_reject_rule "$route_rule_tag"
        fi
        ;;
    exclusion)
        route_rule_tag="$SB_EXCLUSION_RULE_TAG"
        ;;
    *)
        log "Unsupported '$section_connection_type' connection type. Skipping routing for '$section' section" "fatal"
        exit 1
        ;;
    esac

    if [ -n "$community_lists" ]; then
        log "Processing community list routing rules for '$section' section"
        config_list_foreach "$section" "community_lists" configure_community_list_handler "$section" "$route_rule_tag"
    fi

    if [ "$user_domain_list_type" != "disabled" ]; then
        log "Processing user domains routing rules for '$section' section"
        configure_user_domain_list "$section" "$route_rule_tag"
    fi

    if [ "$user_subnet_list_type" != "disabled" ]; then
        log "Processing user subnets routing rules for '$section' section"
        configure_user_subnet_list "$section" "$route_rule_tag"
    fi

    if [ -n "$local_domain_lists" ]; then
        log "Processing local domains routing rules for '$section' section"
        configure_local_domain_lists "$section" "$route_rule_tag"
    fi

    if [ -n "$local_subnet_lists" ]; then
        log "Processing local subnets routing rules for '$section' section"
        configure_local_subnet_lists "$section" "$route_rule_tag"
    fi

    if [ -n "$remote_domain_lists" ]; then
        log "Processing remote domains routing rules for '$section' section"
        config_list_foreach "$section" "remote_domain_lists" configure_remote_domain_or_subnet_list_handler \
            "domains" "$section" "$route_rule_tag"
    fi

    if [ -n "$remote_subnet_lists" ]; then
        log "Processing remote subnets routing rules for '$section' section"
        config_list_foreach "$section" "remote_subnet_lists" configure_remote_domain_or_subnet_list_handler \
            "subnets" "$section" "$route_rule_tag"
    fi

    if [ "$resolve_real_ip_for_routing" -eq 1 ]; then
        config=$(sing_box_cm_add_resolve_rule "$config" "$route_rule_tag" "$(gen_id)" "$SB_DNS_SERVER_TAG")
        log "Added resolve rule for '$section' section" "debug"
    fi
}

configure_community_list_handler() {
    local tag="$1"
    local section="$2"
    local route_rule_tag="$3"

    local ruleset_tag url
    ruleset_tag="$(get_ruleset_tag "$section" "$tag" "community")"
    url="$SRS_MAIN_URL/$tag.srs"

    add_cached_binary_ruleset "$ruleset_tag" "$url" "$tag" || exit 1
    config=$(sing_box_cm_patch_route_rule "$config" "$route_rule_tag" "rule_set" "$ruleset_tag")
    config=$(sing_box_cm_patch_dns_route_rule "$config" "$SB_FAKEIP_DNS_RULE_TAG" "rule_set" "$ruleset_tag")
    configure_community_subnet_route "$tag" "$route_rule_tag"

    if [ "$tag" = "discord" ]; then
        config=$(sing_box_cm_patch_route_rule \
            "$config" "$route_rule_tag" "ip_cidr" "$DISCORD_VOICE_IPV4_CIDRS")
    fi
}

get_community_service_subnet_url() {
    local service="$1"

    case "$service" in
    "twitter") echo "$SUBNETS_TWITTER" ;;
    "meta") echo "$SUBNETS_META" ;;
    "telegram") echo "$SUBNETS_TELERAM" ;;
    "cloudflare") echo "$SUBNETS_CLOUDFLARE" ;;
    "hetzner") echo "$SUBNETS_HETZNER" ;;
    "ovh") echo "$SUBNETS_OVH" ;;
    "digitalocean") echo "$SUBNETS_DIGITALOCEAN" ;;
    "cloudfront") echo "$SUBNETS_CLOUDFRONT" ;;
    "discord") echo "$SUBNETS_DISCORD" ;;
    "roblox") echo "$SUBNETS_ROBLOX" ;;
    *) return 1 ;;
    esac
}

configure_community_subnet_route() {
    local service="$1"
    local route_rule_tag="$2"
    local url tmpfile http_proxy_address items json_array

    url="$(get_community_service_subnet_url "$service")" || return 0
    [ -z "$url" ] && return 0

    tmpfile=$(mktemp)
    http_proxy_address="$(get_service_proxy_address)"
    download_list_to_file_fast "$url" "$tmpfile" "$http_proxy_address"

    if [ $? -ne 0 ] || [ ! -s "$tmpfile" ]; then
        log "Download $service subnet route list failed" "error"
        rm -f "$tmpfile"
        return 1
    fi

    items="$(parse_domain_or_subnet_file_to_comma_string "$tmpfile" "subnets")"
    rm -f "$tmpfile"

    [ -z "$items" ] && return 0

    json_array="$(comma_string_to_json_array "$items")"
    config=$(sing_box_cm_patch_route_rule "$config" "$route_rule_tag" "ip_cidr" "$json_array")
}

configure_telegram_udp_reject_rule() {
    local route_rule_tag="$1"
    local url tmpfile items json_array reject_tag

    url="$(get_community_service_subnet_url "telegram")" || return 0
    [ -z "$url" ] && return 0

    tmpfile="$(mktemp)"
    download_list_to_file_fast "$url" "$tmpfile" "$(get_service_proxy_address)"

    if [ $? -ne 0 ] || [ ! -s "$tmpfile" ]; then
        log "Telegram UDP fast-fallback rule skipped: subnet list download failed" "warn"
        rm -f "$tmpfile"
        return 0
    fi

    items="$(parse_domain_or_subnet_file_to_comma_string "$tmpfile" "subnets")"
    rm -f "$tmpfile"

    [ -z "$items" ] && return 0

    json_array="$(comma_string_to_json_array "$items")"
    reject_tag="$(gen_id)"

    config="$(echo "$config" | jq \
        --arg service_tag "$SERVICE_TAG" \
        --arg route_tag "$route_rule_tag" \
        --arg reject_tag "$reject_tag" \
        --arg inbound "$SB_TPROXY_INBOUND_TAG" \
        --argjson cidrs "$json_array" \
        '.route.rules |= [
            .[] |
            if .[$service_tag] == $route_tag then
                {
                    action: "reject",
                    inbound: $inbound,
                    network: "udp",
                    ip_cidr: $cidrs,
                    ($service_tag): $reject_tag
                }, .
            else .
            end
        ]')"

    log "Added Telegram UDP fast-fallback rule for mobile clients" "debug"
}

prepare_source_ruleset() {
    local section="$1"
    local name="$2"
    local type="$3"
    local route_rule_tag="$4"

    log "Preparing a $name $type rule set for '$section' section" "debug"
    ruleset_tag=$(get_ruleset_tag "$section" "$name" "$type")
    ruleset_filepath="$TMP_RULESET_FOLDER/$ruleset_tag.json"
    create_source_rule_set "$ruleset_filepath"
    case $? in
    0) ;;
    3) log "Source rule set $ruleset_filepath already exists, skipping." "debug" ;;
    *)
        log "Failed to create source rule set $ruleset_filepath" "error"
        return 1
        ;;
    esac

    config=$(sing_box_cm_add_local_ruleset "$config" "$ruleset_tag" "source" "$ruleset_filepath")
    config=$(sing_box_cm_patch_route_rule "$config" "$route_rule_tag" "rule_set" "$ruleset_tag")
    case "$type" in
    domains)
        config=$(sing_box_cm_patch_dns_route_rule "$config" "$SB_FAKEIP_DNS_RULE_TAG" "rule_set" "$ruleset_tag")
        ;;
    subnets) ;;
    *)
        log "Unsupported remote rule set type: $type" "error"
        return 1
        ;;
    esac
}

configure_user_domain_list() {
    local section="$1"
    local route_rule_tag="$2"

    prepare_source_ruleset "$section" "user" "domains" "$route_rule_tag"

    local user_domain_list_type items json_array
    config_get user_domain_list_type "$section" "user_domain_list_type"
    case "$user_domain_list_type" in
    dynamic) config_get items "$section" "user_domains" ;;
    text) config_get items "$section" "user_domains_text" ;;
    esac

    items="$(parse_domain_or_subnet_string_to_commas_string "$items" "domains")"
    json_array="$(comma_string_to_json_array "$items")"
    patch_source_ruleset_rules "$ruleset_filepath" "domain_suffix" "$json_array"
}

configure_user_subnet_list() {
    local section="$1"
    local route_rule_tag="$2"

    prepare_source_ruleset "$section" "user" "subnets" "$route_rule_tag"

    local user_subnet_list_type items json_array
    config_get user_subnet_list_type "$section" "user_subnet_list_type"
    case "$user_subnet_list_type" in
    dynamic) config_get items "$section" "user_subnets" ;;
    text) config_get items "$section" "user_subnets_text" ;;
    esac

    items="$(parse_domain_or_subnet_string_to_commas_string "$items" "subnets")"
    json_array="$(comma_string_to_json_array "$items")"
    patch_source_ruleset_rules "$ruleset_filepath" "ip_cidr" "$json_array"
    nft_add_set_elements "$NFT_TABLE_NAME" "$NFT_COMMON_SET_NAME" "$items"
}

configure_local_domain_lists() {
    local section="$1"
    local route_rule_tag="$2"

    prepare_source_ruleset "$section" "local" "domains" "$route_rule_tag"

    config_list_foreach "$section" "local_domain_lists" import_local_domain_list_handler "$ruleset_filepath"
}

import_local_domain_list_handler() {
    local local_domain_list_filepath="$1"
    local ruleset_filepath="$2"

    if ! file_exists "$local_domain_list_filepath"; then
        log "Local domain list file $local_domain_list_filepath not found" "error"
        return 1
    fi

    import_plain_domain_list_to_local_source_ruleset_chunked "$local_domain_list_filepath" "$ruleset_filepath"
}

configure_local_subnet_lists() {
    local section="$1"
    local route_rule_tag="$2"

    prepare_source_ruleset "$section" "local" "subnets" "$route_rule_tag"

    config_list_foreach "$section" "local_subnet_lists" import_local_subnets_list_handler "$ruleset_filepath"
}

import_local_subnets_list_handler() {
    local local_subnet_list_filepath="$1"
    local ruleset_filepath="$2"

    if ! file_exists "$local_subnet_list_filepath"; then
        log "Local subnet list file $local_subnet_list_filepath not found" "error"
        return 1
    fi

    import_plain_subnet_list_to_local_source_ruleset_chunked "$local_subnet_list_filepath" "$ruleset_filepath"
    nft_add_set_elements_from_file_chunked "$local_subnet_list_filepath" "$NFT_TABLE_NAME" "$NFT_COMMON_SET_NAME"
}

configure_remote_domain_or_subnet_list_handler() {
    local url="$1"
    local type="$2"
    local section="$3"
    local route_rule_tag="$4"

    local file_extension
    file_extension=$(url_get_file_extension "$url")
    log "Detected file extension: '$file_extension'" "debug"
    case "$file_extension" in
    json | srs)
        log "Creating a remote $type ruleset from the source URL" "info"
        local basename ruleset_tag format detour update_interval
        basename=$(url_get_basename "$url")
        ruleset_tag=$(get_ruleset_tag "$section" "$basename" "remote-$type")
        format="$(get_ruleset_format_by_file_extension "$file_extension")"
        detour="$(get_download_detour_tag)"
        config_get update_interval "settings" "update_interval" "1d"

        if [ "$format" = "binary" ]; then
            add_cached_binary_ruleset "$ruleset_tag" "$url" || exit 1
        else
            config=$(sing_box_cm_add_remote_ruleset "$config" "$ruleset_tag" "$format" "$url" "$detour" "$update_interval")
        fi
        config=$(sing_box_cm_patch_route_rule "$config" "$route_rule_tag" "rule_set" "$ruleset_tag")
        case "$type" in
        domains)
            config=$(sing_box_cm_patch_dns_route_rule "$config" "$SB_FAKEIP_DNS_RULE_TAG" "rule_set" "$ruleset_tag")
            ;;
        subnets) ;;
        *) log "Unsupported remote rule set type: $type" "error" ;;
        esac
        ;;
    *)
        prepare_source_ruleset "$section" "remote" "$type" "$route_rule_tag"
        ;;
    esac
}

sing_box_configure_experimental() {
    log "Configure the experimental section of a sing-box JSON configuration"

    log "Configuring cache database"
    local cache_file
    config_get cache_file "settings" "cache_path" "/etc/harpynet/cache.db"
    mkdir -p "$(dirname "$cache_file")"
    config=$(sing_box_cm_configure_cache_file "$config" true "$cache_file" true)

    log "Configuring Clash API"
    local enable_yacd enable_yacd_wan_access clash_api_controller_address
    config_get_bool enable_yacd "settings" "enable_yacd" 0
    config_get_bool enable_yacd_wan_access "settings" "enable_yacd_wan_access" 0

    if [ "$enable_yacd" -eq 1 ] && [ "$enable_yacd_wan_access" -eq 1 ]; then
        clash_api_controller_address="0.0.0.0"
    else
        clash_api_controller_address="$(get_service_listen_address)"
        if [ -z "$clash_api_controller_address" ]; then
            log "Could not determine the listening IP address for the Clash API controller. It will run only on localhost." "warn"
            clash_api_controller_address="127.0.0.1"
        fi
    fi

    if [ "$enable_yacd" -eq 1 ]; then
        log "YACD is enabled, enabling Clash API with downloadable YACD" "debug"
        local yacd_secret_key external_controller_ui
        config_get yacd_secret_key "settings" "yacd_secret_key"
        external_controller_ui="ui"

        config=$(
            sing_box_cm_configure_clash_api \
                "$config" \
                "$clash_api_controller_address:$SB_CLASH_API_CONTROLLER_PORT" \
                "$external_controller_ui" \
                "$yacd_secret_key"
        )
    else
        log "YACD is disabled, enabling Clash API in online mode" "debug"
        config=$(
            sing_box_cm_configure_clash_api "$config" "$clash_api_controller_address:$SB_CLASH_API_CONTROLLER_PORT"
        )
    fi
}

sing_box_additional_inbounds() {
    log "Configure the additional inbounds of a sing-box JSON configuration"

    local download_lists_via_proxy
    config_get_bool download_lists_via_proxy "settings" "download_lists_via_proxy" 0
    if [ "$download_lists_via_proxy" -eq 1 ]; then
        local download_lists_via_proxy_section section_outbound_tag
        config_get download_lists_via_proxy_section "settings" "download_lists_via_proxy_section"
        section_outbound_tag="$(get_outbound_tag_by_section "$download_lists_via_proxy_section")"
        config=$(
            sing_box_cf_add_mixed_inbound_and_route_rule \
                "$config" \
                "$SB_SERVICE_MIXED_INBOUND_TAG" \
                "$SB_SERVICE_MIXED_INBOUND_ADDRESS" \
                "$SB_SERVICE_MIXED_INBOUND_PORT" \
                "$section_outbound_tag"
        )
    fi

    config_foreach configure_section_mixed_proxy "section"
}

configure_section_mixed_proxy() {
    local section="$1"

    local mixed_inbound_enabled mixed_proxy_port mixed_inbound_tag mixed_outbound_tag mixed_proxy_address
    config_get_bool mixed_inbound_enabled "$section" "mixed_proxy_enabled" 0
    mixed_proxy_address="$(get_service_listen_address)"
    if [ -z "$mixed_proxy_address" ]; then
        log "Could not determine the listening IP address for the Mixed Proxy. The proxy will not be created." "warn"
        return 1
    fi
    config_get mixed_proxy_port "$section" "mixed_proxy_port"
    if [ "$mixed_inbound_enabled" -eq 1 ]; then
        mixed_inbound_tag="$(get_inbound_tag_by_section "$section-mixed")"
        mixed_outbound_tag="$(get_outbound_tag_by_section "$section")"
        config=$(
            sing_box_cf_add_mixed_inbound_and_route_rule \
                "$config" \
                "$mixed_inbound_tag" \
                "$mixed_proxy_address" \
                "$mixed_proxy_port" \
                "$mixed_outbound_tag"
        )
    fi
}

sing_box_save_config() {
    local sing_box_config_path temp_file_path current_config_hash temp_config_hash
    config_get sing_box_config_path "settings" "config_path"
    temp_file_path="$(mktemp)"
    log "Save sing-box temporary config to $temp_file_path" "debug"
    sing_box_cm_save_config_to_file "$config" "$temp_file_path"

    ensure_local_ruleset_files "$temp_file_path"
    sing_box_config_check "$temp_file_path"

    current_config_hash=$(md5sum "$sing_box_config_path" 2> /dev/null | awk '{print $1}')
    temp_config_hash=$(md5sum "$temp_file_path" | awk '{print $1}')
    log "Current sing-box config hash: $current_config_hash" "debug"
    log "Temporary sing-box config hash: $temp_config_hash" "debug"
    if [ "$current_config_hash" != "$temp_config_hash" ]; then
        log "sing-box configuration has changed and will be updated"
        mv "$temp_file_path" "$sing_box_config_path"
    else
        log "sing-box configuration is unchanged"
        rm "$temp_file_path"
    fi
}

sing_box_config_check() {
    local config_path="$1"

    if ! sing-box -c "$config_path" check > /dev/null 2>&1; then
        log "Sing-box configuration $config_path is invalid. Aborted." "fatal"
        exit 1
    fi

    if ! jq -e '
        ([.outbounds[]?.tag] | unique) as $outbound_tags
        | ([.route.rule_set[]?.tag] | unique) as $ruleset_tags
        | ([
            .outbounds[]?
            | select(.type == "selector" or .type == "urltest")
            | .outbounds[]?
          ] + [
            .route.rules[]?.outbound?
            | select(. != null)
          ] | unique) as $outbound_refs
        | ([
            .route.rules[]?.rule_set?
            | select(. != null)
            | if type == "array" then .[] else . end
          ] | unique) as $ruleset_refs
        | (($outbound_refs - $outbound_tags) | length) == 0
          and (($ruleset_refs - $ruleset_tags) | length) == 0
    ' "$config_path" > /dev/null 2>&1; then
        log "Sing-box configuration $config_path contains a missing outbound or rule-set dependency. Aborted." "fatal"
        exit 1
    fi
}

import_community_subnet_lists() {
    local section="$1"
    local community_lists
    config_get community_lists "$section" "community_lists"
    if [ -n "$community_lists" ]; then
        log "Importing community subnet lists for '$section' section"
        config_list_foreach "$section" "community_lists" import_community_service_subnet_list_handler
    fi

    config_get community_lists "$section" "upstream_proxy_community_lists"
    if [ -n "$community_lists" ]; then
        log "Importing upstream proxy subnet lists for '$section' section"
        config_list_foreach "$section" "upstream_proxy_community_lists" import_community_service_subnet_list_handler
    fi
}

import_community_service_subnet_list_handler() {
    local service="$1"

    case "$service" in
    "discord")
        nft_create_ipv4_set "$NFT_TABLE_NAME" "$NFT_DISCORD_SET_NAME"
        nft add rule inet "$NFT_TABLE_NAME" mangle iifname "@$NFT_INTERFACE_SET_NAME" ip daddr \
            "@$NFT_DISCORD_SET_NAME" udp dport '{ 3478-3481, 19000-20000, 50000-65535 }' meta mark set "$NFT_FAKEIP_MARK" counter
        ;;
    esac

    URL="$(get_community_service_subnet_url "$service")" || return 0

    local tmpfile http_proxy_address
    tmpfile=$(mktemp)
    http_proxy_address="$(get_service_proxy_address)"

    download_list_to_file "$URL" "$tmpfile" "$http_proxy_address"

    if [ $? -ne 0 ] || [ ! -s "$tmpfile" ]; then
        log "Download $service list failed" "error"
        LIST_UPDATE_FAILED=1
        rm -f "$tmpfile"
        return 1
    fi

    if [ "$service" = "discord" ]; then
        nft_add_set_elements_from_file_chunked "$tmpfile" "$NFT_TABLE_NAME" "$NFT_DISCORD_SET_NAME"
    else
        nft_add_set_elements_from_file_chunked "$tmpfile" "$NFT_TABLE_NAME" "$NFT_COMMON_SET_NAME"
    fi

    rm -f "$tmpfile"
}

import_domains_from_remote_domain_lists() {
    local section="$1"
    local remote_domain_lists
    config_get remote_domain_lists "$section" "remote_domain_lists"
    if [ -n "$remote_domain_lists" ]; then
        log "Importing domains from remote domain lists for '$section' section"
        config_list_foreach "$section" "remote_domain_lists" import_domains_from_remote_domain_list_handler "$section"
    fi
}

import_domains_from_remote_domain_list_handler() {
    local url="$1"
    local section="$2"

    log "Importing domains from URL: $url"

    local file_extension
    file_extension=$(url_get_file_extension "$url")
    log "Detected file extension: '$file_extension'" "debug"
    case "$file_extension" in
    json | srs)
        log "No update needed - sing-box manages updates automatically."
        ;;
    *)
        log "Import domains from a remote plain-text list"
        import_domains_from_remote_plain_file "$url" "$section"
        ;;
    esac
}

import_domains_from_remote_plain_file() {
    local url="$1"
    local section="$2"

    local tmpfile http_proxy_address items json_array
    tmpfile=$(mktemp)
    http_proxy_address="$(get_service_proxy_address)"

    download_list_to_file "$url" "$tmpfile" "$http_proxy_address"

    if [ $? -ne 0 ] || [ ! -s "$tmpfile" ]; then
        log "Download $url list failed" "error"
        LIST_UPDATE_FAILED=1
        rm -f "$tmpfile"
        return 1
    fi

    convert_crlf_to_lf "$tmpfile"
    ruleset_tag=$(get_ruleset_tag "$section" "remote" "domains")
    ruleset_filepath="$TMP_RULESET_FOLDER/$ruleset_tag.json"
    import_plain_domain_list_to_local_source_ruleset_chunked "$tmpfile" "$ruleset_filepath"

    rm -f "$tmpfile"
}

import_subnets_from_remote_subnet_lists() {
    local section="$1"
    local remote_subnet_lists
    config_get remote_subnet_lists "$section" "remote_subnet_lists"
    if [ -n "$remote_subnet_lists" ]; then
        log "Importing subnets from remote subnet lists for '$section' section"
        config_list_foreach "$section" "remote_subnet_lists" import_subnets_from_remote_subnet_list_handler "$section"
    fi
}

import_subnets_from_remote_subnet_list_handler() {
    local url="$1"
    local section="$2"

    log "Importing subnets from URL: $url"

    local file_extension
    file_extension="$(url_get_file_extension "$url")"
    log "Detected file extension: '$file_extension'" "debug"
    case "$file_extension" in
    json)
        log "Import subnets from a remote JSON list" "info"
        import_subnets_from_remote_json_file "$url"
        ;;
    srs)
        log "Import subnets from a remote SRS list" "info"
        import_subnets_from_remote_srs_file "$url"
        ;;
    *)
        log "Import subnets from a remote plain-text list" "info"
        import_subnets_from_remote_plain_file "$url" "$section"
        ;;
    esac
}

import_subnets_from_remote_json_file() {
    local url="$1"
    local json_tmpfile subnets_tmpfile http_proxy_address
    json_tmpfile="$(mktemp)"
    subnets_tmpfile="$(mktemp)"
    http_proxy_address="$(get_service_proxy_address)"

    download_list_to_file "$url" "$json_tmpfile" "$http_proxy_address"

    if [ $? -ne 0 ] || [ ! -s "$json_tmpfile" ]; then
        log "Download $url list failed" "error"
        LIST_UPDATE_FAILED=1
        rm -f "$json_tmpfile" "$subnets_tmpfile"
        return 1
    fi

    extract_ip_cidr_from_json_ruleset_to_file "$json_tmpfile" "$subnets_tmpfile"
    nft_add_set_elements_from_file_chunked "$subnets_tmpfile" "$NFT_TABLE_NAME" "$NFT_COMMON_SET_NAME"
    rm -f "$json_tmpfile" "$subnets_tmpfile"
}

import_subnets_from_remote_srs_file() {
    local url="$1"

    local binary_tmpfile json_tmpfile subnets_tmpfile http_proxy_address
    binary_tmpfile="$(mktemp)"
    json_tmpfile="$(mktemp)"
    subnets_tmpfile="$(mktemp)"
    http_proxy_address="$(get_service_proxy_address)"

    download_list_to_file "$url" "$binary_tmpfile" "$http_proxy_address"

    if [ $? -ne 0 ] || [ ! -s "$binary_tmpfile" ]; then
        log "Download $url list failed" "error"
        LIST_UPDATE_FAILED=1
        rm -f "$binary_tmpfile" "$json_tmpfile" "$subnets_tmpfile"
        return 1
    fi

    if ! decompile_binary_ruleset "$binary_tmpfile" "$json_tmpfile"; then
        log "Failed to decompile binary rule set file" "error"
        LIST_UPDATE_FAILED=1
        rm -f "$binary_tmpfile" "$json_tmpfile" "$subnets_tmpfile"
        return 1
    fi

    extract_ip_cidr_from_json_ruleset_to_file "$json_tmpfile" "$subnets_tmpfile"
    nft_add_set_elements_from_file_chunked "$subnets_tmpfile" "$NFT_TABLE_NAME" "$NFT_COMMON_SET_NAME"
    rm -f "$binary_tmpfile" "$json_tmpfile" "$subnets_tmpfile"
}

import_subnets_from_remote_plain_file() {
    local url="$1"
    local section="$2"

    local tmpfile http_proxy_address items json_array
    tmpfile=$(mktemp)
    http_proxy_address="$(get_service_proxy_address)"

    download_list_to_file "$url" "$tmpfile" "$http_proxy_address"

    if [ $? -ne 0 ] || [ ! -s "$tmpfile" ]; then
        log "Download $url list failed" "error"
        LIST_UPDATE_FAILED=1
        rm -f "$tmpfile"
        return 1
    fi

    convert_crlf_to_lf "$tmpfile"

    ruleset_tag=$(get_ruleset_tag "$section" "remote" "subnets")
    ruleset_filepath="$TMP_RULESET_FOLDER/$ruleset_tag.json"
    import_plain_subnet_list_to_local_source_ruleset_chunked "$tmpfile" "$ruleset_filepath"
    nft_add_set_elements_from_file_chunked "$tmpfile" "$NFT_TABLE_NAME" "$NFT_COMMON_SET_NAME"

    rm -f "$tmpfile"
}

## Support functions
get_service_proxy_address() {
    local download_lists_via_proxy
    config_get_bool download_lists_via_proxy "settings" "download_lists_via_proxy" 0
    if [ "$download_lists_via_proxy" -eq 1 ]; then
        echo "$SB_SERVICE_MIXED_INBOUND_ADDRESS:$SB_SERVICE_MIXED_INBOUND_PORT"
    else
        echo ""
    fi
}

get_download_detour_tag() {
    config_get_bool download_lists_via_proxy "settings" "download_lists_via_proxy" 0
    if [ "$download_lists_via_proxy" -eq 1 ]; then
        local download_lists_via_proxy_section section_outbound_tag
        config_get download_lists_via_proxy_section "settings" "download_lists_via_proxy_section"
        section_outbound_tag="$(get_outbound_tag_by_section "$download_lists_via_proxy_section")"
        echo "$section_outbound_tag"
    else
        echo ""
    fi
}

_determine_first_outbound_section() {
    local section="$1"

    local connection_type
    config_get connection_type "$section" "connection_type"

    if [ "$connection_type" = "proxy" ] || [ "$connection_type" = "full_proxy" ] || [ "$connection_type" = "full_proxy_bypass_ru" ]; then
        [ -z "$first_section" ] && first_section="$1"
    fi
}

get_first_outbound_section() {
    local first_section=""

    config_foreach _determine_first_outbound_section "section"

    echo "$first_section"
}

get_sections_by_connection_type() {
    local connection_type="$1"

    uci show harpynet | grep "\.connection_type='$connection_type'" | cut -d'.' -f2
}

section_by_connection_type_exists() {
    local connection_type="$1"

    if uci show harpynet | grep -q "\.connection_type='$connection_type'"; then
        return 0
    else
        return 1
    fi
}

section_has_enabled_lists() {
    local section="$1"
    local community_lists user_domain_list_type user_subnet_list_type local_domain_lists local_subnet_lists \
        remote_domain_lists remote_subnet_lists

    config_get community_lists "$section" "community_lists"
    config_get user_domain_list_type "$section" "user_domain_list_type" "disabled"
    config_get user_subnet_list_type "$section" "user_subnet_list_type" "disabled"
    config_get local_domain_lists "$section" "local_domain_lists"
    config_get local_subnet_lists "$section" "local_subnet_lists"
    config_get remote_domain_lists "$section" "remote_domain_lists"
    config_get remote_subnet_lists "$section" "remote_subnet_lists"

    if [ -n "$community_lists" ] ||
        [ "$user_domain_list_type" != "disabled" ] ||
        [ "$user_subnet_list_type" != "disabled" ] ||
        [ -n "$local_domain_lists" ] ||
        [ -n "$local_subnet_lists" ] ||
        [ -n "$remote_domain_lists" ] ||
        [ -n "$remote_subnet_lists" ]; then
        return 0
    else
        return 1
    fi
}

get_service_listen_address() {
    local service_listen_address

    config_get service_listen_address "settings" "service_listen_address"
    if [ -n "$service_listen_address" ]; then
        log "Attention! The service_listen_address option is being used, overriding the automatic detection of the listening IP address!" "warn"
        echo "$service_listen_address"
        return 0
    fi

    local interface="lan"
    network_get_ipaddr service_listen_address "$interface"

    if [ -z "$service_listen_address" ]; then
        log "Failed to determine the listening IP address. Please open an issue to report this problem: https://github.com/sentiox/narpynet/issues" "error"
        return 1
    fi

    echo "$service_listen_address"
}

## nftables
nft_include_full_proxy_section_handler() {
    local section="$1"
    local connection_type

    config_get connection_type "$section" "connection_type"
    case "$connection_type" in
    full_proxy | full_proxy_bypass_ru) ;;
    *) return 0 ;;
    esac

    nft_list_all_external_traffic
}

nft_include_source_ips_in_routing_handler() {
    local section="$1"
    local connection_type fully_routed_ips

    config_get connection_type "$section" "connection_type"
    case "$connection_type" in
    proxy | full_proxy | full_proxy_bypass_ru) ;;
    *) return 0 ;;
    esac

    config_get fully_routed_ips "$section" "fully_routed_ips"
    [ -n "$fully_routed_ips" ] || return 0

    config_list_foreach "$section" "fully_routed_ips" nft_list_all_traffic_from_ip
}

nft_include_full_proxy_bypass_ru_source_ips_handler() {
    local section="$1"
    local connection_type bypass_ru_routed_ips

    config_get connection_type "$section" "connection_type"
    [ "$connection_type" = "full_proxy_bypass_ru" ] || return 0

    config_get bypass_ru_routed_ips "$section" "bypass_ru_routed_ips"
    [ -n "$bypass_ru_routed_ips" ] || return 0

    config_list_foreach "$section" "bypass_ru_routed_ips" nft_list_all_traffic_from_ip
}

nft_list_all_traffic_from_ip() {
    local ip="$1"

    if ! nft list chain inet "$NFT_TABLE_NAME" mangle | grep -q "ip saddr $ip"; then
        nft insert rule inet "$NFT_TABLE_NAME" mangle iifname "@$NFT_INTERFACE_SET_NAME" ip saddr "$ip" \
            meta l4proto tcp meta mark set "$NFT_FAKEIP_MARK" counter
        nft insert rule inet "$NFT_TABLE_NAME" mangle iifname "@$NFT_INTERFACE_SET_NAME" ip saddr "$ip" \
            meta l4proto udp meta mark set "$NFT_FAKEIP_MARK" counter
        nft insert rule inet "$NFT_TABLE_NAME" mangle ip saddr "$ip" ip daddr @localv4 return
    fi
}

nft_list_all_external_traffic() {
    if ! nft list chain inet "$NFT_TABLE_NAME" mangle | grep -q "harpynet-full-vpn"; then
        nft insert rule inet "$NFT_TABLE_NAME" mangle iifname "@$NFT_INTERFACE_SET_NAME" \
            meta l4proto udp meta mark set "$NFT_FAKEIP_MARK" counter comment \"harpynet-full-vpn-udp\"
        nft insert rule inet "$NFT_TABLE_NAME" mangle iifname "@$NFT_INTERFACE_SET_NAME" \
            meta l4proto tcp meta mark set "$NFT_FAKEIP_MARK" counter comment \"harpynet-full-vpn-tcp\"
        nft insert rule inet "$NFT_TABLE_NAME" mangle iifname "@$NFT_INTERFACE_SET_NAME" ip daddr "@$NFT_LOCALV4_SET_NAME" \
            return comment \"harpynet-full-vpn-local\"
    fi
}

# Diagnotics
check_proxy() {
    local sing_box_config_path
    config_get sing_box_config_path "settings" "config_path"

    if ! command -v sing-box > /dev/null 2>&1; then
        nolog "sing-box is not installed"
        return 1
    fi

    if [ ! -f "$sing_box_config_path" ]; then
        nolog "Configuration file not found"
        return 1
    fi

    nolog "Checking sing-box configuration..."

    if ! sing-box -c "$sing_box_config_path" check > /dev/null; then
        nolog "Invalid configuration"
        return 1
    fi

    jq '
    walk(
        if type == "object" then
            with_entries(
                if .key == "uuid" then
                    .value = "MASKED"
                elif .key == "server" then
                    .value = "MASKED"
                elif .key == "server_name" then
                    .value = "MASKED"
                elif .key == "password" then
                    .value = "MASKED"
                elif .key == "public_key" then
                    .value = "MASKED"
                elif .key == "short_id" then
                    .value = "MASKED"
                elif .key == "fingerprint" then
                    .value = "MASKED"
                elif .key == "server_port" then
                    .value = "MASKED"
                else . end
            )
        else . end
    )' "$sing_box_config_path"

    nolog "Checking proxy connection..."

    local latency_response latency_value
    latency_response="$(clash_api get_group_latency main-out 8000 2> /dev/null)"
    latency_value="$(echo "$latency_response" | jq -r '[.[]? | select(type == "number")][0] // empty' 2> /dev/null)"
    if [ -n "$latency_value" ]; then
        nolog "Proxy latency: ${latency_value}ms"
        return 0
    fi

    for attempt in $(seq 1 5); do
        response=$(sing-box tools fetch ifconfig.me -D /etc/sing-box --outbound main-out 2> /dev/null)
        if echo "$response" | grep -q "^<html\|403 Forbidden"; then
            continue
        fi
        if echo "$response" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$'; then
            ip=$(echo "$response" | sed -n 's/^[0-9]\+\.[0-9]\+\.[0-9]\+\.\([0-9]\+\)$/X.X.X.\1/p')
            nolog "$ip - should match proxy IP"
            return 0
        elif echo "$response" | grep -q "^[0-9a-fA-F:]*::[0-9a-fA-F:]*$\|^[0-9a-fA-F:]\+$"; then
            ip=$(echo "$response" | sed 's/\([0-9a-fA-F]\+:[0-9a-fA-F]\+:[0-9a-fA-F]\+\):.*/\1:XXXX:XXXX:XXXX/')
            nolog "$ip - should match proxy IP"
            return 0
        fi
        if [ $attempt -eq 5 ]; then
            nolog "Failed to get valid IP address after 5 attempts"
            if [ -z "$response" ]; then
                nolog "Error: Empty response"
            else
                nolog "Error response: $response"
            fi
            return 1
        fi
    done
}

check_nft() {
    if ! command -v nft > /dev/null 2>&1; then
        nolog "nft is not installed"
        return 1
    fi

    nolog "Checking $NFT_TABLE_NAME rules..."

    # Check if table exists
    if ! nft list table inet "$NFT_TABLE_NAME" > /dev/null 2>&1; then
        nolog "вќЊ $NFT_TABLE_NAME not found"
        return 1
    fi

    local found_hetzner=0
    local found_ovh=0

    check_domain_list_contains() {
        local section="$1"

        config_get_bool domain_list_enabled "$section" "domain_list_enabled" "0"
        if [ "$domain_list_enabled" -eq 1 ]; then
            config_list_foreach "$section" "domain_list" check_domain_value
        fi
    }

    check_domain_value() {
        local domain_value="$1"

        if [ "$domain_value" = "hetzner" ]; then
            found_hetzner=1
        elif [ "$domain_value" = "ovh" ]; then
            found_ovh=1
        fi
    }

    config_foreach check_domain_list_contains

    if [ "$found_hetzner" -eq 1 ] || [ "$found_ovh" -eq 1 ]; then

        local sets="harpynet_subnets harpynet_domains interfaces harpynet_discord_subnets localv4"

        nolog "Sets statistics:"
        for set_name in $sets; do
            if nft list set inet "$NFT_TABLE_NAME" $set_name > /dev/null 2>&1; then
                # Count elements using grep to count commas and add 1 (last element has no comma)
                local count=$(nft list set inet "$NFT_TABLE_NAME" $set_name 2> /dev/null | grep -o ',\|{' | wc -l)
                echo "- $set_name: $count elements"
            fi
        done

        nolog "Chain configurations:"

        # Create a temporary file for processing
        local tmp_file=$(mktemp)
        nft list table inet "$NFT_TABLE_NAME" > "$tmp_file"

        # Extract chain configurations without element listings
        sed -n '/chain mangle {/,/}/p' "$tmp_file" | grep -v "elements" | grep -v "^[[:space:]]*[0-9]"
        sed -n '/chain proxy {/,/}/p' "$tmp_file" | grep -v "elements" | grep -v "^[[:space:]]*[0-9]"

        # Clean up
        rm -f "$tmp_file"
    else
        # Simple view as originally implemented
        nolog "Sets configuration:"
        nft list table inet "$NFT_TABLE_NAME"
    fi

    nolog "NFT check completed"
}

check_logs() {
    if ! command -v logread > /dev/null 2>&1; then
        nolog "Error: logread command not found"
        return 1
    fi

    local logs
    logs=$(logread | grep -E "harpynet|sing-box")

    if [ -z "$logs" ]; then
        nolog "Logs not found"
        return 1
    fi

    # Find the last occurrence of "Starting harpynet"
    local start_line
    start_line=$(echo "$logs" | grep -n "harpynet.*Starting harpynet" | tail -n 1 | cut -d: -f1)

    if [ -n "$start_line" ]; then
        echo "$logs" | tail -n +"$start_line"
    else
        nolog "No 'Starting harpynet' message found, showing last 100 lines"
        echo "$logs" | tail -n 100
    fi
}

get_subscription_cache() {
    local section="$1"
    local cache_file

    if ! echo "$section" | grep -Eq '^[A-Za-z0-9_-]+$'; then
        echo "{}"
        return 0
    fi

    for cache_file in "/var/run/harpynet/subscription-$section.links" "/etc/harpynet/subscription-cache/subscription-$section.links"; do
        [ -s "$cache_file" ] && break
        cache_file=""
    done

    [ -n "$cache_file" ] || {
        echo "{}"
        return 0
    }

    jq -Rn '
        reduce inputs as $line (
            {};
            ($line | split("\t")) as $item |
            if (($item[0] // "") != "" and ($item[1] // "") != "") then
                .[$item[0]] = $item[1]
            else
                .
            end
        )
    ' < "$cache_file"
}

get_subscription_metadata() {
    local section="$1"
    local metadata_file="/var/run/harpynet/subscription-$section.meta.json"

    if ! echo "$section" | grep -Eq '^[A-Za-z0-9_-]+$'; then
        echo "{}"
        return 0
    fi

    if [ ! -s "$metadata_file" ]; then
        echo "{}"
        return 0
    fi

    jq . "$metadata_file" 2>/dev/null || echo "{}"
}

save_subscription_url() {
    local section="$1"
    local subscription_url="$2"
    local value_encoding="${3:-plain}"
    local saved_url connection_type

    [ -n "$section" ] || section="$(get_first_proxy_section_name)"

    if [ -z "$section" ] || ! echo "$section" | grep -Eq '^[A-Za-z0-9_-]+$'; then
        jq -n '{success:false,error:"invalid_section"}'
        return 1
    fi

    if [ "$value_encoding" = "base64" ]; then
        subscription_url="$(printf '%s' "$subscription_url" | base64 -d 2>/dev/null)" || {
            jq -n '{success:false,error:"invalid_subscription_encoding"}'
            return 1
        }
    fi

    case "$subscription_url" in
    http://* | https://*) ;;
    *)
        jq -n '{success:false,error:"invalid_subscription_url"}'
        return 1
        ;;
    esac

    uci set "harpynet.$section.proxy_config_type=subscription"
    uci set "harpynet.$section.subscription_url=$subscription_url"
    connection_type="$(uci -q get "harpynet.$section.connection_type")"
    if [ -z "$connection_type" ] || [ "$connection_type" = "exclusion" ]; then
        uci set "harpynet.$section.connection_type=proxy"
    fi
    uci -q delete "harpynet.$section.telegram_router_token"
    uci -q delete "harpynet.$section.telegram_pair_code"
    uci -q delete "harpynet.$section.telegram_api_base"
    uci -q delete "harpynet.$section.telegram_device_id"
    uci commit harpynet

    saved_url="$(uci -q get "harpynet.$section.subscription_url")"
    if [ "$saved_url" != "$subscription_url" ]; then
        jq -n '{success:false,error:"subscription_save_verify_failed"}'
        return 1
    fi

    /usr/bin/harpynet restart_background >/dev/null 2>&1 || true

    jq -n --arg section "$section" '{success:true,section:$section,restart_started:true}'
}

