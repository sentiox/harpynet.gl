    local sing_box_config_path
    config_get sing_box_config_path "settings" "config_path"
    nolog "Current sing-box configuration:"

    if [ ! -f "$sing_box_config_path" ]; then
        nolog "Configuration file not found"
        return 1
    fi

    jq '
    walk(
        if type == "object" then
            with_entries(
                if .key == "uuid" then
                    .value = "MASKED"
                elif .key == "server" then
                    .value = "MASKED"
                elif .key == "server_name" then
                    .value = "MASKED"
                elif .key == "password" then
                    .value = "MASKED"
                elif .key == "public_key" then
                    .value = "MASKED"
                elif .key == "short_id" then
                    .value = "MASKED"
                elif .key == "fingerprint" then
                    .value = "MASKED"
                elif .key == "server_port" then
                    .value = "MASKED"
                else . end
            )
        else . end
    )' "$sing_box_config_path"
}

show_config() {
    if [ ! -f "$HARPYNET_CONFIG" ]; then
        nolog "Configuration file not found"
        return 1
    fi

    tmp_config=$(mktemp)

    sed -e 's/\(option subscription_url\).*/\1 '\''MASKED'\''/g' \
        -e "s@\\(option dns_server '[^/]*\\)/[^']*'@\\1/MASKED'@g" \
        -e "s@\\(option domain_resolver_dns_server '[^/]*\\)/[^']*'@\\1/MASKED'@g" \
        -e 's/\(option yacd_secret_key\).*/\1 '\''MASKED'\''/g' \
        -e 's/\(option support_token\).*/\1 '\''MASKED'\''/g' \
        "$HARPYNET_CONFIG" > "$tmp_config"

    cat "$tmp_config"
    rm -f "$tmp_config"
}

show_version() {
    echo "$HARPYNET_VERSION"
}

show_sing_box_version() {
    local version
    version=$(sing-box version | head -n 1 | awk '{print $3}')
    echo "$version"
}

show_system_info() {
    echo "=== OpenWrt Version ==="
    grep OPENWRT_RELEASE /etc/os-release | cut -d'"' -f2
    echo
    echo "=== Device Model ==="
    cat /tmp/sysinfo/model
}

get_system_info() {
    local harpynet_version harpynet_latest_version luci_app_version sing_box_version openwrt_version device_model

    harpynet_version="$HARPYNET_VERSION"

    harpynet_latest_version=$(curl -m 3 -s "$HARPYNET_RELEASE_API" | grep '"tag_name":' | cut -d'"' -f4)
    [ -z "$harpynet_latest_version" ] && harpynet_latest_version="unknown"

    if [ -f /www/luci-static/resources/view/harpynet/main.js ]; then
        luci_app_version=$(grep 'var HARPYNET_LUCI_APP_VERSION' /www/luci-static/resources/view/harpynet/main.js | cut -d'"' -f2)
    else
        luci_app_version="not installed"
    fi

    if command -v sing-box > /dev/null 2>&1; then
        sing_box_version=$(sing-box version 2> /dev/null | head -n 1 | awk '{print $3}')
        [ -z "$sing_box_version" ] && sing_box_version="unknown"
    else
        sing_box_version="not installed"
    fi

    if [ -f /etc/os-release ]; then
        openwrt_version=$(grep OPENWRT_RELEASE /etc/os-release | cut -d'"' -f2)
        [ -z "$openwrt_version" ] && openwrt_version="unknown"
    else
        openwrt_version="unknown"
    fi

    if [ -f /tmp/sysinfo/model ]; then
        device_model=$(cat /tmp/sysinfo/model)
        [ -z "$device_model" ] && device_model="unknown"
    else
        device_model="unknown"
    fi

    echo "{\"harpynet_version\": \"$harpynet_version\", \"harpynet_latest_version\": \"$harpynet_latest_version\", \"luci_app_version\": \"$luci_app_version\", \"sing_box_version\": \"$sing_box_version\", \"openwrt_version\": \"$openwrt_version\", \"device_model\": \"$device_model\"}" | jq .
}

normalize_release_version() {
    printf '%s' "${1:-}" | sed -e 's/^v//' -e 's/[^0-9.].*$//'
}

version_is_newer() {
    local latest current
    latest="$(normalize_release_version "$1")"
    current="$(normalize_release_version "$2")"

    awk -v latest="$latest" -v current="$current" '
        BEGIN {
            split(latest, l, "."); split(current, c, ".");
            for (i = 1; i <= 4; i++) {
                lv = (l[i] == "" ? 0 : l[i]) + 0;
                cv = (c[i] == "" ? 0 : c[i]) + 0;
                if (lv > cv) exit 0;
                if (lv < cv) exit 1;
            }
            exit 1;
        }
    '
}

fetch_harpynet_latest_release() {
    local release_api="$HARPYNET_RELEASE_API"

    if command -v curl >/dev/null 2>&1; then
        curl -fsSL --connect-timeout 6 --max-time 15 "$release_api" 2>/dev/null && return 0
    fi

    if command -v wget >/dev/null 2>&1; then
        wget -qO- "$release_api" 2>/dev/null && return 0
    fi

    return 1
}

get_package_extension() {
    if command -v apk >/dev/null 2>&1; then
        printf 'apk'
    else
        printf 'ipk'
    fi
}

get_update_status() {
    local release_json latest_tag current_version release_url release_name release_notes published_at extension assets_json update_available package_assets

    current_version="$HARPYNET_VERSION"
    extension="$(get_package_extension)"
    release_json="$(fetch_harpynet_latest_release)"

    if [ -z "$release_json" ]; then
        jq -n \
            --arg current_version "$current_version" \
            --arg package_extension "$extension" \
            '{success:false,current_version:$current_version,latest_version:"unknown",update_available:false,package_extension:$package_extension,error:"release_check_failed"}'
        return 1
    fi

    latest_tag="$(printf '%s' "$release_json" | jq -r '.tag_name // empty' 2>/dev/null)"
    release_url="$(printf '%s' "$release_json" | jq -r '.html_url // empty' 2>/dev/null)"
    release_name="$(printf '%s' "$release_json" | jq -r '.name // empty' 2>/dev/null)"
    release_notes="$(printf '%s' "$release_json" | jq -r '.body // empty' 2>/dev/null)"
    published_at="$(printf '%s' "$release_json" | jq -r '.published_at // empty' 2>/dev/null)"
    [ -n "$release_url" ] || release_url="$HARPYNET_RELEASE_URL"
    [ -n "$latest_tag" ] || latest_tag="unknown"

    assets_json="$(
        printf '%s' "$release_json" | jq -c '[.assets[]? | {name:(.name // ""), url:(.browser_download_url // "")}]' 2>/dev/null
    )"
    [ -n "$assets_json" ] || assets_json="[]"
    package_assets="$(
        printf '%s' "$assets_json" | jq --arg ext ".$extension" \
            '[.[] | select((.name | index("harpynet")) and (.name | endswith($ext)))] | length' 2>/dev/null
    )"
    case "$package_assets" in ''|*[!0-9]*) package_assets=0 ;; esac

    update_available=false
    if [ "$latest_tag" != "unknown" ] && version_is_newer "$latest_tag" "$current_version"; then
        update_available=true
    fi

    jq -n \
        --arg current_version "$current_version" \
        --arg latest_version "$latest_tag" \
        --arg release_url "$release_url" \
        --arg release_name "$release_name" \
        --arg release_notes "$release_notes" \
        --arg published_at "$published_at" \
        --arg package_extension "$extension" \
        --argjson update_available "$update_available" \
        --argjson package_assets "$package_assets" \
        --argjson assets "$assets_json" \
        '{
            success:true,
            current_version:$current_version,
            latest_version:$latest_version,
            update_available:$update_available,
            release_url:$release_url,
            release_name:$release_name,
            release_notes:$release_notes,
            published_at:$published_at,
            package_extension:$package_extension,
            package_assets:$package_assets,
            assets:$assets
        }'
}

write_self_update_state() {
    local success="$1"
    local running="$2"
    local message="$3"
    local current_version="${4:-$HARPYNET_VERSION}"
    local latest_version="${5:-}"
    local error="${6:-}"
    local state_file="/tmp/harpynet-self-update.json"

    jq -n \
        --argjson success "$success" \
        --argjson running "$running" \
        --arg message "$message" \
        --arg current_version "$current_version" \
        --arg latest_version "$latest_version" \
        --arg error "$error" \
        --arg updated_at "$(date '+%Y-%m-%d %H:%M:%S' 2>/dev/null)" \
        '{
            success:$success,
            running:$running,
            message:$message,
            current_version:$current_version,
            latest_version:$latest_version,
            error:$error,
            updated_at:$updated_at
        }' > "$state_file"
}

self_update_download() {
    local url="$1"
    local output="$2"

    if command -v curl >/dev/null 2>&1; then
        curl -fL --connect-timeout 10 --max-time 90 -o "$output" "$url" 2>/dev/null && return 0
    fi

    if command -v wget >/dev/null 2>&1; then
        wget -q -O "$output" "$url" 2>/dev/null && return 0
    fi

    return 1
}

self_update_install_package() {
    local file="$1"

    if command -v apk >/dev/null 2>&1; then
        apk add --allow-untrusted "$file"
    else
        opkg install --force-overwrite "$file"
    fi
}

self_update_run() {
    local release_json status_json latest_version extension tmp_dir backup_dir backup_file urls url file name install_status

    write_self_update_state true true "Проверяю свежий релиз..."
    status_json="$(get_update_status 2>/dev/null)"
    latest_version="$(printf '%s' "$status_json" | jq -r '.latest_version // empty' 2>/dev/null)"
    extension="$(printf '%s' "$status_json" | jq -r '.package_extension // empty' 2>/dev/null)"
    [ -n "$extension" ] || extension="$(get_package_extension)"

    if ! printf '%s' "$status_json" | jq -e '.success == true' >/dev/null 2>&1; then
        write_self_update_state false false "Не получилось проверить релиз" "$HARPYNET_VERSION" "$latest_version" "release_check_failed"
        return 1
    fi

    release_json="$(fetch_harpynet_latest_release)"
    urls="$(
        printf '%s' "$release_json" | jq -r --arg ext ".$extension" '
            .assets[]?
            | select(((.name | startswith("harpynet")) or (.name | startswith("luci-app-harpynet")) or (.name | startswith("luci-i18n-harpynet-ru"))) and (.name | endswith($ext)))
            | .browser_download_url
        ' 2>/dev/null
    )"

    if [ -z "$urls" ]; then
        write_self_update_state false false "В релизе нет подходящих пакетов .$extension" "$HARPYNET_VERSION" "$latest_version" "release_assets_missing"
        return 1
    fi

    tmp_dir="$(mktemp -d /tmp/harpynet-update.XXXXXX 2>/dev/null || true)"
    [ -n "$tmp_dir" ] || tmp_dir="/tmp/harpynet-update.$$"
    mkdir -p "$tmp_dir" || {
        write_self_update_state false false "Не удалось создать временную папку" "$HARPYNET_VERSION" "$latest_version" "tmp_dir_failed"
        return 1
    }

    backup_dir="/etc/harpynet/update-backups"
    mkdir -p "$backup_dir"
    backup_file="$backup_dir/harpynet-$(date '+%Y%m%d-%H%M%S' 2>/dev/null).config"
    if [ -f "$HARPYNET_CONFIG" ]; then
        cp "$HARPYNET_CONFIG" "$backup_file" 2>/dev/null || true
    fi

    for url in $urls; do
        name="${url##*/}"
        file="$tmp_dir/$name"
        write_self_update_state true true "Скачиваю $name..." "$HARPYNET_VERSION" "$latest_version"
        if ! self_update_download "$url" "$file" || [ ! -s "$file" ]; then
            rm -rf "$tmp_dir"
            write_self_update_state false false "Не удалось скачать $name" "$HARPYNET_VERSION" "$latest_version" "download_failed"
            return 1
        fi
    done

    install_status=0
    for file in "$tmp_dir"/harpynet*."$extension" "$tmp_dir"/luci-app-harpynet*."$extension" "$tmp_dir"/luci-i18n-harpynet-ru*."$extension"; do
        [ -f "$file" ] || continue
        write_self_update_state true true "Устанавливаю ${file##*/}..." "$HARPYNET_VERSION" "$latest_version"
        self_update_install_package "$file" || install_status=1
    done

    rm -rf "$tmp_dir"

    if [ "$install_status" -ne 0 ]; then
        write_self_update_state false false "Установка пакетов завершилась с ошибкой" "$HARPYNET_VERSION" "$latest_version" "install_failed"
        return 1
    fi

    rm -f /tmp/luci-indexcache 2>/dev/null
    rm -rf /tmp/luci-modulecache/* 2>/dev/null
    /usr/bin/harpynet restart_background >/dev/null 2>&1 || true
    /usr/bin/harpynet support_after_update main >/dev/null 2>&1 || true

    write_self_update_state true false "Обновление установлено. Конфиг сохранён, бэкап: $backup_file" "$HARPYNET_VERSION" "$latest_version"
    ( sleep 2; /etc/init.d/rpcd restart >/dev/null 2>&1 ) >/dev/null 2>&1 &
}

self_update_start() {
    local state_file="/tmp/harpynet-self-update.json"
    local pid_file="/var/run/harpynet_self_update.pid"

    if [ -f "$pid_file" ]; then
        local pid
        pid="$(cat "$pid_file" 2>/dev/null)"
        if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
            jq -n '{success:true,running:true,message:"Обновление уже выполняется"}'
            return 0
        fi
    fi

    write_self_update_state true true "Стартую обновление..."
    (
        self_update_run
        rm -f "$pid_file"
    ) >/dev/null 2>&1 </dev/null &
    echo $! > "$pid_file"

    cat "$state_file"
}

self_update_status() {
    local state_file="/tmp/harpynet-self-update.json"
    local pid_file="/var/run/harpynet_self_update.pid"

    if [ -f "$pid_file" ]; then
        local pid
        pid="$(cat "$pid_file" 2>/dev/null)"
        if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
            if [ -s "$state_file" ]; then
                jq '.running = true' "$state_file"
            else
                jq -n '{success:true,running:true,message:"Обновление выполняется"}'
            fi
            return 0
        fi
        rm -f "$pid_file"
    fi

    if [ -s "$state_file" ]; then
        jq '.running = false' "$state_file"
    else
        jq -n '{success:true,running:false,message:"Обновление ещё не запускалось"}'
    fi
}

get_sing_box_status() {
    local running=0
    local enabled=0
    local status=""
    local version=""
    local dns_configured=0

    # Check if service is enabled
    if [ -x /etc/rc.d/S99sing-box ]; then
        enabled=1
    fi

    # Check if service is running
    if pgrep -f "sing-box" > /dev/null; then
        running=1
        version=$(sing-box version | head -n 1 | awk '{print $3}')
    fi

    # Check DNS configuration
    local dns_server
    dns_server=$(uci get dhcp.@dnsmasq[0].server 2> /dev/null)
    if [ "$dns_server" = "127.0.0.42" ]; then
        dns_configured=1
    fi

    # Format status message
    if [ $running -eq 1 ]; then
        if [ $enabled -eq 1 ]; then
            status="running & enabled"
        else
            status="running but disabled"
        fi
    else
        if [ $enabled -eq 1 ]; then
            status="stopped but enabled"
        else
            status="stopped & disabled"
        fi
    fi

    echo "{\"running\":$running,\"enabled\":$enabled,\"status\":\"$status\",\"dns_configured\":$dns_configured}"
}

get_status() {
    local enabled=0
    local status=""

    # Check if service is enabled
    if [ -x /etc/rc.d/S99harpynet ]; then
        enabled=1
        status="enabled"
    else
        status="disabled"
    fi

    echo "{\"enabled\":$enabled,\"status\":\"$status\"}"
}

check_dns_available() {
    local dns_type dns_server bootstrap_dns_server
    config_get dns_type "settings" "dns_type"
    config_get dns_server "settings" "dns_server"
    config_get bootstrap_dns_server "settings" "bootstrap_dns_server"

    local dns_status=0
    local dns_on_router=0
    local bootstrap_dns_status=0
    local dhcp_config_status=1
    local domain="google.com"

    # Mask NextDNS ID if present
    local display_dns_server="$dns_server"
    if echo "$dns_server" | grep -q "\.dns\.nextdns\.io$"; then
        local nextdns_id
        nextdns_id=$(echo "$dns_server" | cut -d'.' -f1)
        display_dns_server="$(echo "$nextdns_id" | sed 's/./*/g').dns.nextdns.io"
    elif echo "$dns_server" | grep -q "^dns\.nextdns\.io/"; then
        local masked_path
        masked_path=$(echo "$dns_server" | cut -d'/' -f2- | sed 's/./*/g')
        display_dns_server="dns.nextdns.io/$masked_path"
    fi

    if [ "$dns_type" = "doh" ]; then
        # Check if dns_server already contains a path
        local doh_path="/dns-query"
        if echo "$dns_server" | grep -q "/"; then
            # Path is already present, extract it
            doh_path="/$(echo "$dns_server" | cut -d'/' -f2-)"
            dns_server="$(echo "$dns_server" | cut -d'/' -f1)"
        fi

        if dig @"$dns_server" "$domain" +https="$doh_path" +timeout=2 +tries=1 > /dev/null 2>&1; then
            dns_status=1
        fi
    elif [ "$dns_type" = "dot" ]; then
        if dig @"$dns_server" "$domain" +tls +timeout=2 +tries=1 > /dev/null 2>&1; then
            dns_status=1
        fi
    elif [ "$dns_type" = "udp" ]; then
        if dig @"$dns_server" "$domain" +timeout=2 +tries=1 > /dev/null 2>&1; then
            dns_status=1
        fi
    fi

    # Check if local DNS resolver is working
    if dig @127.0.0.1 "$domain" +timeout=2 +tries=1 > /dev/null 2>&1; then
        dns_on_router=1
    fi

    # Check bootstrap DNS server
    if [ -n "$bootstrap_dns_server" ]; then
        if dig @"$bootstrap_dns_server" "$domain" +timeout=2 +tries=1 > /dev/null 2>&1; then
            bootstrap_dns_status=1
        fi
    fi

    # Check if /etc/config/dhcp has server 127.0.0.42
    config_load dhcp
    config_foreach check_dhcp_has_harpynet_dns dnsmasq
    config_load "$HARPYNET_CONFIG"

    echo "{\"dns_type\":\"$dns_type\",\"dns_server\":\"$display_dns_server\",\"dns_status\":$dns_status,\"dns_on_router\":$dns_on_router,\"bootstrap_dns_server\":\"$bootstrap_dns_server\",\"bootstrap_dns_status\":$bootstrap_dns_status,\"dhcp_config_status\":$dhcp_config_status}" | jq .
}

check_dhcp_has_harpynet_dns() {
    local server_list cachesize noresolv server_found
    config_get server_list "$1" "server"
    config_get cachesize "$1" "cachesize"
    config_get noresolv "$1" "noresolv"

    server_found=0

    if [ -n "$server_list" ]; then
        for server in $server_list; do
            if [ "$server" = "127.0.0.42" ]; then
                server_found=1
                break
            fi
        done
    fi

    if [ "$cachesize" != "0" ] || [ "$noresolv" != "1" ] || [ "$server_found" != "1" ]; then
        dhcp_config_status=0
    fi
}

check_nft_rules() {
    local table_exist=0
    local rules_mangle_exist=0
    local rules_mangle_counters=0
    local rules_mangle_output_exist=0
    local rules_mangle_output_counters=0
    local rules_proxy_exist=0
    local rules_proxy_counters=0
    local rules_other_mark_exist=0

    # Generate traffic through HarpyNetTable
    curl -m 3 -s "https://$CHECK_PROXY_IP_DOMAIN/check" > /dev/null 2>&1 &
    local pid1=$!
    curl -m 3 -s "https://$FAKEIP_TEST_DOMAIN/check" > /dev/null 2>&1 &
    local pid2=$!

    wait $pid1 2> /dev/null
    wait $pid2 2> /dev/null
    sleep 1

    # Check if HarpyNetTable exists
    if nft list table inet "$NFT_TABLE_NAME" > /dev/null 2>&1; then
        table_exist=1

        # Check mangle chain rules
        if nft list chain inet "$NFT_TABLE_NAME" mangle > /dev/null 2>&1; then
            local mangle_output
            mangle_output=$(nft list chain inet "$NFT_TABLE_NAME" mangle)
            if echo "$mangle_output" | grep -q "counter"; then
                rules_mangle_exist=1

                if echo "$mangle_output" | grep "counter" | grep -qv "packets 0 bytes 0"; then
                    rules_mangle_counters=1
                fi
            fi
        fi

        # Check mangle_output chain rules
        if nft list chain inet "$NFT_TABLE_NAME" mangle_output > /dev/null 2>&1; then
            local mangle_output_output
            mangle_output_output=$(nft list chain inet "$NFT_TABLE_NAME" mangle_output)
            if echo "$mangle_output_output" | grep -q "counter"; then
                rules_mangle_output_exist=1

                if echo "$mangle_output_output" | grep "counter" | grep -qv "packets 0 bytes 0"; then
                    rules_mangle_output_counters=1
                fi
            fi
        fi

        # Check proxy chain rules
        if nft list chain inet "$NFT_TABLE_NAME" proxy > /dev/null 2>&1; then
            local proxy_output
            proxy_output=$(nft list chain inet "$NFT_TABLE_NAME" proxy)
            if echo "$proxy_output" | grep -q "counter"; then
                rules_proxy_exist=1

                if echo "$proxy_output" | grep "counter" | grep -qv "packets 0 bytes 0"; then
                    rules_proxy_counters=1
                fi
            fi
        fi
    fi

    # Check for other mark rules outside HarpyNetTable
    nft list tables 2> /dev/null | while read -r _ family table_name; do
        [ -z "$table_name" ] && continue

        [ "$table_name" = "$NFT_TABLE_NAME" ] && continue

        if nft list table "$family" "$table_name" 2> /dev/null | grep -q "meta mark set"; then
            touch /tmp/harpynet_mark_check.$$
            break
        fi
    done

    if [ -f /tmp/harpynet_mark_check.$$ ]; then
        rules_other_mark_exist=1
        rm -f /tmp/harpynet_mark_check.$$
    fi

    echo "{\"table_exist\":$table_exist,\"rules_mangle_exist\":$rules_mangle_exist,\"rules_mangle_counters\":$rules_mangle_counters,\"rules_mangle_output_exist\":$rules_mangle_output_exist,\"rules_mangle_output_counters\":$rules_mangle_output_counters,\"rules_proxy_exist\":$rules_proxy_exist,\"rules_proxy_counters\":$rules_proxy_counters,\"rules_other_mark_exist\":$rules_other_mark_exist}" | jq .
}

check_sing_box() {
    local sing_box_installed=0
    local sing_box_version_ok=0
    local sing_box_service_exist=0
    local sing_box_autostart_disabled=0
    local sing_box_process_running=0
    local sing_box_ports_listening=0

    # Check if sing-box is installed
    if command -v sing-box > /dev/null 2>&1; then
        sing_box_installed=1

        # Check version (must be >= 1.12.4)
        local version
        version=$(sing-box version 2> /dev/null | head -n 1 | awk '{print $3}')
        if [ -n "$version" ]; then
            version=$(echo "$version" | sed 's/^v//')
            local major
            local minor
            local patch
            major=$(echo "$version" | cut -d. -f1)
            minor=$(echo "$version" | cut -d. -f2)
            patch=$(echo "$version" | cut -d. -f3)

            # Compare version: must be >= 1.12.4
            if [ "$major" -gt 1 ] ||
                [ "$major" -eq 1 ] && [ "$minor" -gt 12 ] ||
                [ "$major" -eq 1 ] && [ "$minor" -eq 12 ] && [ "$patch" -ge 4 ]; then
                sing_box_version_ok=1
            fi
        fi
    fi

    # Check if service exists
    if [ -f /etc/init.d/sing-box ]; then
        sing_box_service_exist=1

        if ! /etc/init.d/sing-box enabled 2> /dev/null; then
            sing_box_autostart_disabled=1
        fi
    fi

    # Check if process is running
    if pgrep "sing-box" > /dev/null 2>&1; then
        sing_box_process_running=1
    fi

    # Check if sing-box is listening on required ports
    local port_53_ok=0
    local port_1602_ok=0

    if netstat -ln 2> /dev/null | grep -q "127.0.0.42:53"; then
        port_53_ok=1
    fi

    if netstat -ln 2> /dev/null | grep -q "127.0.0.1:1602"; then
        port_1602_ok=1
    fi

    # Both ports must be listening
    if [ "$port_53_ok" = "1" ] && [ "$port_1602_ok" = "1" ]; then
        sing_box_ports_listening=1
    fi

    echo "{\"sing_box_installed\":$sing_box_installed,\"sing_box_version_ok\":$sing_box_version_ok,\"sing_box_service_exist\":$sing_box_service_exist,\"sing_box_autostart_disabled\":$sing_box_autostart_disabled,\"sing_box_process_running\":$sing_box_process_running,\"sing_box_ports_listening\":$sing_box_ports_listening}" | jq .
}

check_fakeip() {
    curl -m 3 -s "https://$FAKEIP_TEST_DOMAIN/check" | jq .
}

#######################################
# Clash API interface for managing proxies and groups
# Arguments:
#   $1 - Action: get_proxies, get_connections, get_proxy_latency, get_group_latency, set_group_proxy,
#        close_connection, close_all_connections
#   $2 - Proxy/Group tag (required for latency and set operations)
#   $3 - Timeout in ms (optional, defaults: 2000 for proxy, 5000 for group) or target proxy tag for set_group_proxy
# Outputs:
#   JSON formatted response
# Usage:
#   clash_api get_proxies
#   clash_api get_connections
#   clash_api get_proxy_latency <proxy_tag> [timeout]
#   clash_api get_group_latency <group_tag> [timeout]
#   clash_api set_group_proxy <group_tag> <proxy_tag>
#   clash_api close_connection <connection_id>
#   clash_api close_all_connections
#######################################

clash_api_urlencode_path_segment() {
    jq -nr --arg v "$1" '$v|@uri'
}

clash_api() {
    local action="$1"
    local clash_api_controller_address CLASH_URL TEST_URL
    clash_api_controller_address="$(get_service_listen_address)"
    if [ -z "$clash_api_controller_address" ]; then
        clash_api_controller_address="127.0.0.1"
    fi
    CLASH_URL="$clash_api_controller_address:$SB_CLASH_API_CONTROLLER_PORT"
    TEST_URL="https://www.gstatic.com/generate_204"

    local enable_yacd_wan_access yacd_secret_key auth_header
    config_get_bool enable_yacd_wan_access "settings" "enable_yacd_wan_access" 0
    config_get yacd_secret_key "settings" "yacd_secret_key"

    if [ "$enable_yacd_wan_access" -eq 1 ]; then
        auth_header="Authorization: Bearer $yacd_secret_key"
    else
        auth_header=""
    fi

    case "$action" in
    get_proxies)
        curl -s --header "$auth_header" "$CLASH_URL/proxies" | jq .
        ;;

    get_connections)
        curl -s --header "$auth_header" "$CLASH_URL/connections" | jq .
        ;;

    get_proxy_latency)
        local proxy_tag="$2"
        local timeout="${3:-2000}"

        if [ -z "$proxy_tag" ]; then
            echo '{"error":"proxy_tag required"}' | jq .
            return 1
        fi

        curl -G -s "$CLASH_URL/proxies/$proxy_tag/delay" \
            --header "$auth_header" \
            --data-urlencode "url=$TEST_URL" \
            --data-urlencode "timeout=$timeout" | jq .
        ;;

    get_group_latency)
        local group_tag="$2"
        local timeout="${3:-5000}"

        if [ -z "$group_tag" ]; then
            echo '{"error":"group_tag required"}' | jq .
            return 1
        fi

        curl -G -s "$CLASH_URL/group/$group_tag/delay" \
            --header "$auth_header" \
            --data-urlencode "url=$TEST_URL" \
            --data-urlencode "timeout=$timeout" | jq .
        ;;

    set_group_proxy)
        local group_tag="$2"
        local proxy_tag="$3"

        if [ -z "$group_tag" ] || [ -z "$proxy_tag" ]; then
            echo '{"error":"group_tag and proxy_tag required"}' | jq .
            return 1
        fi

        local response
        response=$(
            curl -X PUT -s -w "\n%{http_code}" "$CLASH_URL/proxies/$group_tag" \
                --header "$auth_header" \
                --data-raw "{\"name\":\"$proxy_tag\"}"
        )

        local http_code
        local body
        http_code=$(echo "$response" | tail -n 1)
        body=$(echo "$response" | sed '$d')

        case "$http_code" in
        204)
            local section_name
            section_name="${group_tag%-out}"
            if [ "$section_name" != "$group_tag" ] &&
                uci -q get "harpynet.$section_name" >/dev/null 2>&1; then
                uci set "harpynet.$section_name.selected_outbound=$proxy_tag"
                uci commit harpynet
                log "Saved selected outbound for '$section_name': $proxy_tag" "info"
            fi
            echo "{\"success\":true,\"group\":\"$group_tag\",\"proxy\":\"$proxy_tag\"}" | jq .
            ;;
        404)
            echo "{\"success\":false,\"error\":\"group_not_found\",\"message\":\"$group_tag does not exist\"}" | jq .
            return 1
            ;;
        400)
            if echo "$body" | grep -q "not found"; then
                echo "{\"success\":false,\"error\":\"proxy_not_found\",\"message\":\"$proxy_tag not found in group $group_tag\"}" | jq .
            else
                echo '{"success":false,"error":"bad_request","message":"Invalid request"}' | jq .
            fi
            return 1
            ;;
        *)
            if [ -n "$body" ]; then
                local body_json
                body_json=$(echo "$body" | jq -c .)
                echo "{\"success\":false,\"http_code\":$http_code,\"body\":$body_json}" | jq .
            else
                echo "{\"success\":false,\"http_code\":$http_code}" | jq .
            fi
            return 1
            ;;
        esac
        ;;

    close_connection)
        local connection_id="$2"

        if [ -z "$connection_id" ]; then
            echo '{"error":"connection_id required"}' | jq .
            return 1
        fi

        local encoded_connection_id response http_code body
        encoded_connection_id="$(clash_api_urlencode_path_segment "$connection_id")" || return 1
        response=$(
            curl -X DELETE -s -w "\n%{http_code}" "$CLASH_URL/connections/$encoded_connection_id" \
                --header "$auth_header"
        )
        http_code=$(echo "$response" | tail -n 1)
        body=$(echo "$response" | sed '$d')

        case "$http_code" in
        200 | 204)
            jq -n --arg connection_id "$connection_id" '{success:true,connection_id:$connection_id}'
            ;;
        404)
            jq -n --arg connection_id "$connection_id" '{success:false,error:"connection_not_found",connection_id:$connection_id}'
            return 1
            ;;
        *)
            if [ -n "$body" ]; then
                local body_json
                body_json=$(echo "$body" | jq -c . 2>/dev/null || jq -Rn --arg body "$body" '$body')
                echo "{\"success\":false,\"http_code\":$http_code,\"body\":$body_json}" | jq .
            else
                echo "{\"success\":false,\"http_code\":$http_code}" | jq .
            fi
            return 1
            ;;
        esac
        ;;

    close_all_connections)
        local response http_code body
        response=$(
            curl -X DELETE -s -w "\n%{http_code}" "$CLASH_URL/connections" \
                --header "$auth_header"
        )
        http_code=$(echo "$response" | tail -n 1)
        body=$(echo "$response" | sed '$d')

        case "$http_code" in
        200 | 204)
            echo '{"success":true}' | jq .
            ;;
        *)
            if [ -n "$body" ]; then
                local body_json
                body_json=$(echo "$body" | jq -c . 2>/dev/null || jq -Rn --arg body "$body" '$body')
                echo "{\"success\":false,\"http_code\":$http_code,\"body\":$body_json}" | jq .
            else
                echo "{\"success\":false,\"http_code\":$http_code}" | jq .
            fi
            return 1
            ;;
        esac
        ;;

    *)
        echo '{"error":"unknown action","available":["get_proxies","get_connections","get_proxy_latency","get_group_latency","set_group_proxy","close_connection","close_all_connections"]}' | jq .
        return 1
        ;;
    esac
}

print_global() {
    local message="$1"
    echo "$message"
}

global_check() {
    local HARPYNET_LUCI_VERSION="Unknown"
    [ -n "$1" ] && HARPYNET_LUCI_VERSION="$1"

    print_global "рџ“Ў Global check run!"
    print_global "в”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓ"
    print_global "рџ› пёЏ System info"

    local system_info_json
    system_info_json=$(get_system_info)

    if [ -n "$system_info_json" ]; then
        local harpynet_version harpynet_latest_version luci_app_version sing_box_version openwrt_version device_model

        harpynet_version=$(echo "$system_info_json" | jq -r '.harpynet_version // "unknown"')
        harpynet_latest_version=$(echo "$system_info_json" | jq -r '.harpynet_latest_version // "unknown"')
        luci_app_version=$(echo "$system_info_json" | jq -r '.luci_app_version // "unknown"')
        sing_box_version=$(echo "$system_info_json" | jq -r '.sing_box_version // "unknown"')
        openwrt_version=$(echo "$system_info_json" | jq -r '.openwrt_version // "unknown"')
        device_model=$(echo "$system_info_json" | jq -r '.device_model // "unknown"')

        print_global "рџ•іпёЏ HarpyNet:        $harpynet_version (latest: $harpynet_latest_version)"
        print_global "рџ•іпёЏ LuCI App:      $luci_app_version"
        print_global "рџ“¦ Sing-box:      $sing_box_version"
        print_global "рџ›њ OpenWrt:       $openwrt_version"
        print_global "рџ›њ Device:        $device_model"
    else
        print_global "вќЊ Failed to get system info"
    fi

    print_global "в”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓ"
    print_global "вћЎпёЏ DNS status"

    local dns_check_json
    dns_check_json=$(check_dns_available)

    if [ -n "$dns_check_json" ]; then
        local dns_type dns_server dns_status dns_on_router bootstrap_dns_server bootstrap_dns_status dhcp_config_status

        dns_type=$(echo "$dns_check_json" | jq -r '.dns_type // "unknown"')
        dns_server=$(echo "$dns_check_json" | jq -r '.dns_server // "unknown"')
        dns_status=$(echo "$dns_check_json" | jq -r '.dns_status // 0')
        dns_on_router=$(echo "$dns_check_json" | jq -r '.dns_on_router // 0')
        bootstrap_dns_server=$(echo "$dns_check_json" | jq -r '.bootstrap_dns_server // ""')
        bootstrap_dns_status=$(echo "$dns_check_json" | jq -r '.bootstrap_dns_status // 0')
        dhcp_config_status=$(echo "$dns_check_json" | jq -r '.dhcp_config_status // 0')

        # Bootstrap DNS
        if [ -n "$bootstrap_dns_server" ]; then
            if [ "$bootstrap_dns_status" -eq 1 ]; then
                print_global "вњ… Bootstrap DNS: $bootstrap_dns_server"
            else
                print_global "вќЊ Bootstrap DNS: $bootstrap_dns_server"
            fi
        fi

        # DNS server status
        if [ "$dns_status" -eq 1 ]; then
            print_global "вњ… Main DNS: $dns_server [$dns_type]"
        else
            print_global "вќЊ Main DNS: $dns_server [$dns_type]"
        fi

        # DNS on router
        if [ "$dns_on_router" -eq 1 ]; then
            print_global "вњ… DNS on router"
        else
            print_global "вќЊ DNS on router"
        fi

        # DHCP configuration check
        local dont_touch_dhcp
        config_get dont_touch_dhcp "settings" "dont_touch_dhcp"

        if [ "$dont_touch_dhcp" = "1" ]; then
            print_global "вљ пёЏ dont_touch_dhcp is enabled. рџ“„ DHCP config:"
            awk '/^config /{p=($2=="dnsmasq")} p' /etc/config/dhcp
        elif [ "$dhcp_config_status" -eq 0 ]; then
            print_global "вќЊ DHCP configuration differs from template. рџ“„ DHCP config:"
            awk '/^config /{p=($2=="dnsmasq")} p' /etc/config/dhcp
        else
            print_global "вњ… /etc/config/dhcp"
        fi
    else
        print_global "вќЊ Failed to get DNS info"
    fi

    print_global "в”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓ"
    print_global "рџ“¦ Sing-box status"

    local singbox_check_json
    singbox_check_json=$(check_sing_box)

    if [ -n "$singbox_check_json" ]; then
        local sing_box_installed sing_box_version_ok sing_box_service_exist sing_box_autostart_disabled sing_box_process_running sing_box_ports_listening

        sing_box_installed=$(echo "$singbox_check_json" | jq -r '.sing_box_installed // 0')
        sing_box_version_ok=$(echo "$singbox_check_json" | jq -r '.sing_box_version_ok // 0')
        sing_box_service_exist=$(echo "$singbox_check_json" | jq -r '.sing_box_service_exist // 0')
        sing_box_autostart_disabled=$(echo "$singbox_check_json" | jq -r '.sing_box_autostart_disabled // 0')
        sing_box_process_running=$(echo "$singbox_check_json" | jq -r '.sing_box_process_running // 0')
        sing_box_ports_listening=$(echo "$singbox_check_json" | jq -r '.sing_box_ports_listening // 0')

        if [ "$sing_box_installed" -eq 1 ]; then
            print_global "вњ… Sing-box installed"
        else
            print_global "вќЊ Sing-box installed"
        fi

        if [ "$sing_box_version_ok" -eq 1 ]; then
            print_global "вњ… Sing-box version is compatible (newer than 1.12.4)"
        else
            print_global "вќЊ Sing-box version is not compatible (older than 1.12.4)"
        fi

        if [ "$sing_box_service_exist" -eq 1 ]; then
            print_global "вњ… Sing-box service exist"
        else
            print_global "вќЊ Sing-box service exist"
        fi

        if [ "$sing_box_autostart_disabled" -eq 1 ]; then
            print_global "вњ… Sing-box autostart disabled"
        else
            print_global "вќЊ Sing-box autostart disabled"
        fi

        if [ "$sing_box_process_running" -eq 1 ]; then
            print_global "вњ… Sing-box process running"
        else
            print_global "вќЊ Sing-box process running"
        fi

        if [ "$sing_box_ports_listening" -eq 1 ]; then
            print_global "вњ… Sing-box listening ports"
        else
            print_global "вќЊ Sing-box listening ports"
        fi
    else
        print_global "вќЊ Failed to get sing-box info"
    fi

    print_global "в”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓ"
    print_global "рџ§± NFT rules status"

    local nft_check_json
    nft_check_json=$(check_nft_rules)

    if [ -n "$nft_check_json" ]; then
        local table_exist rules_mangle_exist rules_mangle_counters rules_mangle_output_exist rules_mangle_output_counters rules_proxy_exist rules_proxy_counters rules_other_mark_exist

        table_exist=$(echo "$nft_check_json" | jq -r '.table_exist // 0')
        rules_mangle_exist=$(echo "$nft_check_json" | jq -r '.rules_mangle_exist // 0')
        rules_mangle_counters=$(echo "$nft_check_json" | jq -r '.rules_mangle_counters // 0')
        rules_mangle_output_exist=$(echo "$nft_check_json" | jq -r '.rules_mangle_output_exist // 0')
        rules_mangle_output_counters=$(echo "$nft_check_json" | jq -r '.rules_mangle_output_counters // 0')
        rules_proxy_exist=$(echo "$nft_check_json" | jq -r '.rules_proxy_exist // 0')
        rules_proxy_counters=$(echo "$nft_check_json" | jq -r '.rules_proxy_counters // 0')
        rules_other_mark_exist=$(echo "$nft_check_json" | jq -r '.rules_other_mark_exist // 0')

        if [ "$table_exist" -eq 1 ]; then
            print_global "вњ… Table exist"
        else
            print_global "вќЊ Table exist"
        fi

        if [ "$rules_mangle_exist" -eq 1 ]; then
            print_global "вњ… Rules mangle exist"
        else
            print_global "вќЊ Rules mangle exist"
        fi

        if [ "$rules_mangle_counters" -eq 1 ]; then
            print_global "вњ… Rules mangle counters"
        else
            print_global "вљ пёЏ  Rules mangle counters"
        fi

        if [ "$rules_mangle_output_exist" -eq 1 ]; then
            print_global "вњ… Rules mangle output exist"
        else
            print_global "вќЊ Rules mangle output exist"
        fi

        if [ "$rules_mangle_output_counters" -eq 1 ]; then
            print_global "вњ… Rules mangle output counters"
        else
            print_global "вљ пёЏ  Rules mangle output counters"
        fi

        if [ "$rules_proxy_exist" -eq 1 ]; then
            print_global "вњ… Rules proxy exist"
        else
            print_global "вќЊ Rules proxy exist"
        fi

        if [ "$rules_proxy_counters" -eq 1 ]; then
            print_global "вњ… Rules proxy counters"
        else
            print_global "вљ пёЏ  Rules proxy counters"
        fi

        if [ "$rules_other_mark_exist" -eq 1 ]; then
            print_global "вљ пёЏ  Additional marking rules found:"
            nft list ruleset | awk '/table inet '"$NFT_TABLE_NAME"'/{flag=1; next} /^table/{flag=0} !flag' | grep -E "mark set|meta mark"
        else
            print_global "вњ… Additional marking rules found"
        fi
    else
        print_global "вќЊ Failed to get NFT rules info"
    fi

    print_global "в”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓ"
    print_global "рџ“„ HarpyNet config"
    show_config

    # print_global "в”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓ"
    # print_global "рџ”§ System check"

    # if grep -E "^nameserver\s+([0-9]{1,3}\.){3}[0-9]{1,3}" "$RESOLV_CONF" | grep -vqE "127\.0\.0\.1|0\.0\.0\.0"; then
    #     print_global "вќЊ /etc/resolv.conf contains external nameserver:"
    #     cat /etc/resolv.conf
    #     echo ""
    # else
    #     print_global "вњ… /etc/resolv.conf"
    # fi

    # print_global "в”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓ"
    # print_global "рџ§± NFT table"
    # check_nft

    print_global "в”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓ"
    print_global "рџ“„ WAN config"
    if uci show network.wan > /dev/null 2>&1; then
        awk '
            /^config / {
                p = ($2 == "interface" && $3 == "'\''wan'\''")
                proto = ""
            }
            p {
                if ($1 == "option" && $2 == "proto") {
                    proto = $3
                    print
                } else if (proto == "'\''static'\''" && $1 == "option" && ($2 == "ipaddr" || $2 == "netmask" || $2 == "gateway")) {
                    print "        option", $2, "'\''******'\''"
                } else if (proto == "'\''pppoe'\''" && $1 == "option" && ($2 == "username" || $2 == "password")) {
                    print "        option", $2, "'\''******'\''"
                } else {
                    print
                }
            }
        ' /etc/config/network
    else
        print_global "вќЊ WAN configuration not found"
    fi

    if uci show network | grep -q endpoint_host; then
        uci show network | grep endpoint_host | cut -d'=' -f2 | tr -d "'\" " | while read -r host; do
            if [ "$host" = "engage.cloudflareclient.com" ]; then
                print_global "вљ пёЏ WARP detected: $host"
                continue
            fi

            ip_prefix=$(echo "$host" | cut -d'.' -f1,2)
            if echo "$CLOUDFLARE_OCTETS" | grep -wq "$ip_prefix"; then
                print_global "в”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓ"
                print_global "вљ пёЏ WARP detected: $host"
            fi
        done
    fi

    if uci show network | grep -q route_allowed_ips; then
        uci show network | grep "wireguard_.*\.route_allowed_ips='1'" | cut -d'.' -f1-2 | while read -r peer_section; do
            local allowed_ips
            allowed_ips=$(uci get "${peer_section}.allowed_ips" 2> /dev/null)

            if [ "$allowed_ips" = "0.0.0.0/0" ]; then
                print_global "в”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓ"
                print_global "вљ пёЏ WG Route allowed IP enabled with 0.0.0.0/0"
            fi
        done
    fi

    if [ -f "/etc/init.d/zapret" ]; then
        print_global "в”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓ"
        print_global "вљ пёЏ Zapret detected"
    fi

    print_global "в”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓв”Ѓ"
    print_global "рџҐё FakeIP status"

    local fakeip_check_json
    fakeip_check_json=$(check_fakeip)

    if [ -n "$fakeip_check_json" ]; then
        local fakeip_status

        fakeip_status=$(echo "$fakeip_check_json" | jq -r '.fakeip // false')

        if [ "$fakeip_status" = "true" ]; then
            print_global "вњ… Router DNS is routed through sing-box"
        else
            print_global "вљ пёЏ Router DNS is NOT routed through sing-box"
        fi
    else
        print_global "вќЊ Failed to get FakeIP info"
    fi

    local fakeip_address
    fakeip_address=$(dig +short @127.0.0.42 $FAKEIP_TEST_DOMAIN)

    if echo "$fakeip_address" | grep -q "^198\.18\."; then
        print_global "вњ… Sing-box works with FakeIP: $fakeip_address"
    else
        print_global "вќЊ Sing-box does NOT work with FakeIP: $fakeip_address"
    fi
}

get_runtime_stats() {
    local cpu_line_1 cpu_line_2 total_1 idle_1 total_2 idle_2 cpu_usage
    local mem_total mem_available memory_usage temperature_raw temperature_c
    local uptime_seconds wan_status wan_ip wan_device rx_bytes tx_bytes selected_server
    local selected_proxy_uri selected_proxy_name
    local cache_file cache_max_age now cache_time cpu_stat_file

    cache_file="/tmp/harpynet-runtime-stats.json"
    cache_max_age=8
    now="$(date +%s 2>/dev/null || echo 0)"
    if [ -s "$cache_file" ] && [ "$now" -gt 0 ]; then
        cache_time="$(jq -r '.generated_at // 0' "$cache_file" 2>/dev/null)"
        if [ "$cache_time" -gt 0 ] 2>/dev/null && [ $((now - cache_time)) -lt "$cache_max_age" ]; then
            cat "$cache_file"
            return 0
        fi
    fi

    cpu_stat_file="/tmp/harpynet-cpu-stat"
    cpu_line_1="$(cat "$cpu_stat_file" 2>/dev/null)"
    cpu_line_2="$(head -n 1 /proc/stat)"

    printf '%s\n' "$cpu_line_2" > "$cpu_stat_file"

    if [ -n "$cpu_line_1" ]; then
        set -- $cpu_line_1
        shift
        total_1=0
        for value in "$@"; do
            total_1=$((total_1 + value))
        done
        idle_1=$(($4 + $5))
    else
        total_1=0
        idle_1=0
    fi

    set -- $cpu_line_2
    shift
    total_2=0
    for value in "$@"; do
        total_2=$((total_2 + value))
    done
    idle_2=$(($4 + $5))

    if [ "$total_1" -gt 0 ] && [ "$total_2" -gt "$total_1" ]; then
        cpu_usage=$((100 * ((total_2 - total_1) - (idle_2 - idle_1)) / (total_2 - total_1)))
    else
        cpu_usage=0
    fi

    mem_total="$(awk '/^MemTotal:/ { print $2; exit }' /proc/meminfo)"
    mem_available="$(awk '/^MemAvailable:/ { print $2; exit }' /proc/meminfo)"
    if [ -n "$mem_total" ] && [ "$mem_total" -gt 0 ]; then
        memory_usage=$((100 * (mem_total - mem_available) / mem_total))
    else
        memory_usage=0
    fi

    temperature_raw=""
    for sensor in /sys/class/thermal/thermal_zone*/temp /sys/class/hwmon/hwmon*/temp*_input; do
        if [ -r "$sensor" ]; then
            temperature_raw="$(cat "$sensor" 2> /dev/null)"
            [ -n "$temperature_raw" ] && break
        fi
    done

    if [ -n "$temperature_raw" ]; then
        if [ "$temperature_raw" -ge 1000 ] 2> /dev/null; then
            temperature_c="$(awk -v value="$temperature_raw" 'BEGIN { printf "%.1f", value / 1000 }')"
        else
            temperature_c="$temperature_raw"
        fi
    else
        temperature_c="null"
    fi

    uptime_seconds="$(cut -d. -f1 /proc/uptime)"
    wan_status="$(ubus call network.interface.wan status 2> /dev/null)"
    wan_ip="$(printf '%s' "$wan_status" | jq -r '.["ipv4-address"][0].address // "-"' 2> /dev/null)"
    wan_device="$(printf '%s' "$wan_status" | jq -r '.l3_device // .device // empty' 2> /dev/null)"

    if [ -n "$wan_device" ] && [ -r "/sys/class/net/$wan_device/statistics/rx_bytes" ]; then
        rx_bytes="$(cat "/sys/class/net/$wan_device/statistics/rx_bytes")"
        tx_bytes="$(cat "/sys/class/net/$wan_device/statistics/tx_bytes")"
    else
        rx_bytes=0
        tx_bytes=0
    fi

    if all_sections_vpn_disabled; then
        selected_server="-"
    else
        selected_server="$(clash_api get_proxies 2> /dev/null | jq -r '.proxies["main-out"].now // "-"' 2> /dev/null)"
    fi
    [ -n "$selected_server" ] || selected_server="-"
    if [ "$selected_server" != "-" ]; then
        selected_proxy_uri="$(get_subscription_cache "main" | jq -r --arg tag "$selected_server" '.[$tag] // empty' 2> /dev/null)"
        if [ -n "$selected_proxy_uri" ] && [ "${selected_proxy_uri#*#}" != "$selected_proxy_uri" ]; then
            selected_proxy_name="$(url_decode "${selected_proxy_uri#*#}")"
            [ -n "$selected_proxy_name" ] && selected_server="$selected_proxy_name"
        fi
    fi

    jq -cn \
        --argjson cpu "$cpu_usage" \
        --argjson memory "$memory_usage" \
        --argjson temperature "$temperature_c" \
        --argjson uptime "$uptime_seconds" \
        --argjson generated_at "$now" \
        --arg wan_ip "$wan_ip" \
        --arg wan_device "$wan_device" \
        --argjson rx_bytes "$rx_bytes" \
        --argjson tx_bytes "$tx_bytes" \
        --arg selected_server "$selected_server" \
        '{
            cpu: $cpu,
            memory: $memory,
            temperature: $temperature,
            uptime: $uptime,
            generated_at: $generated_at,
            wan_ip: $wan_ip,
            wan_device: $wan_device,
            rx_bytes: $rx_bytes,
            tx_bytes: $tx_bytes,
            selected_server: $selected_server
        }' | tee "$cache_file"
}

get_direct_connections() {
    if [ ! -r /proc/net/nf_conntrack ]; then
        echo '{"connections":[]}'
        return 0
    fi

    local dns_log_tail
    dns_log_tail="$(mktemp)"
    if [ -r "$DNS_LOG_FILE" ]; then
        tail -n 3000 "$DNS_LOG_FILE" > "$dns_log_tail"
    else
        : > "$dns_log_tail"
    fi

    awk '
        FNR == NR {
            if ($0 ~ / reply .* is [0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/) {
                domain = $(NF - 2)
                ip = $NF
                dns[ip] = domain
            }
            next
        }

        function field_value(value) {
            sub(/^[^=]+=/, "", value)
            return value
        }

        function is_known_proxy_destination(ip) {
            return ip ~ /^149\.154\./ ||
                ip ~ /^91\.108\./ ||
                ip ~ /^91\.105\./ ||
                ip ~ /^95\.161\./ ||
                ip ~ /^5\.28\./
        }

        {
            network = $3
            source = destination = source_port = destination_port = ""
            upload = download = 0
            direction = 0
            conntrack_state = network == "tcp" ? $6 : ""
            unreplied = index($0, "[UNREPLIED]") > 0 ? "true" : "false"

            for (i = 1; i <= NF; i++) {
                if ($i ~ /^src=/) {
                    direction++
                    if (direction == 1)
                        source = field_value($i)
                } else if ($i ~ /^dst=/ && direction == 1) {
                    destination = field_value($i)
                } else if ($i ~ /^sport=/ && direction == 1) {
                    source_port = field_value($i)
                } else if ($i ~ /^dport=/ && direction == 1) {
                    destination_port = field_value($i)
                } else if ($i ~ /^bytes=/ && direction == 1) {
                    upload = field_value($i)
                } else if ($i ~ /^bytes=/ && direction == 2) {
                    download = field_value($i)
                }
            }

            is_lan_source = source ~ /^10\./ ||
                source ~ /^192\.168\./ ||
                source ~ /^172\.(1[6-9]|2[0-9]|3[01])\./
            is_local_destination = destination ~ /^10\./ ||
                destination ~ /^127\./ ||
                destination ~ /^169\.254\./ ||
                destination ~ /^192\.168\./ ||
                destination ~ /^172\.(1[6-9]|2[0-9]|3[01])\./ ||
                destination ~ /^224\./ ||
                destination ~ /^239\./
            is_fake_ip = destination ~ /^198\.(1[89]|2[0-9]|3[01])\./

            if (!is_lan_source || is_local_destination || is_fake_ip ||
                source_port == "" || destination_port == "" ||
                is_known_proxy_destination(destination))
                next

            id = "direct-" network "-" source "-" source_port "-" destination "-" destination_port
            print id "\t" source "\t" source_port "\t" destination "\t" dns[destination] "\t" \
                destination_port "\t" network "\t" upload "\t" download "\t" \
                conntrack_state "\t" unreplied
        }
    ' "$dns_log_tail" /proc/net/nf_conntrack | jq -Rn '
        {
            connections: [
                inputs |
                split("\t") |
                {
                    id: .[0],
                    direct: true,
                    metadata: {
                        sourceIP: .[1],
                        sourcePort: .[2],
                        destinationIP: .[3],
                        host: .[4],
                        destinationPort: .[5],
                        network: .[6],
                        type: .[6],
                        conntrackState: .[9],
                        unreplied: (.[10] == "true")
                    },
                    chains: ["direct-out"],
                    rule: "direct-out",
                    upload: (.[7] | tonumber),
                    download: (.[8] | tonumber)
                }
            ]
        }
    '
    rm -f "$dns_log_tail"
}

get_dhcp_clients() {
    local wifi_map bridge_map lease_rows hosts_rows
    wifi_map="$(mktemp)"
    bridge_map="$(mktemp)"
    lease_rows="$(mktemp)"
    hosts_rows="$(mktemp)"

    if command -v iwinfo >/dev/null 2>&1; then
        wifi status 2>/dev/null | jq -r '
            to_entries[] as $radio |
            ($radio.value.config.band // "wifi") as $band |
            $radio.value.interfaces[]? |
            select(.ifname != null) |
            [.ifname, $band, (.config.ssid // "Wi-Fi")] | @tsv
        ' 2>/dev/null | while IFS="$(printf '\t')" read -r ifname band ssid; do
            [ -n "$ifname" ] || continue
            iwinfo "$ifname" assoclist 2>/dev/null | awk -v band="$band" -v ifname="$ifname" -v ssid="$ssid" '
                /^[0-9A-Fa-f][0-9A-Fa-f]:/ {
                    mac=tolower($1)
                    label = "Wi-Fi"
                    if (band == "2g") label = "Wi-Fi 2.4"
                    else if (band == "5g") label = "Wi-Fi 5G"
                    print mac "\t" label "\t" ifname "\t" ssid
                }
            '
        done > "$wifi_map"
    fi

    if command -v brctl >/dev/null 2>&1; then
        brctl showstp br-lan 2>/dev/null | awk '
            /^[^[:space:]].*\([0-9]+\)/ {
                ifname=$1
                port=$2
                gsub(/[()]/, "", port)
                if (ifname != "" && port != "") print port "\t" ifname
            }
        ' | awk -F '\t' '
            FILENAME == "-" {
                port_if[$1]=$2
                next
            }
        ' - >/dev/null 2>&1

        brctl showstp br-lan 2>/dev/null | awk '
            /^[^[:space:]].*\([0-9]+\)/ {
                ifname=$1
                port=$2
                gsub(/[()]/, "", port)
                if (ifname != "" && port != "") print port "\t" ifname
            }
        ' > "$bridge_map.ports"

        brctl showmacs br-lan 2>/dev/null | awk 'NR > 1 { print $1 "\t" tolower($2) }' | awk -F '\t' '
            FILENAME == ARGV[1] {
                port_if[$1]=$2
                next
            }
            FILENAME == ARGV[2] {
                port=$1
                mac=$2
                ifname=port_if[port]
                label=""
                if (ifname ~ /^phy0-/) label="Wi-Fi 2.4"
                else if (ifname ~ /^phy1-/) label="Wi-Fi 5G"
                else if (ifname ~ /^phy/) label="Wi-Fi"
                else if (ifname != "") label="LAN " port
                if (mac != "" && label != "") print mac "\t" label "\t" ifname "\t"
            }
        ' "$bridge_map.ports" - >> "$bridge_map"

        rm -f "$bridge_map.ports"
    fi

    awk '
        {
            mac=tolower($2)
            ip=$3
            name=$4
            if (ip != "" && mac != "") {
                if (name == "" || name == "*") name = "Неизвестное устройство"
                print ip "\t" name "\t" mac
            }
        }
    ' /tmp/dhcp.leases 2>/dev/null > "$lease_rows"

    awk '
        NF >= 2 && $1 !~ /^#/ {
            if ($1 ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/ && $2 != "" && $2 != "*")
                print $1 "\t" $2
        }
    ' /tmp/hosts/dhcp.* 2>/dev/null > "$hosts_rows"

    awk -F '\t' '
        FILENAME == ARGV[1] {
            wifi[$1] = $2
            wifi_if[$1] = $3
            wifi_ssid[$1] = $4
            next
        }
        FILENAME == ARGV[2] {
            bridge[$1] = $2
            bridge_if[$1] = $3
            next
        }
        FILENAME == ARGV[3] {
            ip=$1; name=$2; mac=$3
            host_by_ip[ip]=name
            mac_by_ip[ip]=mac
            next
        }
        FILENAME == ARGV[4] {
            if (!($1 in host_by_ip)) {
                host_by_ip[$1]=$2
                mac_by_ip[$1]=""
            } else if (host_by_ip[$1] == "Неизвестное устройство") {
                host_by_ip[$1]=$2
            }
            next
        }
        END {
            for (ip in host_by_ip) {
                name=host_by_ip[ip]
                mac=mac_by_ip[ip]
                connection="Не определено"
                ifname=""
                ssid=""
                if (mac != "" && mac in wifi) {
                    connection=wifi[mac]
                    ifname=wifi_if[mac]
                    ssid=wifi_ssid[mac]
                } else if (mac != "" && mac in bridge) {
                    connection=bridge[mac]
                    ifname=bridge_if[mac]
                } else if (tolower(name) ~ /(honor|redmi|iphone|galaxy|samsung|xiaomi|poco|realme|pixel|phone|android|tv|salute|smarttv|chromecast)/) {
                    connection="Wi-Fi / не активно"
                }
                if (ip ~ /\.1$/ && name == "OpenWrt") connection="Router"
                print ip "\t" name "\t" mac "\t" connection "\t" ifname "\t" ssid
            }
        }
    ' "$wifi_map" "$bridge_map" "$lease_rows" "$hosts_rows" | sort -V | jq -Rn '
        {
            clients: {},
            devices: [
                inputs |
                split("\t") |
                {
                    ip: .[0],
                    name: .[1],
                    mac: .[2],
                    connection: .[3],
                    interface: .[4],
                    ssid: .[5]
                }
            ]
        } |
        .clients = (
            reduce .devices[] as $device (
                {};
                .[$device.ip] = $device.name
            )
        )
    '

    rm -f "$wifi_map" "$bridge_map" "$bridge_map.ports" "$lease_rows" "$hosts_rows"
}

check_host_availability() {
    local host="$1"
    local code="000"
    local raw_code=""
    local header=""
    local url=""

    if ! printf '%s' "$host" | grep -Eq '^[A-Za-z0-9.-]+$'; then
        jq -n --arg host "$host" '{host:$host,available:false,code:"invalid",url:""}'
        return 0
    fi

    for scheme in https http; do
        url="${scheme}://${host}/"
        header="$(curl -4 -k -L -s -I \
            -A 'Mozilla/5.0' \
            --connect-timeout 3 --max-time 6 "$url" 2>/dev/null)"
        code="$(printf '%s' "$header" | sed -n 's/^HTTP\/[^ ]* \([0-9][0-9][0-9]\).*/\1/p' | tail -n 1)"
        if [ -z "$code" ] || [ "$code" = "405" ]; then
            raw_code="$(curl -4 -k -L -s -o /dev/null -w '%{http_code}' \
                -A 'Mozilla/5.0' \
                --connect-timeout 3 --max-time 6 "$url" 2>/dev/null || true)"
            code="$(printf '%s' "$raw_code" | grep -Eo '[0-9]{3}' | tail -n 1)"
        fi
        code="${code:-000}"

        if [ "$code" != "000" ]; then
            break
        fi
    done

    jq -n \
        --arg host "$host" \
        --arg code "$code" \
        --arg url "$url" \
        --argjson available "$([ "$code" -ge 200 ] 2>/dev/null && [ "$code" -lt 500 ] 2>/dev/null && echo true || echo false)" \
        '{host:$host,available:$available,code:$code,url:$url}'
}

get_first_proxy_section_name() {
    uci -q show harpynet | awk -F '[.=]' '
        $3 == "connection_type" && ($0 ~ /='\''proxy'\''$/ || $0 ~ /='\''full_proxy'\''$/ || $0 ~ /='\''full_proxy_bypass_ru'\''$/) {
            print $2
            exit
        }
    '
}

delete_device_route_from_all_sections() {
    local ip="$1"
    local section

    for section in $(uci -q show harpynet | awk -F '[.=]' '$3 == "connection_type" { print $2 }'); do
        uci -q del_list "harpynet.$section.fully_routed_ips=$ip" 2>/dev/null || true
        uci -q del_list "harpynet.$section.bypass_ru_routed_ips=$ip" 2>/dev/null || true
    done
}

delete_device_outbound_from_section() {
    local section="$1"
    local ip="$2"
    local entries entry

    entries="$(uci -q get "harpynet.$section.device_outbounds" 2>/dev/null || true)"
    uci -q delete "harpynet.$section.device_outbounds" 2>/dev/null || true

    for entry in $entries; do
        [ "${entry%%=*}" = "$ip" ] && continue
        uci add_list "harpynet.$section.device_outbounds=$entry"
    done
}

set_device_outbound() {
    local ip="$1"
    local outbound_tag="$2"
    local commit_mode="${3:-commit}"
    local proxy_section valid_tags

    if ! printf '%s' "$ip" | grep -Eq '^[0-9]{1,3}(\.[0-9]{1,3}){3}$'; then
        jq -n --arg ip "$ip" '{success:false,error:"invalid_ip",ip:$ip}'
        return 1
    fi

    proxy_section="$(get_first_proxy_section_name)"
    if [ -z "$proxy_section" ]; then
        jq -n --arg ip "$ip" '{success:false,error:"proxy_section_not_found",ip:$ip}'
        return 1
    fi

    delete_device_outbound_from_section "$proxy_section" "$ip"

    case "$outbound_tag" in
    "" | default)
        outbound_tag="default"
        ;;
    *)
        if printf '%s' "$outbound_tag" | grep -q '[	\r\n]'; then
            jq -n --arg outbound "$outbound_tag" '{success:false,error:"invalid_outbound",outbound:$outbound}'
            return 1
        fi

        valid_tags="$(awk -F '\t' 'NF >= 2 { print $1 }' \
            "/var/run/harpynet/subscription-$proxy_section.links" \
            "/etc/harpynet/subscription-cache/subscription-$proxy_section.links" 2>/dev/null | sort -u)"
        if ! printf '%s\n' "$valid_tags" | grep -Fxq "$outbound_tag"; then
            jq -n --arg outbound "$outbound_tag" '{success:false,error:"unknown_outbound",outbound:$outbound}'
            return 1
        fi

        uci add_list "harpynet.$proxy_section.device_outbounds=$ip=$outbound_tag"
        ;;
    esac

    [ "$commit_mode" = "no_commit" ] || uci commit harpynet
    jq -n --arg ip "$ip" --arg outbound "$outbound_tag" '{success:true,ip:$ip,outbound:$outbound}'
}

commit_harpynet_config() {
    uci commit harpynet
    jq -n '{success:true}'
}

restart_background() {
    (
        /usr/bin/harpynet restart > /tmp/harpynet-device-apply.log 2>&1
    ) &

    jq -n '{success:true,background:true}'
}

get_device_outbound_options() {
    local section cache_file

    section="$(get_first_proxy_section_name)"
    [ -n "$section" ] || {
        jq -n '{success:true,outbounds:[]}'
        return 0
    }

    for cache_file in "/var/run/harpynet/subscription-$section.links" "/etc/harpynet/subscription-cache/subscription-$section.links"; do
        if [ -s "$cache_file" ]; then
            jq -R -s '
                split("\n")
                | map(select(length > 0) | split("\t") | select(length >= 2) | {tag:.[0],link:.[1]})
                | unique_by(.tag)
                | {success:true,outbounds:.}
            ' "$cache_file"
            return 0
        fi
    done

    jq -n '{success:true,outbounds:[]}'
}

routeropenwrt_http_post() {
    local url="$1"
    local payload="$2"

    if command -v curl >/dev/null 2>&1; then
        curl -sS --connect-timeout 10 --max-time 30 \
            -H "Content-Type: application/json" \
            -d "$payload" "$url"
        return $?
    fi

    if command -v wget >/dev/null 2>&1; then
        wget -qO- \
            --header="Content-Type: application/json" \
            --post-data="$payload" "$url"
        return $?
    fi

    if command -v uclient-fetch >/dev/null 2>&1; then
        uclient-fetch -q -O - \
            --header="Content-Type: application/json" \
            --post-data="$payload" "$url"
        return $?
    fi

    jq -n '{success:false,error:"http_client_not_found"}'
    return 1
}

routeropenwrt_http_get_auth() {
    local url="$1"
    local token="$2"

    if command -v curl >/dev/null 2>&1; then
        curl -sS --connect-timeout 10 --max-time 30 \
            -H "Authorization: Bearer $token" "$url"
        return $?
    fi

    if command -v wget >/dev/null 2>&1; then
        wget -qO- --header="Authorization: Bearer $token" "$url"
        return $?
    fi

    if command -v uclient-fetch >/dev/null 2>&1; then
        uclient-fetch -q -O - --header="Authorization: Bearer $token" "$url"
        return $?
    fi

    jq -n '{success:false,error:"http_client_not_found"}'
    return 1
}

routeropenwrt_http_post_auth() {
    local url="$1"
    local token="$2"

    if command -v curl >/dev/null 2>&1; then
        curl -sS --connect-timeout 10 --max-time 30 \
            -X POST -H "Authorization: Bearer $token" "$url"
        return $?
    fi

    if command -v wget >/dev/null 2>&1; then
        wget -qO- --method=POST --header="Authorization: Bearer $token" "$url"
        return $?
    fi

    if command -v uclient-fetch >/dev/null 2>&1; then
        uclient-fetch -q -O - --method=POST \
            --header="Authorization: Bearer $token" "$url"
        return $?
    fi

    jq -n '{success:false,error:"http_client_not_found"}'
    return 1
}

routeropenwrt_device_id() {
    local mac hostname board

    hostname="$(uci -q get system.@system[0].hostname || hostname 2>/dev/null)"
    mac="$(cat /sys/class/net/br-lan/address 2>/dev/null || cat /sys/class/net/eth0/address 2>/dev/null)"
    board="$(ubus call system board 2>/dev/null | jq -r '.board_name // .model // "openwrt"' 2>/dev/null)"

    printf '%s' "${hostname:-openwrt}-${mac:-unknown}-${board:-openwrt}" | sha256sum | awk '{print $1}'
}

routeropenwrt_device_payload() {
    local pair_token="$1"
    local device_id="$2"
    local hostname model openwrt_version harpynet_version lan_ip wan_ip

    hostname="$(uci -q get system.@system[0].hostname || hostname 2>/dev/null)"
    model="$(ubus call system board 2>/dev/null | jq -r '.model // .board_name // "OpenWrt"' 2>/dev/null)"
    openwrt_version="$(ubus call system board 2>/dev/null | jq -r '.release.description // .release.version // "OpenWrt"' 2>/dev/null)"
    harpynet_version="$(opkg status harpynet 2>/dev/null | awk -F': ' '/^Version:/ {print $2; exit}')"
    [ -n "$harpynet_version" ] || harpynet_version="$(apk info -v harpynet 2>/dev/null | head -n1 | sed 's/^harpynet-//')"
    lan_ip="$(uci -q get network.lan.ipaddr)"
    network_flush_cache 2>/dev/null || true
    network_find_wan wan_iface 2>/dev/null && network_get_ipaddr wan_ip "$wan_iface" 2>/dev/null

    jq -n \
        --arg pair_token "$pair_token" \
        --arg device_id "$device_id" \
        --arg hostname "${hostname:-OpenWrt}" \
        --arg model "${model:-OpenWrt}" \
        --arg openwrt_version "${openwrt_version:-OpenWrt}" \
        --arg harpynet_version "${harpynet_version:-unknown}" \
        --arg lan_ip "${lan_ip:-}" \
        --arg wan_ip "${wan_ip:-}" \
        '{
            pair_token:$pair_token,
            device_id:$device_id,
            hostname:$hostname,
            model:$model,
            openwrt_version:$openwrt_version,
            harpynet_version:$harpynet_version,
            lan_ip:$lan_ip,
            wan_ip:$wan_ip
        }'
}

routeropenwrt_start_payload() {
    local device_id="$1"
    local hostname model openwrt_version harpynet_version lan_ip wan_ip

    hostname="$(uci -q get system.@system[0].hostname || hostname 2>/dev/null)"
    model="$(ubus call system board 2>/dev/null | jq -r '.model // .board_name // "OpenWrt"' 2>/dev/null)"
    openwrt_version="$(ubus call system board 2>/dev/null | jq -r '.release.description // .release.version // "OpenWrt"' 2>/dev/null)"
    harpynet_version="$(opkg status harpynet 2>/dev/null | awk -F': ' '/^Version:/ {print $2; exit}')"
    [ -n "$harpynet_version" ] || harpynet_version="$(apk info -v harpynet 2>/dev/null | head -n1 | sed 's/^harpynet-//')"
    lan_ip="$(uci -q get network.lan.ipaddr)"
    network_flush_cache 2>/dev/null || true
    network_find_wan wan_iface 2>/dev/null && network_get_ipaddr wan_ip "$wan_iface" 2>/dev/null

    jq -n \
        --arg device_id "$device_id" \
        --arg hostname "${hostname:-OpenWrt}" \
        --arg model "${model:-OpenWrt}" \
        --arg openwrt_version "${openwrt_version:-OpenWrt}" \
        --arg harpynet_version "${harpynet_version:-unknown}" \
        --arg lan_ip "${lan_ip:-}" \
        --arg wan_ip "${wan_ip:-}" \
        '{
            device_id:$device_id,
            hostname:$hostname,
            model:$model,
            openwrt_version:$openwrt_version,
            harpynet_version:$harpynet_version,
            lan_ip:$lan_ip,
            wan_ip:$wan_ip
        }'
}

routeropenwrt_start() {
    local section="$1"
    local api_base="$2"
    local device_id payload response pair_code

    [ -n "$section" ] || section="$(get_first_proxy_section_name)"
    [ -n "$api_base" ] || config_get api_base "$section" "telegram_api_base" "http://apiwrt.harpynet.com:3004/api"

    if [ -z "$section" ]; then
        jq -n '{success:false,error:"section_missing"}'
        return 1
    fi

    device_id="$(routeropenwrt_device_id)"
    payload="$(routeropenwrt_start_payload "$device_id")" || return 1
    response="$(routeropenwrt_http_post "${api_base%/}/routeropenwrt/start" "$payload")" || {
        jq -n --arg error "start_request_failed" '{success:false,error:$error}'
        return 1
    }

    pair_code="$(printf '%s' "$response" | jq -r '.pair_code // empty' 2>/dev/null)"
    if [ -n "$pair_code" ]; then
        uci set "harpynet.$section.proxy_config_type=telegram"
        uci set "harpynet.$section.telegram_pair_code=$pair_code"
        uci set "harpynet.$section.telegram_api_base=$api_base"
        uci set "harpynet.$section.telegram_device_id=$device_id"
        uci commit harpynet
        printf '%s' "$response" | jq '. + {success:true,device_id:$device_id}' --arg device_id "$device_id"
        return 0
    fi

    printf '%s' "$response" | jq '. + {success:false}' 2>/dev/null || jq -n --arg raw "$response" '{success:false,error:"invalid_response",raw:$raw}'
    return 1
}

routeropenwrt_poll() {
    local section="$1"
    local pair_code api_base device_id payload response status subscription_url router_token

    [ -n "$section" ] || section="$(get_first_proxy_section_name)"
    config_get pair_code "$section" "telegram_pair_code"
    config_get api_base "$section" "telegram_api_base" "http://apiwrt.harpynet.com:3004/api"
    config_get device_id "$section" "telegram_device_id"
    [ -n "$device_id" ] || device_id="$(routeropenwrt_device_id)"

    if [ -z "$section" ] || [ -z "$pair_code" ]; then
        jq -n '{success:false,error:"section_or_pair_code_missing"}'
        return 1
    fi

    payload="$(jq -n \
        --arg pair_code "$pair_code" \
        --arg device_id "$device_id" \
        '{pair_code:$pair_code,device_id:$device_id}')" || return 1

    response="$(routeropenwrt_http_post "${api_base%/}/routeropenwrt/poll" "$payload")" || {
        jq -n --arg error "poll_request_failed" '{success:false,error:$error}'
        return 1
    }

    status="$(printf '%s' "$response" | jq -r '.status // empty' 2>/dev/null)"
    subscription_url="$(printf '%s' "$response" | jq -r '.subscription_url // empty' 2>/dev/null)"
    router_token="$(printf '%s' "$response" | jq -r '.router_token // empty' 2>/dev/null)"

    if [ "$status" = "waiting" ]; then
        printf '%s' "$response" | jq '. + {success:true}'
        return 0
    fi

    if [ -n "$subscription_url" ] && [ -n "$router_token" ]; then
        uci set "harpynet.$section.connection_type=proxy"
        uci set "harpynet.$section.proxy_config_type=telegram"
        uci set "harpynet.$section.subscription_url=$subscription_url"
        uci set "harpynet.$section.telegram_router_token=$router_token"
        uci -q delete "harpynet.$section.telegram_pair_code"
        uci -q delete "harpynet.$section.telegram_pair_token"
        uci -q delete "harpynet.$section.telegram_confirm_code"
        uci commit harpynet
        (/usr/bin/harpynet restart >/dev/null 2>&1) &
        printf '%s' "$response" | jq '. + {success:true,activated:true}'
        return 0
    fi

    printf '%s' "$response" | jq '. + {success:false}' 2>/dev/null || jq -n --arg raw "$response" '{success:false,error:"invalid_response",raw:$raw}'
    return 1
}

routeropenwrt_unbind() {
    local section="$1"
    local api_base router_token response

    [ -n "$section" ] || section="$(get_first_proxy_section_name)"
    config_get api_base "$section" "telegram_api_base" "http://apiwrt.harpynet.com:3004/api"
    config_get router_token "$section" "telegram_router_token"

    if [ -z "$section" ] || [ -z "$router_token" ]; then
        jq -n '{success:false,error:"router_not_bound"}'
        return 1
    fi

    response="$(routeropenwrt_http_post_auth "${api_base%/}/routeropenwrt/unbind" "$router_token")" || {
        jq -n --arg error "unbind_request_failed" '{success:false,error:$error}'
        return 1
    }

    if [ "$(printf '%s' "$response" | jq -r '.ok // false' 2>/dev/null)" != "true" ]; then
        printf '%s' "$response" | jq '. + {success:false}' 2>/dev/null || \
            jq -n --arg raw "$response" '{success:false,error:"invalid_response",raw:$raw}'
        return 1
    fi

    uci set "harpynet.$section.connection_type=exclusion"
    uci set "harpynet.$section.proxy_config_type=telegram"
    uci -q delete "harpynet.$section.subscription_url"
    uci -q delete "harpynet.$section.telegram_router_token"
    uci -q delete "harpynet.$section.telegram_pair_code"
    uci -q delete "harpynet.$section.telegram_pair_token"
    uci -q delete "harpynet.$section.telegram_confirm_code"
    uci -q delete "harpynet.$section.telegram_device_id"
    uci commit harpynet
    (/usr/bin/harpynet restart >/dev/null 2>&1) &

    printf '%s' "$response" | jq '. + {success:true,unbound:true}'
}

routeropenwrt_claim() {
    local section="$1"
    local pair_token="$2"
    local api_base="$3"
    local device_id payload response status

    [ -n "$section" ] || section="$(get_first_proxy_section_name)"
    [ -n "$pair_token" ] || config_get pair_token "$section" "telegram_pair_token"
    [ -n "$api_base" ] || config_get api_base "$section" "telegram_api_base" "http://apiwrt.harpynet.com:3004/api"

    if [ -z "$section" ] || [ -z "$pair_token" ]; then
        jq -n '{success:false,error:"section_or_pair_token_missing"}'
        return 1
    fi

    device_id="$(routeropenwrt_device_id)"
    payload="$(routeropenwrt_device_payload "$pair_token" "$device_id")" || return 1
    response="$(routeropenwrt_http_post "${api_base%/}/routeropenwrt/claim" "$payload")" || {
        jq -n --arg error "claim_request_failed" '{success:false,error:$error}'
        return 1
    }

    status="$(printf '%s' "$response" | jq -r '.status // empty' 2>/dev/null)"
    if [ "$status" = "code_required" ]; then
        uci set "harpynet.$section.proxy_config_type=telegram"
        uci set "harpynet.$section.telegram_pair_token=$pair_token"
        uci set "harpynet.$section.telegram_api_base=$api_base"
        uci set "harpynet.$section.telegram_device_id=$device_id"
        uci commit harpynet
        printf '%s' "$response" | jq '. + {success:true,device_id:$device_id}' --arg device_id "$device_id"
        return 0
    fi

    printf '%s' "$response" | jq '. + {success:false}' 2>/dev/null || jq -n --arg raw "$response" '{success:false,error:"invalid_response",raw:$raw}'
    return 1
}

routeropenwrt_confirm() {
    local section="$1"
    local confirm_code="$2"
    local pair_token api_base device_id payload response subscription_url router_token

    [ -n "$section" ] || section="$(get_first_proxy_section_name)"
    [ -n "$confirm_code" ] || config_get confirm_code "$section" "telegram_confirm_code"
    config_get pair_token "$section" "telegram_pair_token"
    config_get api_base "$section" "telegram_api_base" "http://apiwrt.harpynet.com:3004/api"
    config_get device_id "$section" "telegram_device_id"
    [ -n "$device_id" ] || device_id="$(routeropenwrt_device_id)"

    if [ -z "$section" ] || [ -z "$pair_token" ] || [ -z "$confirm_code" ]; then
        jq -n '{success:false,error:"section_pair_token_or_code_missing"}'
        return 1
    fi

    payload="$(jq -n \
        --arg pair_token "$pair_token" \
        --arg device_id "$device_id" \
        --arg confirm_code "$confirm_code" \
        '{pair_token:$pair_token,device_id:$device_id,confirm_code:$confirm_code}')" || return 1

    response="$(routeropenwrt_http_post "${api_base%/}/routeropenwrt/confirm" "$payload")" || {
        jq -n --arg error "confirm_request_failed" '{success:false,error:$error}'
        return 1
    }

    subscription_url="$(printf '%s' "$response" | jq -r '.subscription_url // empty' 2>/dev/null)"
    router_token="$(printf '%s' "$response" | jq -r '.router_token // empty' 2>/dev/null)"
    if [ -n "$subscription_url" ] && [ -n "$router_token" ]; then
        uci set "harpynet.$section.proxy_config_type=telegram"
        uci set "harpynet.$section.subscription_url=$subscription_url"
        uci set "harpynet.$section.telegram_router_token=$router_token"
        uci -q delete "harpynet.$section.telegram_confirm_code"
        uci commit harpynet
        printf '%s' "$response" | jq '. + {success:true}'
        return 0
    fi

    printf '%s' "$response" | jq '. + {success:false}' 2>/dev/null || jq -n --arg raw "$response" '{success:false,error:"invalid_response",raw:$raw}'
    return 1
}

routeropenwrt_subscription() {
    local section="$1"
    local api_base router_token response subscription_url

    [ -n "$section" ] || section="$(get_first_proxy_section_name)"
    config_get api_base "$section" "telegram_api_base" "http://apiwrt.harpynet.com:3004/api"
    config_get router_token "$section" "telegram_router_token"

    if [ -z "$section" ] || [ -z "$router_token" ]; then
        jq -n '{success:false,error:"section_or_router_token_missing"}'
        return 1
    fi

    response="$(routeropenwrt_http_get_auth "${api_base%/}/routeropenwrt/subscription" "$router_token")" || {
        jq -n --arg error "subscription_request_failed" '{success:false,error:$error}'
        return 1
    }

    subscription_url="$(printf '%s' "$response" | jq -r '.subscription_url // empty' 2>/dev/null)"
    if [ -n "$subscription_url" ]; then
        uci set "harpynet.$section.subscription_url=$subscription_url"
        uci commit harpynet
        printf '%s' "$response" | jq '. + {success:true}'
        return 0
    fi

    printf '%s' "$response" | jq '. + {success:false}' 2>/dev/null || jq -n --arg raw "$response" '{success:false,error:"invalid_response",raw:$raw}'
    return 1
}

set_device_route() {
    local ip="$1"
    local mode="$2"
    local commit_mode="${3:-commit}"
    local proxy_section

    if ! printf '%s' "$ip" | grep -Eq '^[0-9]{1,3}(\.[0-9]{1,3}){3}$'; then
        jq -n --arg ip "$ip" '{success:false,error:"invalid_ip",ip:$ip}'
        return 1
    fi

    delete_device_route_from_all_sections "$ip"
    uci -q del_list "harpynet.settings.routing_excluded_ips=$ip" 2>/dev/null || true

    case "$mode" in
    proxy | full_proxy)
        proxy_section="$(get_first_proxy_section_name)"
        if [ -z "$proxy_section" ]; then
            jq -n --arg ip "$ip" '{success:false,error:"proxy_section_not_found",ip:$ip}'
            return 1
        fi
        uci add_list "harpynet.$proxy_section.fully_routed_ips=$ip"
        ;;
    full_proxy_bypass_ru)
        proxy_section="$(get_first_proxy_section_name)"
        if [ -z "$proxy_section" ]; then
            jq -n --arg ip "$ip" '{success:false,error:"proxy_section_not_found",ip:$ip}'
            return 1
        fi
        uci add_list "harpynet.$proxy_section.bypass_ru_routed_ips=$ip"
        ;;
    exclude)
        uci add_list "harpynet.settings.routing_excluded_ips=$ip"
        ;;
    default)
        ;;
    *)
        jq -n --arg mode "$mode" '{success:false,error:"invalid_mode",mode:$mode}'
        return 1
        ;;
    esac

    [ "$commit_mode" = "no_commit" ] || uci commit harpynet

    jq -n --arg ip "$ip" --arg mode "$mode" '{success:true,ip:$ip,mode:$mode}'
}

copy_upstream_proxy_profile_to_legacy() {
    local section="$1" profile="$2" value
    for value in name protocol server port username password tls_server_name; do
        local profile_value legacy_option
        profile_value="$(uci -q get "harpynet.$profile.$value")"
        case "$value" in
        name) legacy_option="upstream_proxy_name" ;;
        tls_server_name) legacy_option="upstream_proxy_tls_server_name" ;;
        *) legacy_option="upstream_proxy_$value" ;;
        esac
        uci set "harpynet.$section.$legacy_option=$profile_value"
    done
}

find_first_upstream_proxy_profile() {
    local parent="$1" profile profile_parent
    for profile in $(uci show harpynet 2>/dev/null | sed -n "s/^harpynet\.\([^.=]*\)=upstream_proxy_profile$/\1/p"); do
        profile_parent="$(uci -q get "harpynet.$profile.parent")"
        [ "$profile_parent" = "$parent" ] && { printf '%s\n' "$profile"; return 0; }
    done
    return 1
}

new_upstream_proxy_profile_name() {
    local base candidate suffix
    base="proxy_$(date +%s)_$$"
    candidate="$base"
    suffix=1
    while uci -q get "harpynet.$candidate" >/dev/null 2>&1; do
        candidate="${base}_$suffix"
        suffix=$((suffix + 1))
    done
    printf '%s\n' "$candidate"
}

count_upstream_proxy_profiles() {
    local parent="$1" profile profile_parent count=0
    for profile in $(uci show harpynet 2>/dev/null | sed -n "s/^harpynet\.\([^.=]*\)=upstream_proxy_profile$/\1/p"); do
        profile_parent="$(uci -q get "harpynet.$profile.parent")"
        [ "$profile_parent" = "$parent" ] && count=$((count + 1))
    done
    printf '%s\n' "$count"
}

ensure_upstream_proxy_profile() {
    local section="$1" active profile_type profile_parent profile source name value label
    active="$(uci -q get "harpynet.$section.upstream_proxy_active_profile")"
    if [ -n "$active" ]; then
        profile_type="$(uci -q get "harpynet.$active")"
        profile_parent="$(uci -q get "harpynet.$active.parent")"
        if [ "$profile_type" = "upstream_proxy_profile" ] && [ "$profile_parent" = "$section" ] && [ "${active#@}" = "$active" ]; then
            label="$(uci -q get "harpynet.$active.label")"
            if [ -z "$label" ]; then
                uci set "harpynet.$active.label=Профиль 1"
                uci commit harpynet
            fi
            printf '%s\n' "$active"
            return 0
        fi
    fi

    source="$(find_first_upstream_proxy_profile "$section")"
    profile="$(new_upstream_proxy_profile_name)"
    uci set "harpynet.$profile=upstream_proxy_profile" || return 1
    if [ -n "$source" ]; then
        uci set "harpynet.$profile.parent=$section"
        uci set "harpynet.$profile.label=$(uci -q get "harpynet.$source.label" || echo 'Профиль 1')"
        for value in name protocol server port username password tls_server_name; do
            uci set "harpynet.$profile.$value=$(uci -q get "harpynet.$source.$value")"
        done
        case "$source" in @*) uci -q delete "harpynet.$source" ;; esac
    else
        name="$(uci -q get "harpynet.$section.upstream_proxy_name")"
        uci set "harpynet.$profile.parent=$section"
        uci set "harpynet.$profile.label=Профиль 1"
        uci set "harpynet.$profile.name=${name:-Профиль 1}"
        uci set "harpynet.$profile.protocol=$(uci -q get "harpynet.$section.upstream_proxy_protocol" || echo socks5)"
        uci set "harpynet.$profile.server=$(uci -q get "harpynet.$section.upstream_proxy_server")"
        uci set "harpynet.$profile.port=$(uci -q get "harpynet.$section.upstream_proxy_port")"
        uci set "harpynet.$profile.username=$(uci -q get "harpynet.$section.upstream_proxy_username")"
        uci set "harpynet.$profile.password=$(uci -q get "harpynet.$section.upstream_proxy_password")"
        uci set "harpynet.$profile.tls_server_name=$(uci -q get "harpynet.$section.upstream_proxy_tls_server_name")"
    fi
    uci set "harpynet.$section.upstream_proxy_active_profile=$profile"
    uci commit harpynet
    printf '%s\n' "$profile"
}

create_upstream_proxy_profile() {
    local section="$1" encoded_name="$2" profile name profile_count
    case "$section" in ''|*[!A-Za-z0-9_-]*) jq -n '{success:false,error:"invalid_section"}'; return 1 ;; esac
    ensure_upstream_proxy_profile "$section" >/dev/null || return 1
    profile_count="$(count_upstream_proxy_profiles "$section")"
    name="$(decode_command_value "$encoded_name")"
    [ -n "$name" ] || name="Профиль $((profile_count + 1))"
    profile="$(new_upstream_proxy_profile_name)"
    uci set "harpynet.$profile=upstream_proxy_profile" || return 1
    uci set "harpynet.$profile.parent=$section"
    uci set "harpynet.$profile.label=$name"
    uci set "harpynet.$profile.name="
    uci set "harpynet.$profile.protocol=socks5"
    uci set "harpynet.$profile.server="
    uci set "harpynet.$profile.port="
    uci set "harpynet.$profile.username="
    uci set "harpynet.$profile.password="
    uci set "harpynet.$profile.tls_server_name="
    uci set "harpynet.$section.upstream_proxy_active_profile=$profile"
    copy_upstream_proxy_profile_to_legacy "$section" "$profile"
    uci commit harpynet
    jq -n --arg profile "$profile" --arg name "$name" '{success:true,profile:$profile,name:$name}'
}

activate_upstream_proxy_profile() {
    local section="$1" profile="$2" profile_type profile_parent name
    profile_type="$(uci -q get "harpynet.$profile")"
    profile_parent="$(uci -q get "harpynet.$profile.parent")"
    [ "$profile_type" = "upstream_proxy_profile" ] && [ "$profile_parent" = "$section" ] || {
        jq -n '{success:false,error:"profile_not_found"}'
        return 1
    }
    uci set "harpynet.$section.upstream_proxy_active_profile=$profile"
    copy_upstream_proxy_profile_to_legacy "$section" "$profile"
    uci commit harpynet
    name="$(uci -q get "harpynet.$profile.label")"
    jq -n --arg profile "$profile" --arg name "$name" '{success:true,profile:$profile,name:$name}'
}

rename_upstream_proxy_profile() {
    local section="$1" profile="$2" encoded_label="$3" profile_type profile_parent label
    profile_type="$(uci -q get "harpynet.$profile")"
    profile_parent="$(uci -q get "harpynet.$profile.parent")"
    [ "$profile_type" = "upstream_proxy_profile" ] && [ "$profile_parent" = "$section" ] || {
        jq -n '{success:false,error:"profile_not_found"}'
        return 1
    }
    label="$(decode_command_value "$encoded_label")"
    [ -n "$label" ] || { jq -n '{success:false,error:"profile_name_required"}'; return 1; }
    [ "${#label}" -le 64 ] || { jq -n '{success:false,error:"profile_name_too_long"}'; return 1; }
    uci set "harpynet.$profile.label=$label"
    uci commit harpynet
    jq -n --arg profile "$profile" --arg name "$label" '{success:true,profile:$profile,name:$name}'
}

delete_upstream_proxy_profile() {
    local section="$1" profile="$2" profile_type profile_parent count replacement name
    profile_type="$(uci -q get "harpynet.$profile")"
    profile_parent="$(uci -q get "harpynet.$profile.parent")"
    [ "$profile_type" = "upstream_proxy_profile" ] && [ "$profile_parent" = "$section" ] || {
        jq -n '{success:false,error:"profile_not_found"}'
        return 1
    }
    count="$(count_upstream_proxy_profiles "$section")"
    [ "$count" -gt 1 ] || { jq -n '{success:false,error:"last_profile_cannot_be_deleted"}'; return 1; }
    uci delete "harpynet.$profile"
    replacement="$(find_first_upstream_proxy_profile "$section")"
    uci set "harpynet.$section.upstream_proxy_active_profile=$replacement"
    copy_upstream_proxy_profile_to_legacy "$section" "$replacement"
    uci commit harpynet
    name="$(uci -q get "harpynet.$replacement.label")"
    jq -n --arg profile "$replacement" --arg name "$name" '{success:true,active_profile:$profile,name:$name}'
}

reset_upstream_proxy() {
    local section="$1" profile profile_parent
    case "$section" in ''|*[!A-Za-z0-9_-]*) jq -n '{success:false,error:"invalid_section"}'; return 1 ;; esac

    for profile in $(uci show harpynet 2>/dev/null | sed -n "s/^\(harpynet\.[^.]*\)=upstream_proxy_profile$/\1/p" | cut -d. -f2); do
        profile_parent="$(uci -q get "harpynet.$profile.parent")"
        [ "$profile_parent" = "$section" ] && uci -q delete "harpynet.$profile"
    done

    uci set "harpynet.$section.upstream_proxy_enabled=0"
    uci -q delete "harpynet.$section.upstream_proxy_active_profile"
    uci -q delete "harpynet.$section.upstream_proxy_name"
    uci -q delete "harpynet.$section.upstream_proxy_protocol"
    uci -q delete "harpynet.$section.upstream_proxy_server"
    uci -q delete "harpynet.$section.upstream_proxy_port"
    uci -q delete "harpynet.$section.upstream_proxy_username"
    uci -q delete "harpynet.$section.upstream_proxy_password"
    uci -q delete "harpynet.$section.upstream_proxy_tls_server_name"
    uci -q delete "harpynet.$section.upstream_proxy_domains"
    uci -q delete "harpynet.$section.upstream_proxy_community_lists"
    uci commit harpynet
    jq -n --arg section "$section" '{success:true,section:$section,enabled:false}'
}

test_upstream_proxy_values() {
    local protocol="$1" server="$2" port="$3" username="$4" password="$5"
    local scheme curl_result http_code connect_code time_total curl_status elapsed error

    if [ -z "$server" ] || [ -z "$port" ]; then
        jq -n '{success:false,error:"upstream_proxy_address_missing"}'
        return 1
    fi

    case "$protocol" in
    socks5) scheme="socks5h" ;;
    http) scheme="http" ;;
    https) scheme="https" ;;
    *) jq -n --arg protocol "$protocol" '{success:false,error:"unsupported_protocol",protocol:$protocol}'; return 1 ;;
    esac

    if [ -n "$username" ]; then
        curl_result="$(curl -sS -o /dev/null -w '%{http_code} %{http_connect} %{time_total}' --connect-timeout 5 --max-time 12 \
            --proxy "$scheme://$server:$port" --proxy-user "$username:$password" \
            https://www.cloudflare.com/cdn-cgi/trace 2>/dev/null)"
        curl_status=$?
    else
        curl_result="$(curl -sS -o /dev/null -w '%{http_code} %{http_connect} %{time_total}' --connect-timeout 5 --max-time 12 \
            --proxy "$scheme://$server:$port" https://www.cloudflare.com/cdn-cgi/trace 2>/dev/null)"
        curl_status=$?
    fi
    http_code="${curl_result%% *}"
    curl_result="${curl_result#* }"
    connect_code="${curl_result%% *}"
    time_total="${curl_result#* }"
    elapsed="$(awk -v seconds="${time_total:-0}" 'BEGIN { printf "%d", (seconds * 1000) + 0.5 }')"

    if [ "$curl_status" -eq 0 ] && [ "$http_code" -ge 200 ] 2>/dev/null && [ "$http_code" -lt 400 ] 2>/dev/null; then
        jq -n --arg protocol "$protocol" --arg code "$http_code" --argjson latency "$elapsed" \
            '{success:true,protocol:$protocol,http_code:$code,latency_ms:$latency}'
        return 0
    fi

    if [ "$connect_code" = "407" ] || [ "$http_code" = "407" ]; then
        error="proxy_authentication_failed"
    elif [ -n "$connect_code" ] && [ "$connect_code" != "000" ]; then
        error="proxy_server_error"
    elif [ -n "$http_code" ] && [ "$http_code" != "000" ]; then
        error="proxy_server_error"
    else
        error="proxy_connection_failed"
    fi

    jq -n --arg protocol "$protocol" --arg error "$error" \
        --arg code "${http_code:-000}" --arg connect_code "${connect_code:-000}" \
        --argjson latency "$elapsed" --argjson exit_code "$curl_status" \
        '{success:false,error:$error,protocol:$protocol,http_code:$code,proxy_http_code:$connect_code,latency_ms:$latency,exit_code:$exit_code}'
    return 1
}

check_upstream_proxy() {
    local section="$1"
    local enabled protocol server port username password profile_section

    [ -n "$section" ] || section="$(get_first_proxy_section_name)"
    config_get_bool enabled "$section" "upstream_proxy_enabled" 0
    profile_section="$(get_active_upstream_proxy_profile "$section")"
    config_get protocol "$profile_section" "protocol" ""
    config_get server "$profile_section" "server" ""
    config_get port "$profile_section" "port" ""
    config_get username "$profile_section" "username" ""
    config_get password "$profile_section" "password" ""
    if [ "$profile_section" = "$section" ]; then
        config_get protocol "$section" "upstream_proxy_protocol" "socks5"
        config_get server "$section" "upstream_proxy_server"
        config_get port "$section" "upstream_proxy_port"
        config_get username "$section" "upstream_proxy_username"
        config_get password "$section" "upstream_proxy_password"
    fi

    if [ "$enabled" -ne 1 ]; then
        jq -n '{success:false,error:"upstream_proxy_disabled"}'
        return 1
    fi

    test_upstream_proxy_values "$protocol" "$server" "$port" "$username" "$password"
}

decode_command_value() {
    printf '%s' "$1" | base64 -d 2>/dev/null
}

save_check_upstream_proxy() {
    local section="$1" connection_type="$2" protocol="$3" server="$4" port="$5"
    local name username password tls_name domains lists item subscription_url interface router_token
    local persistent_cache_file runtime_cache_file result status profile

    case "$section" in ''|*[!A-Za-z0-9_-]*) jq -n '{success:false,error:"invalid_section"}'; return 1 ;; esac
    case "$connection_type" in proxy|full_proxy|full_proxy_bypass_ru) ;; *) jq -n '{success:false,error:"invalid_connection_type"}'; return 1 ;; esac
    case "$protocol" in socks5|http|https) ;; *) jq -n '{success:false,error:"unsupported_protocol"}'; return 1 ;; esac
    case "$server" in ''|*:*|*/*) jq -n '{success:false,error:"invalid_proxy_server"}'; return 1 ;; esac
    case "$port" in ''|*[!0-9]*) jq -n '{success:false,error:"invalid_proxy_port"}'; return 1 ;; esac
    [ "$port" -ge 1 ] 2>/dev/null && [ "$port" -le 65535 ] 2>/dev/null || {
        jq -n '{success:false,error:"invalid_proxy_port"}'
        return 1
    }

    name="$(decode_command_value "$6")" || return 1
    username="$(decode_command_value "$7")" || return 1
    password="$(decode_command_value "$8")" || return 1
    tls_name="$(decode_command_value "$9")" || return 1
    domains="$(decode_command_value "${10}")" || return 1
    lists="$(decode_command_value "${11}")" || return 1

    result="$(test_upstream_proxy_values "$protocol" "$server" "$port" "$username" "$password")"
    status=$?
    [ "$status" -eq 0 ] || {
        printf '%s\n' "$result"
        return "$status"
    }

    profile="$(ensure_upstream_proxy_profile "$section")" || {
        jq -n '{success:false,error:"profile_migration_failed"}'
        return 1
    }

    uci set "harpynet.$section.connection_type=$connection_type"
    uci set "harpynet.$section.upstream_proxy_enabled=1"
    uci set "harpynet.$profile.name=${name:-Профиль 1}"
    uci set "harpynet.$profile.protocol=$protocol"
    uci set "harpynet.$profile.server=$server"
    uci set "harpynet.$profile.port=$port"
    uci set "harpynet.$profile.username=$username"
    uci set "harpynet.$profile.password=$password"
    uci set "harpynet.$profile.tls_server_name=$tls_name"
    copy_upstream_proxy_profile_to_legacy "$section" "$profile"
    uci set "harpynet.$section.upstream_proxy_domains=$domains"
    uci -q delete "harpynet.$section.upstream_proxy_community_lists"
    for item in $(printf '%s' "$lists" | tr ',' ' '); do
        [ -n "$item" ] && uci add_list "harpynet.$section.upstream_proxy_community_lists=$item"
    done
    uci commit harpynet

    config_get subscription_url "$section" "subscription_url"
    config_get interface "$section" "interface"
    config_get router_token "$section" "telegram_router_token"
    persistent_cache_file="/etc/harpynet/subscription-cache/subscription-$section.links"
    runtime_cache_file="/var/run/harpynet/subscription-$section.links"

    if [ -n "$subscription_url" ] || [ -n "$interface" ] || [ -n "$router_token" ] || \
        [ -s "$persistent_cache_file" ] || [ -s "$runtime_cache_file" ]; then
        printf '%s' "$result" | jq '. + {can_apply:true}'
    else
        printf '%s' "$result" | jq '. + {can_apply:false,warning:"outbound_source_missing"}'
    fi
}

support_router_id() {
    local id_file="/etc/harpynet/support-router-id" id

    if [ -s "$id_file" ]; then
        cat "$id_file"
        return 0
    fi

    mkdir -p /etc/harpynet
    id="$(
        {
            cat /etc/machine-id 2>/dev/null
            cat /tmp/sysinfo/model 2>/dev/null
            ip link show br-lan 2>/dev/null
            hostname 2>/dev/null
        } | sha256sum 2>/dev/null | awk '{print $1}'
    )"
    [ -n "$id" ] || id="$(date +%s)-$$"
    printf '%s\n' "$id" > "$id_file"
    chmod 0600 "$id_file" 2>/dev/null || true
    cat "$id_file"
}

support_mask_value() {
    local value="$1"

    if [ -z "$value" ]; then
        printf ''
        return 0
    fi

    case "$value" in
    http://* | https://*)
        printf '%s' "$value" | sed -E 's#(https?://[^/]+/).+#\1***#'
        ;;
    *)
        printf '***'
        ;;
    esac
}

support_sanitize_output() {
    sed "s/$(printf '\033')\\[[0-9;]*[A-Za-z]//g" | sed -E \
        -e 's#(subscription_url=|subscription URL: |option subscription_url '\''|https?://link\.harpynet\.com/)[^[:space:]'\'']+#\1***#g' \
        -e 's#(password=|pass=|token=|Authorization: Bearer |option support_token '\''|option yacd_secret_key '\'')[A-Za-z0-9._~:/+=-]+#\1***#g' \
        -e 's#(option upstream_proxy_password '\'')[^'\'']+#\1***#g'
}

support_drop_known_noise() {
    grep -Eiv '^=== Errors|No default route present|router: missing fakeip record|fakeip\.harpynet\.(fyi|com).*NXDOMAIN|Watchdog enabled|cacheinfo: Unable to detect cache hierarchy|rtl822x_set_serdes_option_mode failed|option log_level|daemon\.notice netifd: wan .*udhcpc: (sending renew|lease of)|authpriv\.(info|warn).*dispatcher\.uc: luci: (accepted|failed) login|dropbear.*Error reading: Connection reset by peer'
}

support_recent_error_count() {
    logread 2>/dev/null |
        tail -500 |
        support_sanitize_output |
        grep -Ei 'harpynet.*(error|fatal)|sing-box.*(error|fatal|panic)|failed|timeout|denied|refused|context deadline' |
        support_drop_known_noise |
        sed -E \
            -e 's/\[[0-9]+\]//g' \
            -e 's/[0-9]+(\.[0-9]+)?(ms|s)/<time>/g' \
            -e 's/[0-9]{5,}/<id>/g' \
            -e 's/[[:space:]]+/ /g' |
        sort -u |
        wc -l |
        tr -d ' '
}

support_collect_logs() {
    logread 2>/dev/null |
        grep -Ei 'harpynet|sing-box|dnsmasq|netifd|firewall|nft|luci|rpcd|dropbear|error|fatal|warn|failed|timeout|denied|proxy|subscription' |
        tail -220 |
        support_sanitize_output
}

support_collect_full_snapshot() {
    {
        echo "=== HarpyNet Support Snapshot ==="
        date
        echo

        echo "=== System / Система ==="
        hostname 2>/dev/null
        cat /tmp/sysinfo/model 2>/dev/null
        grep '^OPENWRT_RELEASE=' /etc/os-release 2>/dev/null | cut -d'"' -f2
        uptime 2>/dev/null
        free -h 2>/dev/null
        df -h 2>/dev/null | sed -n '1,12p'
        echo

        echo "=== HarpyNet / VPN ==="
        /usr/bin/harpynet show_version 2>/dev/null
        /usr/bin/harpynet get_status 2>/dev/null
        /usr/bin/harpynet get_sing_box_status 2>/dev/null
        pgrep -af 'harpynet|sing-box' 2>/dev/null | grep -v 'support_push' | grep -v 'support_collect_full_snapshot' | head -20
        echo

        echo "=== HarpyNet config masked / Конфиг без секретов ==="
        /usr/bin/harpynet show_config 2>/dev/null | sed -n '1,180p'
        echo

        echo "=== WAN status / WAN ==="
        ubus call network.interface.wan status 2>/dev/null
        echo

        echo "=== LAN status / LAN ==="
        ubus call network.interface.lan status 2>/dev/null
        echo

        echo "=== IP address / Адреса ==="
        ip -br addr 2>/dev/null
        echo

        echo "=== Routes / Маршруты ==="
        ip route show 2>/dev/null
        ip -6 route show 2>/dev/null | head -80
        echo

        echo "=== DHCP leases / Клиенты DHCP ==="
        cat /tmp/dhcp.leases 2>/dev/null | tail -80
        echo

        echo "=== DNS / DHCP services ==="
        pgrep -af 'dnsmasq|odhcpd' 2>/dev/null
        /usr/bin/harpynet check_dns_available 2>/dev/null || true
        nslookup github.com 127.0.0.42 2>/dev/null | head -20 || true
        echo

        echo "=== Firewall / NFT short ==="
        nft list ruleset 2>/dev/null | grep -Ei 'harpynet|sing-box|tproxy|mark|redirect|masquerade' | head -160
        echo

        echo "=== Kernel dmesg / Ядро ==="
        dmesg 2>/dev/null | tail -120
        echo

        echo "=== Errors / Ошибки ==="
        logread 2>/dev/null | grep -Ei 'error|fatal|warn|failed|timeout|denied|panic|segfault' | support_drop_known_noise | tail -160
        echo

        echo "=== HarpyNet related logread / HarpyNet и сеть ==="
        support_collect_logs
    } | support_sanitize_output
}

support_payload() {
    local section="$1"
    local router_id hostname model openwrt_version harpynet_version uptime_text
    local lan_ip wan_ip connection_type proxy_config_type subscription_url subscription_masked
    local status_json sing_box_status_json recent_errors log_text metadata_json subscription_title subscription_owner subscription_announce

    [ -n "$section" ] || section="$(get_first_proxy_section_name)"
    [ -n "$section" ] || section="main"

    router_id="$(support_router_id)"
    hostname="$(uci -q get system.@system[0].hostname 2>/dev/null || hostname 2>/dev/null)"
    model="$(cat /tmp/sysinfo/model 2>/dev/null)"
    [ -n "$model" ] || model="OpenWrt"
    openwrt_version="$(grep '^OPENWRT_RELEASE=' /etc/os-release 2>/dev/null | cut -d'"' -f2)"
    harpynet_version="$HARPYNET_VERSION"
    uptime_text="$(uptime 2>/dev/null)"
    lan_ip="$(uci -q get network.lan.ipaddr 2>/dev/null)"
    wan_ip="$(ubus call network.interface.wan status 2>/dev/null | jq -r '.["ipv4-address"][0].address // empty' 2>/dev/null)"
    connection_type="$(uci -q get "harpynet.$section.connection_type")"
    proxy_config_type="$(uci -q get "harpynet.$section.proxy_config_type")"
    subscription_url="$(uci -q get "harpynet.$section.subscription_url")"
    subscription_masked="$(support_mask_value "$subscription_url")"
    status_json="$(get_status 2>/dev/null || echo '{}')"
    sing_box_status_json="$(get_sing_box_status 2>/dev/null || echo '{}')"
    metadata_json="$(get_subscription_metadata "$section" 2>/dev/null || echo '{}')"
    subscription_title="$(printf '%s' "$metadata_json" | jq -r '.title // empty' 2>/dev/null)"
    subscription_announce="$(printf '%s' "$metadata_json" | jq -r '.announce // empty' 2>/dev/null)"
    subscription_owner="$(printf '%s\n' "$subscription_announce" | sed -n 's/^.*[[:space:]]\([^[:space:]]\+\)$/\1/p' | head -1)"
    [ -n "$subscription_owner" ] || subscription_owner="$(printf '%s\n' "$subscription_announce" | head -1 | tr -cd 'A-Za-z0-9_.@-')"
    recent_errors="$(support_recent_error_count)"
    log_text="$(support_collect_full_snapshot)"

    jq -n \
        --arg router_id "$router_id" \
        --arg section "$section" \
        --arg hostname "$hostname" \
        --arg model "$model" \
        --arg openwrt_version "$openwrt_version" \
        --arg harpynet_version "$harpynet_version" \
        --arg uptime "$uptime_text" \
        --arg lan_ip "$lan_ip" \
        --arg wan_ip "$wan_ip" \
        --arg connection_type "$connection_type" \
        --arg proxy_config_type "$proxy_config_type" \
        --arg subscription_url "$subscription_masked" \
        --arg subscription_title "$subscription_title" \
        --arg subscription_owner "$subscription_owner" \
        --arg subscription_announce "$subscription_announce" \
        --arg log_text "$log_text" \
        --argjson recent_errors "${recent_errors:-0}" \
        --argjson harpynet_status "$status_json" \
        --argjson sing_box_status "$sing_box_status_json" \
        '{
            router_id:$router_id,
            section:$section,
            hostname:$hostname,
            model:$model,
            openwrt_version:$openwrt_version,
            harpynet_version:$harpynet_version,
            uptime:$uptime,
            lan_ip:$lan_ip,
            wan_ip:$wan_ip,
            connection_type:$connection_type,
            proxy_config_type:$proxy_config_type,
            subscription_url:$subscription_url,
            subscription_title:$subscription_title,
            subscription_owner:$subscription_owner,
            subscription_announce:$subscription_announce,
            recent_errors:$recent_errors,
            harpynet_status:$harpynet_status,
            sing_box_status:$sing_box_status,
            log_text:$log_text
        }'
}

support_cron_enable() {
    local cron_job="*/30 * * * * /usr/bin/harpynet support_push >/dev/null 2>&1"

    (crontab -l 2>/dev/null | grep -v "/usr/bin/harpynet support_push"; echo "$cron_job") | crontab -
    /etc/init.d/cron restart >/dev/null 2>&1 || true
}

support_cron_disable() {
    (crontab -l 2>/dev/null | grep -v "/usr/bin/harpynet support_push") | crontab -
    /etc/init.d/cron restart >/dev/null 2>&1 || true
}

support_configure() {
    local api_url="$1"
    local token="$2"

    case "$api_url" in
    http://* | https://*) ;;
    *)
        jq -n '{success:false,error:"invalid_api_url"}'
        return 1
        ;;
    esac

    if [ -z "$token" ]; then
        jq -n '{success:false,error:"token_missing"}'
        return 1
    fi

    uci set "harpynet.settings.support_enabled=1"
    uci set "harpynet.settings.support_api_url=$api_url"
    uci set "harpynet.settings.support_token=$token"
    uci commit harpynet
    support_cron_enable

    jq -n --arg router_id "$(support_router_id)" '{success:true,router_id:$router_id,cron:"30m"}'
}

support_disable() {
    uci -q delete "harpynet.settings.support_enabled"
    uci -q delete "harpynet.settings.support_api_url"
    uci -q delete "harpynet.settings.support_token"
    uci commit harpynet
    support_cron_disable
    jq -n '{success:true}'
}

support_push() {
    local section="${1:-main}"
    local enabled api_url token payload heartbeat_url logs_url

    enabled="$(uci -q get harpynet.settings.support_enabled)"
    api_url="$(uci -q get harpynet.settings.support_api_url)"
    token="$(uci -q get harpynet.settings.support_token)"

    if [ "$enabled" != "1" ]; then
        jq -n '{success:false,error:"support_disabled"}'
        return 1
    fi
    if [ -z "$api_url" ] || [ -z "$token" ]; then
        jq -n '{success:false,error:"support_not_configured"}'
        return 1
    fi

    payload="$(support_payload "$section")"
    heartbeat_url="${api_url%/}/api/heartbeat"
    logs_url="${api_url%/}/api/logs"

    curl -fsS -m 20 \
        -H "Authorization: Bearer $token" \
        -H "Content-Type: application/json" \
        -d "$payload" \
        "$heartbeat_url" >/tmp/harpynet-support-reply.json || {
            jq -n '{success:false,error:"heartbeat_failed"}'
            return 1
        }

    curl -fsS -m 30 \
        -H "Authorization: Bearer $token" \
        -H "Content-Type: application/json" \
        -d "$payload" \
        "$logs_url" >/tmp/harpynet-support-reply.json || true

    cat /tmp/harpynet-support-reply.json 2>/dev/null || jq -n '{success:true}'
}

support_status() {
    local enabled api_url router_id

    enabled="$(uci -q get harpynet.settings.support_enabled)"
    api_url="$(uci -q get harpynet.settings.support_api_url)"
    router_id="$(support_router_id)"

    jq -n \
        --arg enabled "$enabled" \
        --arg api_url "$api_url" \
        --arg router_id "$router_id" \
        '{success:true,enabled:($enabled=="1"),api_url:$api_url,router_id:$router_id}'
}

support_after_update() {
    local enabled api_url token section

    enabled="$(uci -q get harpynet.settings.support_enabled)"
    api_url="$(uci -q get harpynet.settings.support_api_url)"
    token="$(uci -q get harpynet.settings.support_token)"
    section="${1:-main}"

    if [ "$enabled" != "1" ] || [ -z "$api_url" ] || [ -z "$token" ]; then
        jq -n '{success:true,enabled:false,skipped:"support_not_configured"}'
        return 0
    fi

    support_cron_enable
    (
        sleep 20
        /usr/bin/harpynet support_push "$section" >/dev/null 2>&1 || true
    ) >/dev/null 2>&1 &

    jq -n --arg router_id "$(support_router_id)" '{success:true,enabled:true,router_id:$router_id,cron:"30m",first_push:"scheduled"}'
}

show_help() {
    cat << EOF
Usage: $0 COMMAND

Available commands:
    start                   Start harpynet service
    stop                    Stop harpynet service
    reload                  Reload harpynet configuration
    restart                 Restart harpynet service
    main                    Run main harpynet process
    list_update             Update domain lists
    list_update_report      Update domain lists and show a change report
    list_update_report_start Start list update report in background
    list_update_report_status Get list update report status
    subscription_update     Update subscription and reload HarpyNet
    check_proxy             Check proxy connectivity
    check_nft               Check NFT rules
    check_nft_rules         Check NFT rules status
    check_sing_box          Check sing-box installation and status
    check_logs              Show harpynet logs from system journal
    check_sing_box_logs     Show sing-box logs
    get_subscription_cache   Get cached subscription links for dashboard
    get_subscription_metadata Get subscription traffic and expiry metadata
    save_subscription_url    Save manual subscription URL
    check_fakeip            Test FakeIP on router
    clash_api               Clash API interface for managing proxies and groups
    show_config             Display current harpynet configuration
    show_version            Show harpynet version
    show_sing_box_config    Show sing-box configuration
    show_sing_box_version   Show sing-box version
    show_system_info        Show system information
    get_status              Get harpynet service status
    get_sing_box_status     Get sing-box service status
    get_system_info         Get system information in JSON format
    get_update_status       Check GitHub release update status
    self_update_start       Start safe HarpyNet update in background
    self_update_status      Get safe update job status
    get_runtime_stats       Get CPU, memory and temperature statistics
    get_direct_connections  Get active connections routed without VPN
    get_dhcp_clients        Get DHCP client names by IP
    set_device_route        Set device route mode by IP
    set_device_outbound     Set device outbound by IP
    commit_harpynet_config  Commit HarpyNet UCI config once
    restart_background      Restart HarpyNet in background
    reset_upstream_proxy    Disable upstream proxy and remove its profiles
    support_configure       Configure hidden support collector
    support_push            Send hidden support heartbeat and logs
    support_status          Show hidden support collector status
    support_disable         Disable hidden support collector
    get_device_outbound_options Get cached subscription outbounds for devices
    routeropenwrt_start    Create router-side Telegram pairing code
    routeropenwrt_poll     Check router-side Telegram pairing code and save subscription
    routeropenwrt_unbind   Revoke Telegram binding and disable VPN
    routeropenwrt_claim    Claim legacy Telegram pairing token for current router
    routeropenwrt_confirm  Confirm legacy Telegram pairing code and save subscription
    routeropenwrt_subscription Refresh subscription URL from linked router token
    check_upstream_proxy   Test the saved upstream SOCKS5/HTTP/HTTPS proxy
    save_check_upstream_proxy Save and test an upstream proxy profile
    create_upstream_proxy_profile Create a blank upstream proxy profile
    activate_upstream_proxy_profile Activate an upstream proxy profile
    rename_upstream_proxy_profile Rename an upstream proxy profile
    delete_upstream_proxy_profile Delete an upstream proxy profile
    check_dns_available     Check DNS server availability
    global_check            Run global system check
EOF
}

